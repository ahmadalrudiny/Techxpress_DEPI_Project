@{
    ViewData["Title"] = "تم إرسال الطلب - TechXpress";
    Layout = null;
    var resetLink = ViewData["ResetLink"] as string;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="تم استلام طلب استعادة كلمة المرور — تابع الخطوات لإكمال العملية." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-shell">
    <aside class="auth-aside">
        <div class="aside-brand"><i class="fas fa-microchip"></i>TechXpress</div>
        <h1>تحقّق من <span>بريدك الإلكتروني</span></h1>
        <p>
            أرسلنا لك تعليمات إعادة تعيين كلمة المرور. إن لم تجد الرسالة،
            تحقّق من مجلد البريد غير المرغوب فيه.
        </p>
        <ul class="auth-features">
            <li><i class="fas fa-lock"></i> رابط إعادة تعيين مُشفّر ومحدود الصلاحية</li>
            <li><i class="fas fa-clock"></i> الرابط صالح لفترة محدودة فقط</li>
            <li><i class="fas fa-headset"></i> دعم فني جاهز لمساعدتك</li>
        </ul>
    </aside>

    <main class="auth-panel">
        <div class="auth-card">
            <div class="auth-brand-compact">
                <span class="logo-badge"><i class="fas fa-envelope-circle-check"></i></span>
            </div>

            <div class="text-center mb-4">
                <h2 class="h3 fw-bold mb-2">تم استلام طلبك</h2>
                <p class="auth-lead mb-0">
                    إذا كان البريد الإلكتروني مسجّلاً لدينا، فسيصلك رابط إعادة تعيين كلمة المرور خلال دقائق.
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(resetLink))
            {
                <div class="auth-hint mb-4">
                    <i class="fas fa-triangle-exclamation me-1" style="color:#c98f00;"></i>
                    <strong>وضع التطوير:</strong> لا يوجد مزود بريد مُفعّل، لذلك يظهر الرابط هنا مباشرةً للتجربة فقط.
                </div>

                <a href="@resetLink" class="btn auth-btn w-100 mb-3">
                    <i class="fas fa-unlock-keyhole me-2"></i>فتح صفحة إعادة تعيين كلمة المرور
                </a>
            }

            <div class="auth-divider"><span>أو</span></div>

            <div class="text-center">
                <a asp-action="Login" class="btn btn-outline-gold w-100">
                    <i class="fas fa-arrow-right me-2"></i>العودة لتسجيل الدخول
                </a>
            </div>
        </div>

        <p class="auth-footer-note">&copy; @DateTime.Now.Year TechXpress — جميع الحقوق محفوظة.</p>
    </main>
</body>
</html>
