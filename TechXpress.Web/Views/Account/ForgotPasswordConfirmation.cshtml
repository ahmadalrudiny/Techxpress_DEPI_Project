@{
    ViewData["Title"] = "تم إرسال الطلب - TechXpress";
    Layout = null;
    var resetLink = ViewData["ResetLink"] as string;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <meta name="description" content="تم استلام طلب استعادة كلمة المرور — تابع الخطوات لإكمال العملية." />
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

    <style>
        :root {
         
            --beige: #FAF7F2;         
            --beige-hover: #ede6db;    
            --cream: #FAF7F2;          
            --navy: #0C223F;          
            --navy-dark: #071528;  
            --navy-light: #153359;
            --border: #E3D9C9;         
            --white: #FFFFFF;          
            
            --text-dark: #0C223F;
            --text-muted: #64748b;
        }

        * {
            box-sizing: border-box;
            font-family: 'Cairo', "Segoe UI", sans-serif;
        }

        body.auth-shell {
            background-color: var(--cream) !important;
            color: var(--text-dark);
            min-height: 100vh;
            margin: 0;
        }

      
        .auth-aside {
            background: linear-gradient(165deg, var(--navy-dark) 0%, var(--navy) 65%, #102d52 100%) !important;
            color: var(--white) !important;
            display: flex !important;
            flex-direction: column;
            justify-content: flex-start !important;
            align-items: flex-start;
            text-align: right;
            padding: 50px 7% 40px !important;
            min-height: 100vh;
            overflow: hidden;
            position: sticky;
            top: 0;
            height: 100vh;
        }

 
        .auth-aside::before {
            content: "";
            position: absolute;
            width: 480px;
            height: 480px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(250, 247, 242, 0.12) 0%, rgba(12, 34, 63, 0) 70%);
            top: -80px;
            left: -80px;
            pointer-events: none;
            animation: floatGlow 11s ease-in-out infinite alternate;
        }

        .auth-aside::after {
            content: "";
            position: absolute;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(56, 189, 248, 0.08) 0%, rgba(12, 34, 63, 0) 70%);
            bottom: -50px;
            right: -50px;
            pointer-events: none;
            animation: floatGlow2 13s ease-in-out infinite alternate;
        }

        @@keyframes floatGlow {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(25px, 20px) scale(1.08); }
            100% { transform: translate(-15px, 35px) scale(0.96); }
        }

        @@keyframes floatGlow2 {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(-20px, -15px) scale(1.1); }
            100% { transform: translate(15px, -20px) scale(1); }
        }

        .auth-aside > * {
            position: relative;
            z-index: 2;
        }

        .aside-brand {
            color: var(--white) !important;
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 35px;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            direction: ltr;
        }

        .aside-brand i {
            width: 44px;
            height: 44px;
            background: var(--beige);
            color: var(--navy);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
        }

        .auth-aside h1 {
            color: var(--white) !important;
            font-size: clamp(26px, 2.7vw, 38px);
            font-weight: 800;
            line-height: 1.45 !important;
            margin-bottom: 15px;
            max-width: 500px;
        }

        .auth-aside h1 span {
            color: var(--beige) !important;
        }

        .auth-aside p {
            color: #dbe4ef !important;
            font-size: 15px;
            line-height: 1.85 !important;
            max-width: 480px;
            margin-bottom: 26px;
            text-align: right;
        }

        .auth-features {
            list-style: none;
            padding: 0;
            margin: 0;
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 13px;
        }

        .auth-features li {
            display: flex;
            align-items: center;
            gap: 14px;
            color: #f8fafc;
            font-size: 14px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.09);
            padding: 10px 16px;
            border-radius: 12px;
            backdrop-filter: blur(6px);
            transition: transform 0.2s ease, border-color 0.2s ease;
        }

        .auth-features li:hover {
            transform: translateX(-4px);
            border-color: var(--beige);
        }

        .auth-features li i {
            color: var(--beige);
            font-size: 15px;
            width: 28px;
            height: 28px;
            background: rgba(250, 247, 242, 0.15);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

     
        .auth-panel {
            background-color: var(--cream) !important;
            padding: 40px 20px !important;
            min-height: 100vh;
        }

        .auth-card {
            background: var(--white) !important;
            border: 1px solid var(--border) !important;
            border-radius: 20px !important;
            box-shadow: 0 10px 30px -5px rgba(12, 34, 63, 0.06) !important;
            padding: 38px 32px !important;
            max-width: 460px;
            width: 100%;
        }

        .auth-card h2 {
            color: var(--navy) !important;
            font-weight: 800;
        }

        .auth-lead {
            color: var(--text-muted) !important;
            font-size: 14px;
            line-height: 1.7;
        }

        .logo-badge {
            background: var(--navy) !important;
            color: var(--beige) !important;
            width: 50px;
            height: 50px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .auth-hint {
            background: #faf7f2 !important;
            border: 1.5px dashed var(--border) !important;
            border-radius: 12px;
            padding: 14px 16px;
            font-size: 13.5px;
            color: var(--navy);
            line-height: 1.6;
        }

       
        .auth-btn {
            background: var(--beige) !important;
            border: 1.5px solid var(--border) !important;
            color: var(--navy) !important;
            border-radius: 10px !important;
            height: 48px;
            font-weight: 800;
            font-size: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(12, 34, 63, 0.08);
            cursor: pointer;
        }

        .auth-btn:hover {
            background: var(--beige-hover) !important;
            border-color: var(--navy) !important;
            color: var(--navy) !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(12, 34, 63, 0.14);
        }

        .btn-outline-gold {
            background: transparent !important;
            color: var(--navy) !important;
            border: 1.5px solid var(--border) !important;
            border-radius: 10px !important;
            height: 44px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-outline-gold:hover {
            background: var(--beige) !important;
            border-color: var(--navy) !important;
            color: var(--navy) !important;
        }

        .auth-divider span {
            color: var(--text-muted);
            background: var(--white) !important;
        }

        @@media (max-width: 991.98px) {
            .auth-shell {
                flex-direction: column !important;
            }

            .auth-aside {
                position: static !important;
                height: auto !important;
                min-height: auto !important;
                padding: 35px 25px !important;
            }

            .aside-brand {
                margin-bottom: 20px;
            }

            .auth-aside h1 {
                font-size: 26px;
            }
        }
    </style>
</head>

<body class="auth-shell">

    <aside class="auth-aside">
        <div class="aside-brand">
            <i class="fas fa-microchip"></i> TechXpress
        </div>

        <h1>تحقّق من <span>بريدك الإلكتروني</span></h1>

        <p>
            أرسلنا لك تعليمات إعادة تعيين كلمة المرور. إن لم تجد الرسالة،
            تحقّق من مجلد البريد غير المرغوب فيه (Spam).
        </p>

        <ul class="auth-features">
            <li>
                <i class="fas fa-lock"></i>
                <span>رابط إعادة تعيين مُشفّر ومحدود الصلاحية</span>
            </li>
            <li>
                <i class="fas fa-clock"></i>
                <span>الرابط صالح لفترة محدودة فقط</span>
            </li>
            <li>
                <i class="fas fa-headset"></i>
                <span>دعم فني جاهز لمساعدتك</span>
            </li>
        </ul>
    </aside>

    <main class="auth-panel">
        <div class="auth-card">
            <div class="auth-brand-compact">
                <span class="logo-badge"><i class="fas fa-envelope-circle-check"></i></span>
            </div>

            <div class="text-center mb-4">
                <h2 class="h3 fw-bold mb-2">تم استلام طلبك</h2>
                <p class="auth-lead mb-0">
                    إذا كان البريد الإلكتروني مسجّلاً لدينا، فسيصلك رابط إعادة تعيين كلمة المرور خلال دقائق قليلة.
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(resetLink))
            {
                <div class="auth-hint mb-4">
                    <i class="fas fa-circle-info ms-1" style="color: var(--navy);"></i>
                    <strong>وضع التطوير:</strong> لا يوجد مزود بريد مُفعّل، لذلك يظهر الرابط هنا مباشرةً للتجربة:
                </div>

                <a href="@resetLink" class="btn auth-btn w-100 mb-3">
                    <i class="fas fa-unlock-keyhole ms-1"></i> فتح صفحة إعادة تعيين كلمة المرور
                </a>
            }

            <div class="auth-divider"><span>أو</span></div>

            <div class="text-center">
                <a asp-action="Login" class="btn btn-outline-gold w-100">
                    <i class="fas fa-arrow-right ms-1"></i> العودة لتسجيل الدخول
                </a>
            </div>
        </div>

        <p class="auth-footer-note mt-3">&copy; @DateTime.Now.Year TechXpress — جميع الحقوق محفوظة.</p>
    </main>

</body>
</html>