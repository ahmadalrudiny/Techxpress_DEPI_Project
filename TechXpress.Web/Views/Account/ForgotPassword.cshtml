@model TechXpress.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "نسيت كلمة المرور - TechXpress";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="استعد كلمة مرور حسابك في TechXpress عبر رابط آمن يُرسل إلى بريدك الإلكتروني." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-shell">
    <aside class="auth-aside">
        <div class="aside-brand"><i class="fas fa-microchip"></i>TechXpress</div>
        <h1>استعد حسابك في <span>خطوات بسيطة</span></h1>
        <p>
            أدخل بريدك الإلكتروني وسنمنحك رابطاً آمناً لإعادة تعيين كلمة المرور،
            مع الحفاظ الكامل على سرية بياناتك.
        </p>
        <ul class="auth-features">
            <li><i class="fas fa-lock"></i> رابط إعادة تعيين مُشفّر ومحدود الصلاحية</li>
            <li><i class="fas fa-user-shield"></i> لا نكشف بيانات الحسابات المسجّلة</li>
            <li><i class="fas fa-headset"></i> دعم فني جاهز لمساعدتك</li>
            <li><i class="fas fa-shield-halved"></i> حماية من محاولات تخمين كلمة المرور</li>
        </ul>
    </aside>

    <main class="auth-panel">
        <div class="auth-card">
            <div class="auth-brand-compact">
                <span class="logo-badge"><i class="fas fa-key"></i></span>
            </div>

            <div class="text-center mb-4">
                <h2 class="h3 fw-bold mb-1">نسيت كلمة المرور؟</h2>
                <p class="auth-lead mb-0">أدخل بريدك الإلكتروني لطلب رابط إعادة التعيين</p>
            </div>

            <form asp-action="ForgotPassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="auth-label"><i class="fas fa-envelope"></i>البريد الإلكتروني</label>
                    <input asp-for="Email" class="auth-input" placeholder="you@example.com" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn auth-btn w-100">
                    <i class="fas fa-paper-plane me-2"></i>إرسال رابط إعادة التعيين
                </button>
            </form>

            <div class="auth-divider"><span>أو</span></div>

            <div class="text-center">
                <a asp-action="Login" class="btn btn-outline-gold w-100">
                    <i class="fas fa-arrow-right me-2"></i>العودة لتسجيل الدخول
                </a>
            </div>
        </div>

        <p class="auth-footer-note">&copy; @DateTime.Now.Year TechXpress — جميع الحقوق محفوظة.</p>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
