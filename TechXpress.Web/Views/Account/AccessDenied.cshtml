@{
    ViewData["Title"] = "غير مصرّح بالدخول - TechXpress";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --beige: #FAF7F2;          
        --beige-hover: #ede6db;    
        --cream: #FAF7F2;          
        --navy: #0C223F;           
        --border: #E3D9C9;         
        --white: #FFFFFF;
        --text-muted: #64748b;
    }

    .access-denied-section {
        background-color: var(--cream);
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Cairo', "Segoe UI", sans-serif;
        padding: 50px 15px;
    }

    .denied-card {
        background: var(--white) !important;
        border: 1px solid var(--border) !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 30px -5px rgba(12, 34, 63, 0.06) !important;
        padding: 45px 35px !important;
        max-width: 520px;
        width: 100%;
        margin: 0 auto;
    }

    .denied-icon-badge {
        width: 70px;
        height: 70px;
        background: var(--navy);
        color: var(--beige);
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        box-shadow: 0 8px 20px rgba(12, 34, 63, 0.2);
        margin-bottom: 25px;
    }

    .denied-title {
        color: var(--navy);
        font-weight: 800;
        font-size: 26px;
        margin-bottom: 12px;
    }

    .denied-desc {
        color: var(--text-muted);
        font-size: 14.5px;
        line-height: 1.8;
        margin-bottom: 35px;
    }

    
    .btn-denied-primary {
        background: var(--beige) !important;
        border: 1.5px solid var(--border) !important;
        color: var(--navy) !important;
        border-radius: 10px !important;
        padding: 13px 20px;
        font-weight: 800;
        font-size: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(12, 34, 63, 0.08);
    }

    .btn-denied-primary:hover {
        background: var(--beige-hover) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(12, 34, 63, 0.14);
    }

   
    .btn-denied-outline {
        background: transparent !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 10px !important;
        padding: 12px 20px;
        font-weight: 700;
        font-size: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-denied-outline:hover {
        background: var(--beige) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
    }
</style>

<section class="access-denied-section text-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                
                <div class="denied-card">
                    
                    <div class="denied-icon-badge">
                        <i class="fas fa-lock"></i>
                    </div>

                    <h1 class="denied-title">غير مصرّح بالدخول</h1>
                    
                    <p class="denied-desc">
                        ليس لديك الصلاحية الكافية للوصول إلى هذه الصفحة.
                        إذا كنت تعتقد أن هذا خطأ، يرجى التواصل مع الدعم الفني أو تسجيل الدخول بحساب يملك الصلاحية المناسبة.
                    </p>

                    <div class="d-grid gap-3">
                        <a asp-controller="Home" asp-action="Index" class="btn-denied-primary">
                            <i class="fas fa-house ms-1"></i> العودة إلى الصفحة الرئيسية
                        </a>
                        <a asp-controller="Products" asp-action="Index" class="btn-denied-outline">
                            <i class="fas fa-box-open ms-1"></i> تصفح المنتجات
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>
