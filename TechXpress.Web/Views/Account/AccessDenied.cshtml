@{
    ViewData["Title"] = "غير مصرّح بالدخول - TechXpress";
}

<section class="py-5 text-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card border-secondary shadow-sm">
                    <div class="card-body p-5">
                        <div class="result-icon result-cancel mb-4">
                            <i class="fas fa-lock"></i>
                        </div>
                        <h1 class="h2 fw-bold mb-3">غير مصرّح بالدخول</h1>
                        <p class="text-muted mb-5">
                            ليس لديك الصلاحية للوصول إلى هذه الصفحة.
                            إذا كنت تعتقد أن هذا خطأ، تواصل مع الدعم الفني أو سجّل الدخول بحساب مناسب.
                        </p>

                        <div class="d-grid gap-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-warning btn-lg fw-bold py-3 shadow-sm">
                                <i class="fas fa-home me-2"></i>العودة إلى الصفحة الرئيسية
                            </a>
                            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-warning btn-lg fw-bold py-3">
                                <i class="fas fa-box me-2"></i>تصفح المنتجات
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
