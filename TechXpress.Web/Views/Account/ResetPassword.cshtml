@model TechXpress.Web.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور - TechXpress";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="عيّن كلمة مرور جديدة لحسابك في TechXpress." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-shell">
    <aside class="auth-aside">
        <div class="aside-brand"><i class="fas fa-microchip"></i>TechXpress</div>
        <h1>اختر <span>كلمة مرور قوية</span> لحسابك</h1>
        <p>
            استخدم مزيجاً من الأحرف الكبيرة والصغيرة والأرقام والرموز
            لحماية حسابك وبياناتك بشكل أفضل.
        </p>
        <ul class="auth-features">
            <li><i class="fas fa-key"></i> 6 أحرف على الأقل</li>
            <li><i class="fas fa-shield-halved"></i> رمز خاص ورقم وحرف كبير</li>
            <li><i class="fas fa-user-shield"></i> لا تشارك كلمة المرور مع أي شخص</li>
        </ul>
    </aside>

    <main class="auth-panel">
        <div class="auth-card">
            <div class="auth-brand-compact">
                <span class="logo-badge"><i class="fas fa-unlock-keyhole"></i></span>
            </div>

            <div class="text-center mb-4">
                <h2 class="h3 fw-bold mb-1">تعيين كلمة مرور جديدة</h2>
                <p class="auth-lead mb-0" dir="ltr">@Model.Email</p>
            </div>

            <form asp-action="ResetPassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All"></div>

                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="auth-label"><i class="fas fa-lock"></i>كلمة المرور الجديدة</label>
                    <div class="input-with-toggle">
                        <input asp-for="NewPassword" class="auth-input" placeholder="••••••••" autocomplete="new-password" />
                        <button type="button" class="toggle-password" title="إظهار/إخفاء كلمة المرور">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="auth-label"><i class="fas fa-lock"></i>تأكيد كلمة المرور</label>
                    <div class="input-with-toggle">
                        <input asp-for="ConfirmPassword" class="auth-input" placeholder="••••••••" autocomplete="new-password" />
                        <button type="button" class="toggle-password" title="إظهار/إخفاء كلمة المرور">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn auth-btn w-100">
                    <i class="fas fa-check me-2"></i>حفظ كلمة المرور الجديدة
                </button>
            </form>

            <div class="auth-divider"><span>أو</span></div>

            <div class="text-center">
                <a asp-action="Login" class="btn btn-outline-gold w-100">
                    <i class="fas fa-arrow-right me-2"></i>العودة لتسجيل الدخول
                </a>
            </div>
        </div>

        <p class="auth-footer-note">&copy; @DateTime.Now.Year TechXpress — جميع الحقوق محفوظة.</p>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>
