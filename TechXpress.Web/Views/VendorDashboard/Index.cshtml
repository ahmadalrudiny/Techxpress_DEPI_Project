
@model VendorDashboardViewModel
@{
    ViewData["Title"] = "لوحة تحكم البائع";
    var stats = Model.Stats;

    string ShippingText(TechXpress.Data.Entities.ShippingStatus s) => s switch
    {
        TechXpress.Data.Entities.ShippingStatus.Pending => "بانتظار التجهيز",
        TechXpress.Data.Entities.ShippingStatus.Preparing => "قيد التجهيز",
        TechXpress.Data.Entities.ShippingStatus.Shipped => "تم الشحن",
        TechXpress.Data.Entities.ShippingStatus.Delivered => "تم التوصيل",
        _ => s.ToString()
    };

    string ShippingBadge(TechXpress.Data.Entities.ShippingStatus s) => s switch
    {
        TechXpress.Data.Entities.ShippingStatus.Pending => "bg-warning text-dark",
        TechXpress.Data.Entities.ShippingStatus.Preparing => "bg-secondary",
        TechXpress.Data.Entities.ShippingStatus.Shipped => "bg-info text-dark",
        TechXpress.Data.Entities.ShippingStatus.Delivered => "bg-success",
        _ => "bg-secondary"
    };

    string TypeText(string t) => t switch
    {
        "Deposit" => "إيداع أرباح",
        "Withdrawal" => "طلب سحب",
        "Refund" => "استرداد",
        _ => t
    };

    string StatusText(string s) => s switch
    {
        "Pending" => "قيد الانتظار",
        "Completed" => "مكتمل",
        "Rejected" => "مرفوض",
        _ => s
    };
}

<partial name="_VendorNav" />

<style>
    :root {
        --beige: #FAF7F2;
        --beige-hover: #EDE6DB;
        --cream: #FAF7F2;
        --navy: #0C223F;
        --navy-dark: #071528;
        --navy-light: #153359;
        --border: #E3D9C9;
        --white: #FFFFFF;
        --text-dark: #0C223F;
        --text-muted: #64748b;
        --gold: #f59e0b;
    }

    body {
        background-color: var(--cream);
    }

    .page-head {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        padding: 22px 24px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(12,34,63,.04);
    }

    .page-head-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--beige);
        border: 1px solid var(--border);
        color: var(--navy);
        font-size: 23px;
    }

    .page-head-text {
        flex: 1;
        min-width: 200px;
    }

    .page-head-text h1 {
        color: var(--navy);
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .page-head-text p {
        color: var(--text-muted);
        font-size: 13px;
        margin-bottom: 0;
    }

    .page-head-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 13px;
        border-radius: 50px;
        background: var(--beige);
        border: 1px solid var(--border);
        color: var(--navy);
        font-size: 12px;
        font-weight: 700;
    }

    .chip-gold {
        background: #ecfdf5;
        border-color: #bbf7d0;
        color: #15803d;
    }

    .stat-card {
        height: 100%;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(12,34,63,.04);
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(12,34,63,.08);
    }

    .stat-card h2 {
        font-size: 25px;
        font-weight: 800;
    }

    .stat-card .text-warning,
    .stat-card h2.text-warning {
        color: var(--navy) !important;
    }

    .stat-card .text-success,
    .stat-card h2.text-success {
        color: #15803d !important;
    }

    .stat-card .text-info {
        color: var(--navy-light) !important;
    }

    .stat-card .text-dark {
        color: var(--navy) !important;
    }

    .stat-card .fa-wallet,
    .stat-card .fa-truck-fast {
        color: var(--navy) !important;
        opacity: .55;
    }

    .stat-card .fa-chart-line {
        color: #15803d !important;
    }

    .stat-card .fa-box {
        color: var(--navy-light) !important;
    }

    .stat-card a.text-warning {
        color: var(--navy) !important;
        font-weight: 700;
        text-decoration: none;
    }

    .stat-card a.text-warning:hover {
        color: var(--navy-light) !important;
        text-decoration: underline;
    }

    .card {
        background: var(--white);
        border: 1px solid var(--border) !important;
        border-radius: 16px !important;
        box-shadow: 0 4px 16px rgba(12,34,63,.04) !important;
        overflow: hidden;
        transition: box-shadow .2s ease, transform .2s ease;
    }

    a.card {
        color: var(--navy);
    }

    a.card:hover {
        transform: translateY(-4px);
        border-color: var(--navy) !important;
        box-shadow: 0 8px 24px rgba(12,34,63,.08) !important;
    }

    .card h3 {
        color: var(--navy);
    }

    .card-header {
        background: var(--navy) !important;
        border-color: var(--border) !important;
        padding: 15px 18px !important;
    }

    .card-header h2 {
        color: var(--white) !important;
        font-size: 16px;
        font-weight: 800;
    }

    .card-header h2 i {
        color: var(--beige);
    }

    .card-body {
        color: var(--navy);
    }

    .hover-lift span {
        background: var(--beige) !important;
        border: 1px solid var(--border);
        color: var(--navy) !important;
    }

    .hover-lift span i {
        color: var(--navy);
    }

    .btn-warning,
    .btn-primary {
        background: var(--beige) !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 9px !important;
        font-weight: 700 !important;
        transition: all .2s ease;
    }

    .btn-warning:hover,
    .btn-primary:hover {
        background: var(--navy) !important;
        color: var(--white) !important;
        border-color: var(--navy) !important;
    }

    .btn-outline-warning {
        background: transparent !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 8px !important;
        font-weight: 700 !important;
        transition: all .2s ease;
    }

    .btn-outline-warning:hover {
        background: var(--navy) !important;
        color: var(--white) !important;
        border-color: var(--navy) !important;
    }

    .btn-outline-secondary {
        color: var(--navy);
        border-color: var(--border);
    }

    .btn-outline-secondary:hover {
        background: var(--navy);
        color: var(--white);
    }

    .table {
        color: var(--navy);
        --bs-table-color: var(--navy);
        --bs-table-hover-color: var(--navy);
        --bs-table-hover-bg: var(--beige);
        --bs-table-border-color: var(--border);
    }

    .table thead,
    .table thead.bg-secondary {
        background: var(--beige) !important;
        color: var(--navy) !important;
    }

    .table thead th {
        color: var(--navy) !important;
        font-size: 12px;
        font-weight: 800;
        padding: 13px 10px;
        white-space: nowrap;
        border-bottom: 1px solid var(--border);
    }

    .table tbody td {
        color: var(--navy);
        font-size: 13px;
        padding: 13px 10px;
    }

    .table tbody tr:hover {
        background: var(--beige);
    }

    .badge {
        font-weight: 700;
        border-radius: 6px;
        padding: 5px 9px;
        font-size: 11px;
    }

    .badge.bg-warning {
        background: var(--beige) !important;
        color: var(--navy) !important;
        border: 1px solid var(--border);
    }

    .badge.bg-info {
        background: #f1f5f9 !important;
        color: var(--navy) !important;
        border: 1px solid #e2e8f0;
    }

    .badge.bg-success {
        background: #ecfdf5 !important;
        color: #15803d !important;
        border: 1px solid #bbf7d0;
    }

    .badge.bg-danger {
        background: #fef2f2 !important;
        color: #b91c1c !important;
        border: 1px solid #fecaca;
    }

    .badge.bg-secondary {
        background: #f1f5f9 !important;
        color: var(--navy) !important;
        border: 1px solid #e2e8f0;
    }

    .text-warning {
        color: var(--navy) !important;
    }

    .text-muted {
        color: var(--text-muted) !important;
    }

    .price-tag {
        color: var(--navy);
        font-weight: 800;
    }

    .empty-state {
        color: var(--text-muted);
    }

    .empty-state i {
        color: var(--navy);
    }

    .empty-state h3 {
        color: var(--navy);
    }

    .alert-warning {
        background: var(--beige);
        border: 1px solid var(--border);
        color: var(--navy);
        border-radius: 12px;
    }

    .alert-warning > i {
        color: var(--gold);
    }

    .alert-warning a {
        color: var(--navy);
    }

    .alert-warning a:hover {
        color: var(--navy-light);
    }

    .border-bottom {
        border-color: var(--border) !important;
    }

    .text-danger {
        color: #dc2626 !important;
    }

    .text-success {
        color: #15803d !important;
    }

    @@media (max-width: 767px) {
        .page-head {
            padding: 16px;
        }

        .page-head-text h1 {
            font-size: 20px;
        }

        .page-head-actions {
            width: 100%;
        }

        .stat-card {
            padding: 16px !important;
        }

        .stat-card h2 {
            font-size: 20px;
        }
    }
</style>

<!-- Page Header -->
<div class="page-head mb-4">
    <div class="page-head-icon"><i class="fas fa-store"></i></div>
    <div class="page-head-text">
        <h1>@Model.StoreName</h1>
        <p>
            مرحباً @(User.Identity?.Name) — هذه لوحة إدارة متجرك: المنتجات، الطلبات والأرباح في مكان واحد.
        </p>
    </div>
    <div class="page-head-actions">
        @if (Model.Status == "Approved")
        {
            <span class="chip chip-gold"><i class="fas fa-circle-check"></i> متجر معتمد</span>
        }
        else if (Model.Status == "Pending")
        {
            <span class="chip" style="background: rgba(245,179,1,.14); border-color: rgba(245,179,1,.4); color: var(--navy);">
                <i class="fas fa-hourglass-half"></i> قيد المراجعة
            </span>
        }
        else
        {
            <span class="chip" style="background: #fef2f2; border-color: #fecaca; color: #b91c1c;">
                <i class="fas fa-circle-xmark"></i> مرفوض
            </span>
        }
        <a asp-controller="VendorProduct" asp-action="Create" class="btn btn-warning btn-sm fw-bold">
            <i class="fas fa-plus me-1"></i>منتج جديد
        </a>
    </div>
</div>

@if (!Model.IsApproved)
{
    <div class="alert alert-warning mb-4 d-flex align-items-start" role="alert">
        <i class="fas fa-triangle-exclamation fa-lg me-3 mt-1"></i>
        <div>
            @if (Model.Status == "Pending")
            {
                <strong>طلب انضمامك لا يزال قيد المراجعة.</strong>
                <div class="small mt-1">
                    يمكنك تصفّح اللوحة الآن، وبعد موافقة الإدارة ستتمكن من إضافة المنتجات واستقبال الطلبات.
                </div>
            }
            else
            {
                <strong>تم رفض طلب انضمامك.</strong>
                @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                {
                    <div class="small mt-1">السبب: @Model.RejectionReason</div>
                }
                <div class="small mt-1">
                    يمكنك تحديث المستندات وإعادة التقديم من
                    <a asp-controller="VendorApply" asp-action="Apply" class="fw-bold">صفحة التقديم</a>.
                </div>
            }
        </div>
    </div>
}

<!-- Stats -->
<div class="row g-3 g-lg-4 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted small mb-1">رصيد المحفظة</p>
                    <h2 class="fw-bold text-warning mb-0">$@Model.Balance.ToString("N2")</h2>
                </div>
                <i class="fas fa-wallet fa-2x text-warning opacity-50"></i>
            </div>
            <a asp-controller="VendorWallet" asp-action="Index" class="small text-warning d-inline-block mt-2">
                إدارة الأرباح والسحب <i class="fas fa-arrow-left ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted small mb-1">إجمالي المبيعات</p>
                    <h2 class="fw-bold text-success mb-0">$@stats.TotalSales.ToString("N2")</h2>
                </div>
                <i class="fas fa-chart-line fa-2x text-success opacity-50"></i>
            </div>
            <span class="small text-muted d-inline-block mt-2">
                من @(stats.AwaitingShipment + stats.ShippedOrders + stats.DeliveredOrders) طلب مدفوع — غير المدفوع والملغي لا يُحتسب
            </span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted small mb-1">منتجاتي</p>
                    <h2 class="fw-bold text-dark mb-0">@stats.TotalProducts</h2>
                </div>
                <i class="fas fa-box fa-2x text-info opacity-50"></i>
            </div>
            <span class="small text-muted d-inline-block mt-2">
                @stats.ActiveProducts نشط • @stats.InactiveProducts غير نشط
            </span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted small mb-1">طلبات تحتاج شحن</p>
                    <h2 class="fw-bold text-warning mb-0">@stats.AwaitingShipment</h2>
                </div>
                <i class="fas fa-truck-fast fa-2x text-warning opacity-50"></i>
            </div>
            <span class="small text-muted d-inline-block mt-2">
                @stats.ShippedOrders مشحون • @stats.DeliveredOrders مُسلّم
            </span>
        </div>
    </div>
</div>

<!-- Quick actions -->
<div class="row g-3 g-lg-4 mb-4">
    <div class="col-md-6 col-lg-3">
        <a asp-controller="VendorProduct" asp-action="Index" class="card p-3 h-100 hover-lift text-decoration-none">
            <div class="d-flex align-items-center gap-3">
                <span class="bg-warning text-dark rounded-circle p-3"><i class="fas fa-box fa-lg"></i></span>
                <div>
                    <h3 class="h6 fw-bold mb-0">إدارة المنتجات</h3>
                    <p class="text-muted small mb-0">إضافة وتعديل منتجاتك</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a asp-controller="VendorOrder" asp-action="Index" class="card p-3 h-100 hover-lift text-decoration-none">
            <div class="d-flex align-items-center gap-3">
                <span class="bg-info text-dark rounded-circle p-3"><i class="fas fa-receipt fa-lg"></i></span>
                <div>
                    <h3 class="h6 fw-bold mb-0">طلبات متجري</h3>
                    <p class="text-muted small mb-0">متابعة طلبات عملائك</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a asp-controller="VendorWallet" asp-action="Index" class="card p-3 h-100 hover-lift text-decoration-none">
            <div class="d-flex align-items-center gap-3">
                <span class="bg-success text-white rounded-circle p-3"><i class="fas fa-wallet fa-lg"></i></span>
                <div>
                    <h3 class="h6 fw-bold mb-0">المحفظة والأرباح</h3>
                    <p class="text-muted small mb-0">السحب وكشف الحساب</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a asp-controller="VendorProduct" asp-action="Create" class="card p-3 h-100 hover-lift text-decoration-none">
            <div class="d-flex align-items-center gap-3">
                <span class="bg-secondary text-white rounded-circle p-3"><i class="fas fa-plus fa-lg"></i></span>
                <div>
                    <h3 class="h6 fw-bold mb-0">إضافة منتج</h3>
                    <p class="text-muted small mb-0">اعرض منتجاً جديداً للبيع</p>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Recent orders -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-secondary shadow-sm h-100">
            <div class="card-header bg-dark border-secondary py-3 d-flex justify-content-between align-items-center">
                <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-clock-rotate-left me-2"></i>آخر الطلبات</h2>
                <a asp-controller="VendorOrder" asp-action="Index" class="btn btn-sm btn-outline-warning">
                    كل الطلبات <i class="fas fa-arrow-left ms-1"></i>
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentOrders.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-secondary text-white">
                                <tr>
                                    <th>الطلب</th>
                                    <th class="text-center">عدد القطع</th>
                                    <th class="text-center">قيمة طلبك</th>
                                    <th class="text-center">حالة الشحن</th>
                                    <th class="text-center">التاريخ</th>
                                    <th class="text-end">تفاصيل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td><span class="fw-bold text-dark">#@order.OrderId</span></td>
                                        <td class="text-center">@order.ItemsCount</td>
                                        <td class="text-center fw-bold">$@order.VendorTotal.ToString("N2")</td>
                                        <td class="text-center">
                                            <span class="badge @ShippingBadge(order.ShippingStatus)">@ShippingText(order.ShippingStatus)</span>
                                        </td>
                                        <td class="text-center text-muted small">@order.OrderDate.ToLocalTime().ToString("yyyy/MM/dd")</td>
                                        <td class="text-end">
                                            <a asp-controller="VendorOrder" asp-action="Details" asp-route-id="@order.OrderId"
                                               class="btn btn-sm btn-outline-warning" title="عرض تفاصيل الطلب" aria-label="عرض تفاصيل الطلب">
                                                <i class="fas fa-eye" aria-hidden="true"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state text-center py-5">
                        <i class="fas fa-inbox fa-3x mb-3"></i>
                        <h3 class="h6 fw-bold mb-1">لا توجد طلبات بعد</h3>
                        <p class="small mb-0">عند شراء العملاء لمنتجاتك ستظهر الطلبات هنا.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Recent products -->
        <div class="card border-secondary shadow-sm mb-4">
            <div class="card-header bg-dark border-secondary py-3">
                <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-box me-2"></i>أحدث منتجاتي</h2>
            </div>
            <div class="card-body p-3">
                @if (Model.RecentProducts.Any())
                {
                    foreach (var p in Model.RecentProducts)
                    {
                        <div class="d-flex align-items-center gap-3 py-2 border-bottom"
                             style="border-color: rgba(15,23,42,.07) !important;">
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" alt="@p.Name" class="rounded"
                                     style="width: 46px; height: 46px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="bg-secondary rounded d-inline-flex align-items-center justify-content-center text-muted"
                                      style="width: 46px; height: 46px;"><i class="fas fa-box"></i></span>
                            }
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-bold text-truncate" title="@p.Name">@p.Name</div>
                                <div class="small text-muted">
                                    <span class="price-tag">$@p.Price.ToString("N2")</span>
                                    <span class="mx-1">•</span>
                                    <span class="@(p.StockQuantity > 0 ? "text-success" : "text-danger")">
                                        @(p.StockQuantity > 0 ? $"مخزون {p.StockQuantity}" : "نفد المخزون")
                                    </span>
                                </div>
                            </div>
                            @if (!p.IsActive)
                            {
                                <span class="badge bg-secondary">غير نشط</span>
                            }
                        </div>
                    }
                    <a asp-controller="VendorProduct" asp-action="Index" class="btn btn-outline-warning btn-sm w-100 mt-3">
                        كل منتجاتي <i class="fas fa-arrow-left ms-1"></i>
                    </a>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-box-open fa-2x text-muted mb-2"></i>
                        <p class="small text-muted mb-3">لم تُضف منتجات بعد.</p>
                        <a asp-controller="VendorProduct" asp-action="Create" class="btn btn-warning btn-sm">
                            <i class="fas fa-plus me-1"></i>إضافة أول منتج
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Recent wallet activity -->
        <div class="card border-secondary shadow-sm">
            <div class="card-header bg-dark border-secondary py-3 d-flex justify-content-between align-items-center">
                <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-receipt me-2"></i>آخر الحركات</h2>
                @if (stats.PendingPayouts > 0)
                {
                    <span class="badge bg-warning text-dark">@stats.PendingPayouts قيد المراجعة</span>
                }
            </div>
            <div class="card-body p-3">
                @if (Model.RecentTransactions.Any())
                {
                    foreach (var t in Model.RecentTransactions)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom"
                             style="border-color: rgba(15,23,42,.07) !important;">
                            <div>
                                <div class="fw-bold small">@TypeText(t.Type)</div>
                                <div class="text-muted" style="font-size: .75rem;">
                                    @t.Date.ToLocalTime().ToString("yyyy/MM/dd HH:mm") • @StatusText(t.Status)
                                </div>
                            </div>
                            <span class="fw-bold @(t.Type == "Withdrawal" ? "text-danger" : "text-success")">
                                @(t.Type == "Withdrawal" ? "-" : "+")$@t.Amount.ToString("N2")
                            </span>
                        </div>
                    }
                    <a asp-controller="VendorWallet" asp-action="Index" class="btn btn-outline-warning btn-sm w-100 mt-3">
                        كشف الحساب الكامل
                    </a>
                }
                else
                {
                    <div class="text-center py-3">
                        <i class="fas fa-wallet fa-2x text-muted mb-2"></i>
                        <p class="small text-muted mb-0">لا توجد حركات على المحفظة بعد.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
