@inject TechXpress.Services.Interfaces.ICartService CartService
@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole("Admin");
    var isVendor = User.IsInRole("Vendor");

    var pageTitle = ViewData["Title"] as string;
    var documentTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? "TechXpress - متجر الإلكترونيات الأول"
        : pageTitle.Contains("TechXpress", StringComparison.OrdinalIgnoreCase)
            ? pageTitle
            : pageTitle + " - TechXpress";

    var metaDescription = ViewData["Description"] as string
        ?? "TechXpress — سوق إلكتروني متكامل للأجهزة الإلكترونية: لابتوبات وهواتف ذكية وكاميرات وملحقات من بائعين معتمدين، مع دفع إلكتروني آمن وتقييمات موثوقة وتوصيل سريع.";

    var cartJsonForBadge = Context.Session.GetString(CartSession.Key);
    var initialCartCount = string.IsNullOrWhiteSpace(cartJsonForBadge)
        ? 0
        : CartService.GetItemCount(cartJsonForBadge);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@documentTitle</title>
    <meta name="description" content="@metaDescription" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --cream: #FAF7F2;
            --beige: #FAF7F2;
            --beige-hover: #ede6db;
            --navy: #0C223F;
            --navy-dark: #071528;
            --navy-light: #173860;
            --border: #E3D9C9;
            --white: #FFFFFF;
            --text-dark: #0C223F;
            --text-muted: #64748b;
        }

        * {
            font-family: 'Cairo', "Segoe UI", sans-serif;
        }

        body.app-body {
            background-color: var(--cream);
            color: var(--text-dark);
        }

        .app-navbar {
            background-color: var(--white) !important;
            border-bottom: 1px solid var(--border);
            box-shadow: 0 4px 16px rgba(12, 34, 63, 0.04);
            padding-top: 12px;
            padding-bottom: 12px;
        }

        .navbar-brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .brand-badge {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #ffd257 0%, #f5b301 100%) !important;
            color: #1a1400 !important;
            border-radius: 13px !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            box-shadow: 0 4px 14px rgba(245, 179, 1, 0.4) !important;
            flex-shrink: 0;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .navbar-brand:hover .brand-badge,
        .footer-brand:hover .brand-badge {
            transform: scale(1.05);
            box-shadow: 0 6px 18px rgba(245, 179, 1, 0.5) !important;
        }

        .brand-text strong {
            display: block;
            color: var(--navy);
            font-size: 20px;
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -0.3px;
        }

        .brand-text small {
            display: block;
            color: var(--text-muted);
            font-size: 11px;
            font-weight: 600;
        }

        .nav-link {
            color: var(--navy) !important;
            font-weight: 700;
            font-size: 14.5px;
            transition: color 0.2s ease;
        }

        .nav-link:hover {
            color: var(--navy-light) !important;
        }

        .nav-icon-link {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--white);
            border: 1.5px solid var(--border);
            color: var(--navy) !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            transition: all 0.2s ease;
            padding: 0 !important;
        }

        .nav-icon-link:hover {
            background: var(--beige);
            border-color: var(--navy);
            color: var(--navy) !important;
            transform: translateY(-1px);
        }

        .navbar-search-wrap {
            min-width: 260px;
        }

        .search-field {
            position: relative;
        }

        .search-field .search-icon {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 14px;
            pointer-events: none;
        }

        .search-input {
            background: #FFFFFF !important;
            border: 1.5px solid var(--border) !important;
            border-radius: 50rem !important;
            padding: 8px 38px 8px 16px !important;
            font-size: 13.5px;
            color: var(--navy) !important;
            transition: all 0.2s ease;
        }

        .search-input:focus {
            border-color: var(--navy) !important;
            box-shadow: 0 0 0 3px rgba(12, 34, 63, 0.1) !important;
            outline: none;
        }

        .search-suggest {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            left: 0;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(12, 34, 63, 0.1);
            z-index: 1050;
            overflow: hidden;
            max-height: 380px;
            overflow-y: auto;
        }

        .suggest-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            text-decoration: none;
            color: var(--navy);
            border-bottom: 1px solid rgba(227, 217, 201, 0.4);
            transition: background 0.2s ease;
        }

        .suggest-item:hover {
            background: var(--beige);
            color: var(--navy);
        }

        .suggest-thumb img,
        .suggest-placeholder {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            object-fit: contain;
            background: #fafafa;
            border: 1px solid var(--border);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
        }

        .suggest-body {
            flex-grow: 1;
            overflow: hidden;
        }

        .suggest-name {
            display: block;
            font-size: 13.5px;
            font-weight: 700;
            color: var(--navy);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .suggest-meta {
            display: block;
            font-size: 11.5px;
            color: var(--text-muted);
        }

        .suggest-price {
            font-size: 13.5px;
            font-weight: 800;
            color: var(--navy);
        }

        .suggest-all {
            display: block;
            padding: 10px;
            text-align: center;
            background: #f8fafc;
            color: var(--navy);
            font-size: 12.5px;
            font-weight: 700;
            text-decoration: none;
        }

        .suggest-all:hover {
            background: var(--beige);
            color: var(--navy);
        }

        .search-suggest-empty {
            padding: 16px;
            text-align: center;
            color: var(--text-muted);
            font-size: 13px;
        }

        .app-navbar .btn-warning {
            background: var(--beige) !important;
            color: var(--navy) !important;
            border: 1.5px solid var(--border) !important;
            border-radius: 10px !important;
            font-weight: 800 !important;
            transition: all 0.2s ease;
        }

        .app-navbar .btn-warning:hover {
            background: var(--navy) !important;
            color: var(--white) !important;
            border-color: var(--navy) !important;
            transform: translateY(-1px);
        }

        .app-navbar .btn-outline-dark {
            background: transparent !important;
            color: var(--navy) !important;
            border: 1.5px solid var(--border) !important;
            border-radius: 10px !important;
            font-weight: 700 !important;
            transition: all 0.2s ease;
        }

        .app-navbar .btn-outline-dark:hover {
            background: var(--beige) !important;
            border-color: var(--navy) !important;
            color: var(--navy) !important;
        }

        #cartCount {
            background: var(--navy) !important;
            color: var(--white) !important;
            border: 1.5px solid var(--white);
            font-weight: 800;
            font-size: 10px;
        }

        .avatar-circle {
            width: 34px;
            height: 34px;
            background: var(--beige);
            color: var(--navy);
            border: 1.5px solid var(--border);
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 13px;
        }

        .dropdown-menu {
            border: 1px solid var(--border) !important;
            border-radius: 14px !important;
            box-shadow: 0 10px 30px rgba(12, 34, 63, 0.08) !important;
            padding: 8px !important;
            background: var(--white);
        }

        .dropdown-item {
            font-size: 13.5px;
            font-weight: 600;
            color: var(--navy);
            border-radius: 8px;
            padding: 8px 14px;
            transition: all 0.2s ease;
        }

        .dropdown-item:hover {
            background-color: var(--beige);
            color: var(--navy);
        }

        .dropdown-divider {
            border-color: var(--border);
            margin: 6px 0;
        }

        .app-footer {
            background: linear-gradient(165deg, var(--navy-dark) 0%, var(--navy) 65%, #153359 100%);
            color: #e2e8f0;
        }

        .footer-brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .footer-brand .brand-text strong {
            color: var(--white);
            font-size: 20px;
            font-weight: 800;
            line-height: 1.1;
        }

        .footer-brand .brand-text small {
            color: #cbd5e1;
            font-size: 11px;
            font-weight: 600;
        }

        .footer-title {
            color: var(--white);
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 18px;
        }

        .footer-links a {
            color: #cbd5e1;
            text-decoration: none;
            font-size: 13.5px;
            transition: color 0.2s ease, transform 0.2s ease;
            display: inline-block;
            margin-bottom: 8px;
        }

        .footer-links a:hover {
            color: var(--white);
            transform: translateX(-3px);
        }

        .footer-links li {
            margin-bottom: 8px;
            color: #cbd5e1;
            font-size: 13.5px;
        }

        .footer-social {
            display: flex;
            gap: 10px;
        }

        .footer-social a {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: var(--white);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .footer-social a:hover {
            background: var(--beige);
            color: var(--navy);
            border-color: var(--beige);
            transform: translateY(-2px);
        }

        .footer-pay .chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: var(--white);
            border-radius: 50rem;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: 700;
        }

        .footer-divider {
            border-color: rgba(255, 255, 255, 0.12);
        }

        .back-to-top {
            position: fixed;
            bottom: 24px;
            left: 24px;
            width: 44px;
            height: 44px;
            background: var(--white);
            color: var(--navy);
            border: 1.5px solid var(--border);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            box-shadow: 0 6px 18px rgba(12, 34, 63, 0.1);
            opacity: 0;
            visibility: hidden;
            transition: all 0.25s ease;
            z-index: 999;
            cursor: pointer;
        }

        .back-to-top.show {
            opacity: 1;
            visibility: visible;
        }

        .back-to-top:hover {
            background: var(--navy);
            color: var(--white);
            border-color: var(--navy);
            transform: translateY(-3px);
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-body d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light app-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge"><i class="fas fa-microchip"></i></span>
                    <span class="brand-text">
                        <strong>TechXpress</strong>
                        <small>متجر الإلكترونيات</small>
                    </span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="فتح القائمة">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-house ms-1"></i> الرئيسة
                            </a>
                        </li>

                        @if (!isAdmin && !isVendor)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-area="" asp-controller="Products" asp-action="Index">
                                    <i class="fas fa-box ms-1"></i> المنتجات
                                </a>
                            </li>
                        }

                        @if (isVendor)
                        {
                            <li class="nav-item ms-2">
                                <a class="btn btn-warning btn-sm px-3 fw-bold text-dark" asp-area="" asp-controller="VendorDashboard" asp-action="Index">
                                    <i class="fas fa-gauge-high ms-1"></i> لوحة تحكم متجري
                                </a>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-item ms-2">
                                <a class="btn btn-warning btn-sm px-3 fw-bold text-dark" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fas fa-gauge-high ms-1"></i> لوحة التحكم
                                </a>
                            </li>
                        }
                    </ul>

                    @if (!isAdmin && !isVendor)
                    {
                        <div class="navbar-search-wrap my-3 my-lg-0 ms-lg-3">
                            <div class="search-field">
                                <i class="fas fa-magnifying-glass search-icon"></i>
                                <input type="text" id="globalSearchInput" class="form-control search-input"
                                       placeholder="ابحث عن منتج..." autocomplete="off"
                                       role="combobox" aria-controls="globalSearchResults" aria-autocomplete="list"
                                       aria-label="البحث عن منتج" aria-expanded="false" />
                                <div id="globalSearchResults" class="search-suggest d-none" role="listbox" aria-label="نتائج البحث"></div>
                            </div>
                        </div>
                    }

                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        @if (isAuthenticated && !isAdmin && !isVendor)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-icon-link" asp-area="" asp-controller="Wishlist" asp-action="Index"
                                   title="المفضلة" aria-label="المفضلة">
                                    <i class="far fa-heart"></i>
                                </a>
                            </li>
                            <li class="nav-item me-lg-2">
                                <a class="nav-link nav-icon-link position-relative" asp-area="" asp-controller="Cart" asp-action="Index"
                                   title="سلة التسوق">
                                    <i class="fas fa-cart-shopping" aria-hidden="true"></i>
                                    <span class="visually-hidden">سلة التسوق</span>
                                    <span id="cartCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark small" aria-hidden="true">@initialCartCount</span>
                                </a>
                            </li>
                        }
                        @if (isAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="avatar-circle">
                                        @(string.IsNullOrWhiteSpace(User.Identity!.Name) ? "؟" : User.Identity.Name!.Substring(0, 1).ToUpper())
                                    </span>
                                    <span class="d-none d-xl-inline text-truncate" style="max-width: 140px;">@User.Identity!.Name</span>
                                    @if (isAdmin)
                                    {
                                        <span class="badge bg-danger">أدمن</span>
                                    }
                                    else if (isVendor)
                                    {
                                        <span class="badge" style="background: var(--beige); color: var(--navy); border: 1px solid var(--border);">مورد</span>
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li class="px-3 pt-2 pb-1">
                                        <div class="fw-bold text-truncate" style="max-width: 230px; color: var(--navy);">@User.Identity!.Name</div>
                                        <small class="text-muted">@(isAdmin ? "مدير النظام" : isVendor ? "بائع معتمد" : "عميل")</small>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    @if (!isAdmin && !isVendor)
                                    {
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index"><i class="fas fa-user ms-2"></i>ملفي الشخصي</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Orders"><i class="fas fa-box ms-2"></i>طلباتي</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Wishlist" asp-action="Index"><i class="fas fa-heart ms-2"></i>المفضلة</a></li>
                                    }
                                    else if (isVendor)
                                    {
                                        <li><a class="dropdown-item" asp-area="" asp-controller="VendorDashboard" asp-action="Index"><i class="fas fa-gauge-high ms-2"></i>لوحة تحكم متجري</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="VendorWallet" asp-action="Index"><i class="fas fa-wallet ms-2"></i>محفظتي</a></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-gauge-high ms-2"></i>لوحة التحكم</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index"><i class="fas fa-store ms-2"></i>زيارة المتجر</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fas fa-right-from-bracket ms-2"></i>تسجيل الخروج
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-dark btn-sm px-3" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-right-to-bracket ms-1"></i> دخول
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm px-3 fw-bold text-dark" asp-area="" asp-controller="Account" asp-action="Register">
                                    <i class="fas fa-user-plus ms-1"></i> حساب جديد
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer mt-auto pt-5 pb-4">
        <div class="container">
            <div class="row g-4 g-lg-5">
                <div class="col-lg-5">
                    <a class="footer-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="brand-badge"><i class="fas fa-microchip"></i></span>
                        <span class="brand-text">
                            <strong>TechXpress</strong>
                            <small>متجر الإلكترونيات</small>
                        </span>
                    </a>
                    <p class="text-muted small mt-3 mb-4" style="max-width: 380px; color: #cbd5e1 !important;">
                        سوق إلكتروني متكامل لأحدث أجهزة الكمبيوتر والهواتف الذكية والكاميرات والملحقات،
                        بأسعار تنافسية ودفع آمن وتوصيل سريع.
                    </p>
                    <div class="footer-social">
                        <a href="#" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" aria-label="إكس"><i class="fab fa-x-twitter"></i></a>
                        <a href="#" aria-label="إنستجرام"><i class="fab fa-instagram"></i></a>
                        <a href="#" aria-label="لينكد إن"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <h2 class="footer-title">روابط سريعة</h2>
                    <ul class="list-unstyled small footer-links mb-0">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index">الرئيسة</a></li>
                        @if (!isAdmin && !isVendor)
                        {
                            <li><a asp-area="" asp-controller="Products" asp-action="Index">المنتجات</a></li>
                            <li><a asp-area="" asp-controller="Cart" asp-action="Index">سلة التسوق</a></li>
                        }
                        else if (isVendor)
                        {
                            <li><a asp-area="" asp-controller="VendorDashboard" asp-action="Index">لوحة تحكم متجري</a></li>
                            <li><a asp-area="" asp-controller="VendorProduct" asp-action="Index">منتجاتي</a></li>
                        }
                        <li><a asp-area="" asp-controller="Home" asp-action="About">من نحن</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Contact">تواصل معنا</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">سياسة الخصوصية</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-4">
                    <h2 class="footer-title">تواصل معنا</h2>
                    <ul class="list-unstyled small footer-links mb-0">
                        <li><i class="fas fa-envelope ms-2" style="color: #ffd257;"></i>support@techxpress.com</li>
                        <li><i class="fas fa-phone ms-2" style="color: #ffd257;"></i>+20 100 000 0000</li>
                        <li><i class="fas fa-location-dot ms-2" style="color: #ffd257;"></i>القاهرة، مصر</li>
                    </ul>
                    <div class="footer-pay mt-3">
                        <span class="chip">
                            <i class="fas fa-lock ms-1"></i> دفع آمن ومشفّر
                        </span>
                    </div>
                </div>
            </div>
            <hr class="footer-divider my-4" />
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small" style="color: #cbd5e1;">
                <span>&copy; @DateTime.Now.Year - <strong class="text-white">TechXpress</strong> - جميع الحقوق محفوظة.</span>
                <span><i class="fas fa-shield-halved ms-1"></i> بياناتك محمية بأعلى معايير الأمان</span>
            </div>
        </div>
    </footer>

    <button type="button" class="back-to-top" id="backToTop" aria-label="العودة إلى أعلى الصفحة" title="العودة إلى أعلى الصفحة">
        <i class="fas fa-arrow-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>

    @Html.AntiForgeryToken()

    <script>
        if (typeof toastr !== "undefined") {
            toastr.options.positionClass = "toast-top-right";
            toastr.options.closeButton = true;
            toastr.options.progressBar = true;
            toastr.options.newestOnTop = true;
        }

        $.ajaxSetup({
            beforeSend: function (xhr, settings) {
                if (!/^(GET|HEAD|OPTIONS|TRACE)$/i.test(settings.type)) {
                    var token = $('input[name="__RequestVerificationToken"]').first().val();
                    if (token) {
                        xhr.setRequestHeader("RequestVerificationToken", token);
                    }
                }
            }
        });

        function refreshCartCount() {
            $.get("@Url.Action("Count", "Cart")", function (data) {
                if (data && typeof data.cartCount !== "undefined") {
                    $("#cartCount").text(data.cartCount);
                }
            });
        }

        function addToCart(productId, quantity, button) {
            quantity = quantity || 1;
            var $btn = button ? $(button) : null;
            if ($btn) { $btn.prop("disabled", true); }

            $.post("@Url.Action("Add", "Cart")", { id: productId, quantity: quantity })
                .done(function (res) {
                    if (res && res.success) {
                        if (typeof toastr !== "undefined") { toastr.success(res.message || "تمت إضافة المنتج إلى السلة", "نجاح"); }
                        refreshCartCount();
                    } else {
                        if (typeof toastr !== "undefined") { toastr.warning((res && res.message) || "تعذّر إضافة المنتج", "تنبيه"); }
                    }
                })
                .fail(function () {
                    if (typeof toastr !== "undefined") { toastr.error("حدث خطأ أثناء إضافة المنتج. حاول مرة أخرى.", "خطأ"); }
                })
                .always(function () {
                    if ($btn) { $btn.prop("disabled", false); }
                });
        }

        (function () {
            var $input = $("#globalSearchInput");
            if (!$input.length) { return; }

            var $box = $("#globalSearchResults");
            var timer = null;
            var request = null;
            var lastQuery = "";

            function escapeHtml(value) {
                return $("<div>").text(value == null ? "" : value).html();
            }

            function closeBox() {
                $box.addClass("d-none").empty();
                $input.attr("aria-expanded", "false");
            }

            function render(items, term) {
                if (!items || !items.length) {
                    $box.html('<div class="search-suggest-empty"><i class="fas fa-circle-info ms-2"></i>لا توجد نتائج لـ "' +
                        escapeHtml(term) + '"</div>').removeClass("d-none");
                    $input.attr("aria-expanded", "true");
                    return;
                }

                var html = "";
                items.forEach(function (p) {
                    var img = p.image
                        ? '<img src="' + escapeHtml(p.image) + '" alt="" />'
                        : '<span class="suggest-placeholder"><i class="fas fa-box"></i></span>';
                    var stock = p.inStock
                        ? '<span class="text-success">متوفر</span>'
                        : '<span class="text-danger">غير متوفر</span>';

                    html += '<a class="suggest-item" role="option" href="@Url.Action("Details", "Products")/' + p.id + '">' +
                        '<span class="suggest-thumb">' + img + '</span>' +
                        '<span class="suggest-body">' +
                            '<span class="suggest-name">' + escapeHtml(p.name) + '</span>' +
                            '<span class="suggest-meta">' + escapeHtml(p.category || "") + ' • ' + stock + '</span>' +
                        '</span>' +
                        '<span class="suggest-price">$' + Number(p.price).toFixed(2) + '</span>' +
                    '</a>';
                });

                html += '<a class="suggest-all" href="@Url.Action("Index", "Products")?search=' +
                    encodeURIComponent(term) + '">عرض كل النتائج <i class="fas fa-arrow-left ms-1"></i></a>';

                $box.html(html).removeClass("d-none");
                $input.attr("aria-expanded", "true");
            }

            function search(term) {
                if (request) { request.abort(); }
                request = $.get("@Url.Action("Suggest", "Products")", { term: term })
                    .done(function (items) { render(items, term); })
                    .fail(function (xhr, status) {
                        if (status !== "abort") { closeBox(); }
                    })
                    .always(function () { request = null; });
            }

            $input.on("input", function () {
                var term = $.trim($input.val());
                clearTimeout(timer);
                if (term.length < 2) { lastQuery = ""; closeBox(); return; }
                if (term === lastQuery) { return; }
                lastQuery = term;
                timer = setTimeout(function () { search(term); }, 250);
            });

            $input.on("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    var term = $.trim($input.val());
                    window.location.href = "@Url.Action("Index", "Products")?search=" + encodeURIComponent(term);
                } else if (e.key === "Escape") {
                    closeBox();
                }
            });

            $input.on("blur", function () { setTimeout(closeBox, 200); });
            $(document).on("click", function (e) {
                if (!$(e.target).closest(".navbar-search-wrap").length) { closeBox(); }
            });
        })();

        $(document).ready(function () {
            refreshCartCount();

            var $top = $("#backToTop");
            $(window).on("scroll", function () {
                $top.toggleClass("show", $(window).scrollTop() > 420);
            });
            $top.on("click", function () {
                $("html, body").animate({ scrollTop: 0 }, 280);
            });
        });
    </script>
    @await Html.PartialAsync("_ToastrNotifications")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>