@model ProductListViewModel
@using TechXpress.Services.Models

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h2 class="h5 fw-bold results-heading mb-0">
        <i class="fas fa-layer-group results-icon me-2"></i>
        النتائج
        <span class="badge results-count ms-1">@Model.TotalCount</span>
    </h2>
    <div class="results-sort small">
        <i class="fas fa-arrow-down-wide-short me-1"></i>@Model.SortLabel
    </div>
</div>

@if (!Model.Products.Any())
{
    <div class="card border-0 shadow-sm empty-state text-center">
        <div class="card-body py-5">
            <i class="fas fa-magnifying-glass-minus fa-3x empty-icon mb-3"></i>
            <h3 class="h5 fw-bold empty-title mb-2">لا توجد نتائج مطابقة</h3>
            <p class="empty-description mb-0">جرّب تغيير كلمة البحث أو توسيع نطاق الفئة والسعر.</p>
        </div>
    </div>
}
else
{
    <partial name="_ProductCardsPartial" model="Model.Products" />

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Pagination" class="mt-5">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i"
                           asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId"
                           asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                           asp-route-sort="@Model.Sort">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

<style>
    .results-heading {
        color: #0C223F !important;
    }

    .results-icon {
        color: #0C223F !important;
    }

    .results-count {
        background: #FAF7F2 !important;
        color: #0C223F !important;
        border: 1px solid #E3D9C9 !important;
        font-weight: 700 !important;
    }

    .results-sort {
        color: #64748b !important;
    }

    .empty-state {
        background: #FFFFFF !important;
        border: 1px solid #E3D9C9 !important;
        border-radius: 14px !important;
    }

    .empty-icon {
        color: #0C223F !important;
    }

    .empty-title {
        color: #0C223F !important;
    }

    .empty-description {
        color: #64748b !important;
    }
</style>