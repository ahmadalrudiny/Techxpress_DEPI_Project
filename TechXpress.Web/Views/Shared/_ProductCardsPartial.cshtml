
@model IEnumerable<ProductDto>
@using TechXpress.Services.Models
@{
    var path = Context.Request.Path.Value ?? "/Products";
    var returnUrl = path.Contains("SearchPartial", StringComparison.OrdinalIgnoreCase)
        ? Url.Action("Index", "Products")!
        : path + Context.Request.QueryString;
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<div class="featured-products">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (var p in Model)
        {
            <div class="col">
                <article class="card h-100 card-tech shadow-sm">
                    <div class="position-relative overflow-hidden card-img-wrapper">
                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" class="card-img-top card-tech-img" alt="@p.Name" loading="lazy" />
                        }
                        else
                        {
                            <div class="card-img-top card-tech-img d-flex align-items-center justify-content-center text-muted">
                                <i class="fas fa-box fa-3x"></i>
                            </div>
                        }

                        @if (p.StockQuantity <= 0)
                        {
                            <span class="position-absolute top-0 end-0 m-2 badge bg-danger shadow-sm">نفذ المخزون</span>
                        }

                        @if (isAuthenticated)
                        {
                            <form asp-area="" asp-controller="Wishlist" asp-action="Add" method="post"
                                  class="position-absolute top-0 start-0 m-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@p.Id" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="btn btn-sm rounded-circle shadow-sm wish-btn"
                                        title="أضف إلى المفضلة" aria-label="أضف @p.Name إلى المفضلة">
                                    <i class="far fa-heart text-danger"></i>
                                </button>
                            </form>
                        }
                    </div>

                    <div class="card-body d-flex flex-column p-3">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="card-cat">@p.CategoryName</span>

                            @if (!string.IsNullOrEmpty(p.VendorStoreName))
                            {
                                <span class="card-vendor" title="البائع">
                                    <i class="fas fa-store"></i> @p.VendorStoreName
                                </span>
                            }
                        </div>

                        <h3 class="h6 card-title text-truncate mb-1" title="@p.Name">@p.Name</h3>
                        <p class="card-text text-truncate small mb-0">@p.Description</p>

                        <div class="mt-auto pt-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="price-tag">$@p.Price.ToString("F2")</span>

                                @if (p.StockQuantity > 0)
                                {
                                    <span class="stock-note text-success">
                                        <i class="fas fa-circle-check"></i> متوفر
                                    </span>
                                }
                                else
                                {
                                    <span class="stock-note text-danger">
                                        <i class="fas fa-circle-xmark"></i> غير متوفر
                                    </span>
                                }
                            </div>

                            <div class="d-flex gap-2 card-tech-actions">
                                <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id"
                                   class="btn btn-outline-secondary btn-sm flex-fill">
                                    <i class="fas fa-eye me-1"></i>تفاصيل
                                </a>

                                @if (p.StockQuantity > 0)
                                {
                                    <button type="button" class="btn btn-warning btn-sm flex-fill fw-semibold"
                                            onclick="addToCart(@p.Id, 1, this)"
                                            aria-label="أضف @p.Name إلى السلة">
                                        <i class="fas fa-cart-plus me-1"></i>أضف
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-secondary btn-sm flex-fill" disabled>
                                        <i class="fas fa-ban me-1"></i>غير متوفر
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
</div>

<style>
    .featured-products .card-tech {
        background: #FFFFFF !important;
        border: 1px solid #E3D9C9 !important;
        border-radius: 14px !important;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(12, 34, 63, 0.03) !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease !important;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .featured-products .card-tech:hover {
        transform: translateY(-3px);
        border-color: #0C223F !important;
        box-shadow: 0 8px 20px rgba(12, 34, 63, 0.07) !important;
    }

    .featured-products .card-img-wrapper {
        background: #fbfbfb;
        overflow: hidden;
    }

    .featured-products .card-tech-img {
        height: 165px !important;
        object-fit: contain !important;
        padding: 10px !important;
        background: #fbfbfb;
        transition: transform 0.2s ease;
    }

    .featured-products .card-tech:hover .card-tech-img {
        transform: scale(1.03);
    }

    .featured-products .card-body {
        padding: 12px 14px !important;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .featured-products .card-cat,
    .featured-products .card-vendor {
        font-size: 11px !important;
        font-weight: 700 !important;
        padding: 3px 8px !important;
        border-radius: 6px !important;
        background: #FAF7F2 !important;
        color: #0C223F !important;
        border: 1px solid #E3D9C9 !important;
    }

    .featured-products .card-vendor i {
        color: #0C223F;
    }

    .featured-products .card-title {
        color: #0C223F !important;
        font-size: 14px !important;
        font-weight: 700 !important;
        line-height: 1.4 !important;
        margin-bottom: 6px !important;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 38px;
    }

    .featured-products .card-text {
        color: #64748b !important;
        font-size: 12px !important;
    }

    .featured-products .price-tag {
        color: #0C223F !important;
        font-size: 16px !important;
        font-weight: 800 !important;
    }

    .featured-products .stock-note {
        font-size: 11px;
        font-weight: 700;
    }

    .featured-products .badge {
        font-size: 11px !important;
        font-weight: 700 !important;
        padding: 3px 8px !important;
        border-radius: 6px !important;
    }

    .featured-products .badge.bg-danger {
        background: #fef2f2 !important;
        color: #b91c1c !important;
        border: 1px solid #fecaca !important;
    }

    .featured-products .wish-btn {
        width: 34px;
        height: 34px;
        background: #FFFFFF;
        border: 1px solid #E3D9C9;
        transition: all 0.2s ease;
    }

    .featured-products .wish-btn:hover {
        background: #FAF7F2;
        transform: scale(1.08);
    }

    .featured-products .card-tech-actions .btn-warning {
        background: #FAF7F2 !important;
        color: #0C223F !important;
        border: 1.5px solid #E3D9C9 !important;
        border-radius: 8px !important;
        padding: 6px 12px !important;
        font-weight: 700 !important;
        font-size: 12.5px !important;
        transition: all 0.2s ease !important;
    }

    .featured-products .card-tech-actions .btn-warning:hover {
        background: #0C223F !important;
        color: #FFFFFF !important;
        border-color: #0C223F !important;
    }

    .featured-products .card-tech-actions .btn-outline-secondary {
        background: transparent !important;
        border: 1.5px solid #E3D9C9 !important;
        color: #0C223F !important;
        border-radius: 8px !important;
        padding: 6px 12px !important;
        font-size: 12.5px !important;
        transition: all 0.2s ease !important;
    }

    .featured-products .card-tech-actions .btn-outline-secondary:hover {
        background: #0C223F !important;
        color: #FFFFFF !important;
        border-color: #0C223F !important;
    }

    .featured-products .card-tech-actions .btn-secondary {
        background: #f1f5f9 !important;
        color: #94a3b8 !important;
        border-color: #e2e8f0 !important;
        border-radius: 8px !important;
        padding: 6px 12px !important;
        font-size: 12.5px !important;
    }
</style>
