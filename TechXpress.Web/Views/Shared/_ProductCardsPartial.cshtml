@model IEnumerable<ProductDto>
@using TechXpress.Services.Models
@{
    // البحث الحي يعيد هذا الجزء عبر AJAX؛ في هذه الحالة نُرجِع المستخدم لصفحة المنتجات
    var path = Context.Request.Path.Value ?? "/Products";
    var returnUrl = path.Contains("SearchPartial", StringComparison.OrdinalIgnoreCase)
        ? Url.Action("Index", "Products")!
        : path + Context.Request.QueryString;
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
@foreach (var p in Model)
{
    <div class="col">
        <article class="card h-100 card-tech">
            <div class="position-relative overflow-hidden">
                @if (!string.IsNullOrEmpty(p.ImageUrl))
                {
                    <img src="@p.ImageUrl" class="card-img-top card-tech-img" alt="@p.Name" loading="lazy" />
                }
                else
                {
                    <div class="card-img-top card-tech-img d-flex align-items-center justify-content-center">
                        <i class="fas fa-box fa-3x"></i>
                    </div>
                }

                @if (p.StockQuantity <= 0)
                {
                    <span class="position-absolute top-0 end-0 m-2 badge bg-danger">نفذ المخزون</span>
                }

                @if (isAuthenticated)
                {
                    <form asp-area="" asp-controller="Wishlist" asp-action="Add" method="post"
                          class="position-absolute top-0 start-0 m-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@p.Id" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-sm btn-light rounded-circle shadow-sm wish-btn"
                                title="أضف إلى المفضلة" aria-label="أضف @p.Name إلى المفضلة">
                            <i class="far fa-heart text-danger"></i>
                        </button>
                    </form>
                }
            </div>

            <div class="card-body d-flex flex-column p-3">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="card-cat">@p.CategoryName</span>
                    @if (!string.IsNullOrEmpty(p.VendorStoreName))
                    {
                        <span class="card-vendor" title="البائع">
                            <i class="fas fa-store"></i>@p.VendorStoreName
                        </span>
                    }
                </div>

                <h3 class="h6 card-title text-truncate mb-1" title="@p.Name">@p.Name</h3>
                <p class="card-text text-truncate small mb-0">@p.Description</p>

                <div class="mt-auto pt-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="price-tag">$@p.Price.ToString("F2")</span>
                        @if (p.StockQuantity > 0)
                        {
                            <span class="stock-note text-success"><i class="fas fa-circle-check"></i> متوفر</span>
                        }
                        else
                        {
                            <span class="stock-note text-danger"><i class="fas fa-circle-xmark"></i> غير متوفر</span>
                        }
                    </div>
                    <div class="d-flex gap-2 card-tech-actions">
                        <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id"
                           class="btn btn-outline-secondary btn-sm flex-fill">
                            <i class="fas fa-eye me-1"></i>تفاصيل
                        </a>
                        @if (p.StockQuantity > 0)
                        {
                            <button type="button" class="btn btn-warning btn-sm flex-fill"
                                    onclick="addToCart(@p.Id, 1, this)"
                                    aria-label="أضف @p.Name إلى السلة">
                                <i class="fas fa-cart-plus me-1"></i>أضف
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-sm flex-fill" disabled>
                                <i class="fas fa-ban me-1"></i>غير متوفر
                            </button>
                        }
                    </div>
                </div>
            </div>
        </article>
    </div>
}
</div>
