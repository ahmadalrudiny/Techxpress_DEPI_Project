@model WishlistDto
@using TechXpress.Services.Models

@{
    ViewData["Title"] = "قائمة المفضلات - TechXpress";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --beige: #FAF7F2;
        --beige-hover: #EDE6DB;
        --cream: #FAF7F2;
        --navy: #0C223F;
        --navy-dark: #071528;
        --navy-light: #153359;
        --border: #E3D9C9;
        --white: #FFFFFF;
        --text-dark: #0C223F;
        --text-muted: #64748b;
        --gold: #f59e0b;
    }

    * {
        font-family: 'Cairo', "Segoe UI", sans-serif;
    }

    body {
        background-color: var(--cream);
        color: var(--navy);
    }

    .wishlist-section {
        background-color: var(--cream);
        min-height: 85vh;
        padding-top: 25px;
        padding-bottom: 50px;
    }

    /* Page Head - White Clean Card */
    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 22px 24px;
        box-shadow: 0 4px 16px rgba(12, 34, 63, 0.04);
        margin-bottom: 24px;
        gap: 16px;
        flex-wrap: wrap;
    }

    .page-head-main {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .page-head-icon {
        width: 55px;
        height: 55px;
        flex-shrink: 0;
        background: var(--beige);
        color: var(--navy);
        border: 1px solid var(--border);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .page-head-text h1 {
        color: var(--navy);
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .page-head-text p {
        color: var(--text-muted);
        font-size: 13.5px;
        margin-bottom: 0;
    }

    .page-head-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .wishlist-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--beige) !important;
        color: var(--navy) !important;
        border: 1px solid var(--border) !important;
        border-radius: 50px;
        padding: 7px 14px;
        font-size: 12.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* Card & White Header */
    .wishlist-card {
        background: var(--white);
        border: 1px solid var(--border) !important;
        border-radius: 16px !important;
        box-shadow: 0 4px 16px rgba(12, 34, 63, 0.04) !important;
        overflow: hidden;
    }

    .wishlist-card-header {
        background: var(--white) !important;
        border-bottom: 1px solid var(--border) !important;
        padding: 18px 24px !important;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .wishlist-card-header h2 {
        color: var(--navy) !important;
        font-size: 17px;
        font-weight: 800;
        margin-bottom: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-icon-badge {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: var(--beige);
        border: 1px solid var(--border);
        color: var(--navy);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    /* Table Styles */
    .wishlist-table {
        color: var(--navy);
        --bs-table-color: var(--navy);
        --bs-table-hover-color: var(--navy);
        --bs-table-hover-bg: var(--beige);
        --bs-table-border-color: var(--border);
        margin-bottom: 0;
    }

    .wishlist-table thead th {
        background: var(--beige) !important;
        color: var(--navy) !important;
        font-size: 12.5px;
        font-weight: 800;
        padding: 15px 14px;
        border-bottom: 1.5px solid var(--border);
        white-space: nowrap;
    }

    .wishlist-table tbody td {
        padding: 15px 14px;
        border-bottom: 1px solid rgba(227, 217, 201, 0.45);
        vertical-align: middle;
        color: var(--navy);
    }

    .wishlist-table tbody tr:hover {
        background-color: var(--beige) !important;
    }

    .wishlist-table tbody tr.unavailable-row {
        background: rgba(248, 247, 245, 0.8);
    }

    .product-image {
        width: 58px;
        height: 58px;
        object-fit: contain;
        border-radius: 10px;
        border: 1.5px solid var(--border);
        background: var(--white);
        padding: 3px;
        transition: transform 0.2s ease;
    }

    .product-image:hover {
        transform: scale(1.05);
    }

    .product-placeholder {
        width: 58px;
        height: 58px;
        background: var(--beige);
        border: 1.5px solid var(--border);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--navy);
        font-size: 20px;
    }

    .product-name {
        color: var(--navy);
        font-weight: 800;
        font-size: 14px;
        text-decoration: none;
        display: block;
        transition: color 0.2s ease;
    }

    .product-name:hover {
        color: var(--navy-light);
    }

    .category-name {
        color: var(--text-muted);
        font-size: 12px;
        display: inline-block;
        margin-top: 3px;
    }

    .product-price {
        color: var(--navy);
        font-size: 15px;
        font-weight: 800;
        white-space: nowrap;
    }

    /* Badges */
    .availability-badge {
        display: inline-block;
        font-size: 11.5px;
        font-weight: 700;
        padding: 5px 10px;
        border-radius: 6px;
        white-space: nowrap;
    }

    .available {
        background: #ecfdf5 !important;
        color: #15803d !important;
        border: 1px solid #bbf7d0;
    }

    .unavailable {
        background: #fef2f2 !important;
        color: #b91c1c !important;
        border: 1px solid #fecaca;
    }

    .date-added {
        color: var(--text-muted);
        font-size: 12.5px;
        white-space: nowrap;
    }

    /* Buttons */
    .btn-theme-primary {
        background: var(--beige) !important;
        border: 1.5px solid var(--border) !important;
        color: var(--navy) !important;
        border-radius: 9px !important;
        padding: 8px 16px;
        font-weight: 700;
        font-size: 12.5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .btn-theme-primary:hover {
        background: var(--navy) !important;
        border-color: var(--navy) !important;
        color: var(--white) !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(12, 34, 63, 0.12);
    }

    .btn-theme-outline {
        background: var(--white) !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 9px !important;
        padding: 8px 18px;
        font-weight: 700;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-theme-outline:hover {
        background: var(--navy) !important;
        border-color: var(--navy) !important;
        color: var(--white) !important;
    }

    .btn-remove {
        width: 35px;
        height: 35px;
        border-radius: 8px;
        border: 1px solid #fecaca;
        background: #fef2f2;
        color: #dc2626;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .btn-remove:hover {
        background: #dc2626;
        color: var(--white);
        border-color: #dc2626;
    }

    .btn-unavailable {
        background: #f1f5f9 !important;
        color: #94a3b8 !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 12px;
        font-weight: 700;
    }

    .continue-shopping {
        margin-top: 24px;
    }

    /* Empty State */
    .empty-state {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 60px 24px;
        text-align: center;
        box-shadow: 0 4px 16px rgba(12, 34, 63, 0.04);
    }

    .empty-state-icon {
        width: 72px;
        height: 72px;
        background: var(--beige);
        color: var(--navy);
        border: 1px solid var(--border);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 18px;
    }

    .empty-state h2 {
        color: var(--navy);
        font-weight: 800;
        font-size: 20px;
        margin-bottom: 8px;
    }

    .empty-state p {
        color: var(--text-muted);
        font-size: 14px;
        margin-bottom: 22px;
    }

    @@media (max-width: 768px) {
        .page-head {
            padding: 16px;
        }

        .page-head-text h1 {
            font-size: 20px;
        }

        .page-head-actions {
            width: 100%;
        }

        .wishlist-table thead th,
        .wishlist-table tbody td {
            padding: 12px 10px;
        }

        .product-image,
        .product-placeholder {
            width: 50px;
            height: 50px;
        }
    }
</style>

<section class="wishlist-section">
    <div class="container">

        <!-- Page Header -->
        <div class="page-head">
            <div class="page-head-main">
                <div class="page-head-icon">
                    <i class="fas fa-heart"></i>
                </div>

                <div class="page-head-text">
                    <h1>قائمة المفضلات</h1>
                    <p>المنتجات التي حفظتها للرجوع إليها لاحقاً والشراء في أي وقت</p>
                </div>
            </div>

            <div class="page-head-actions">
                @if (!Model.IsEmpty)
                {
                    <span class="wishlist-count">
                        <i class="fas fa-heart text-danger ms-1"></i>
                        @Model.TotalCount منتج محفوظ
                    </span>
                }

                <a asp-action="Index"
                   asp-controller="Products"
                   class="btn-theme-outline">
                    <i class="fas fa-arrow-right ms-1"></i>
                    متابعة التسوق
                </a>
            </div>
        </div>

        @if (Model.IsEmpty)
        {
            <div class="empty-state my-4">
                <div class="empty-state-icon">
                    <i class="far fa-heart"></i>
                </div>

                <h2>قائمة المفضلات فارغة</h2>

                <p>
                    تصفّح المنتجات واضغط على أيقونة القلب لحفظ ما يعجبك بسهولة.
                </p>

                <a asp-action="Index"
                   asp-controller="Products"
                   class="btn-theme-primary px-4 py-2">
                    <i class="fas fa-box-open ms-1"></i>
                    تصفح المنتجات الآن
                </a>
            </div>
        }
        else
        {
            <div class="wishlist-card">
                <div class="wishlist-card-header">
                    <h2>
                        <span class="card-icon-badge"><i class="fas fa-heart"></i></span>
                        المنتجات المحفوظة
                    </h2>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle wishlist-table">
                        <thead>
                            <tr>
                                <th style="width:85px;">المنتج</th>
                                <th>التفاصيل</th>
                                <th class="text-center">السعر</th>
                                <th class="text-center">التوفر</th>
                                <th class="text-center">تاريخ الإضافة</th>
                                <th class="text-end">الإجراءات</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr class="@(item.IsAvailable ? "" : "unavailable-row")">
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.ProductName"
                                                 class="product-image" />
                                        }
                                        else
                                        {
                                            <div class="product-placeholder">
                                                <i class="fas fa-box"></i>
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <a asp-action="Details"
                                           asp-controller="Products"
                                           asp-route-id="@item.ProductId"
                                           class="product-name">
                                            @item.ProductName
                                        </a>

                                        <small class="category-name">
                                            @item.CategoryName
                                        </small>
                                    </td>

                                    <td class="text-center">
                                        <span class="product-price">
                                            $@item.Price.ToString("N2")
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        @if (!item.IsAvailable)
                                        {
                                            <span class="availability-badge unavailable">
                                                غير متوفر
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="availability-badge available">
                                                متوفر (@item.StockQuantity)
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <span class="date-added">
                                            @item.DateAdded.ToString("yyyy/MM/dd")
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2 align-items-center">
                                            @if (item.IsAvailable)
                                            {
                                                <form asp-action="AddToCart" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="productId"
                                                           value="@item.ProductId" />

                                                    <button type="submit"
                                                            class="btn-theme-primary"
                                                            title="أضف إلى السلة">
                                                        <i class="fas fa-cart-plus ms-1"></i>
                                                        أضف للسلة
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn-unavailable"
                                                        disabled>
                                                    <i class="fas fa-cart-arrow-down ms-1"></i>
                                                    غير متاح
                                                </button>
                                            }

                                            <form asp-action="Remove"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('هل تريد إزالة هذا المنتج من المفضلة؟');">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="wishlistItemId"
                                                       value="@item.WishlistItemId" />

                                                <button type="submit"
                                                        class="btn-remove"
                                                        title="إزالة من المفضلة">
                                                    <i class="fas fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="continue-shopping">
                <a asp-action="Index"
                   asp-controller="Products"
                   class="btn-theme-outline">
                    <i class="fas fa-arrow-right ms-1"></i>
                    مواصلة التسوق
                </a>
            </div>
        }

    </div>
</section>