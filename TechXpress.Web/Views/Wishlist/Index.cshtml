@model WishlistDto
@using TechXpress.Services.Models
@{
    ViewData["Title"] = "قائمة المفضلات - TechXpress";
}

<section class="pb-5">
    <div class="container">
        <div class="page-head mb-4">
            <div class="page-head-icon" style="background: linear-gradient(135deg, #fb7185, #e11d48); color: #fff;">
                <i class="fas fa-heart"></i>
            </div>
            <div class="page-head-text">
                <h1>قائمة المفضلات</h1>
                <p>المنتجات التي حفظتها للرجوع إليها لاحقاً</p>
            </div>
            <div class="page-head-actions">
                @if (!Model.IsEmpty)
                {
                    <span class="chip chip-gold"><i class="fas fa-heart"></i> @Model.TotalCount منتج محفوظ</span>
                }
                <a asp-action="Index" asp-controller="Products" class="btn btn-outline-warning btn-sm fw-bold">
                    <i class="fas fa-box me-1"></i>تصفح المنتجات
                </a>
            </div>
        </div>

        @if (Model.IsEmpty)
        {
            <div class="empty-state text-center py-5">
                <i class="far fa-heart fa-4x mb-4"></i>
                <h2 class="h3 fw-bold mb-2">قائمة المفضلات فارغة</h2>
                <p class="mb-4">تصفّح المنتجات واضغط على أيقونة القلب لحفظ ما يعجبك.</p>
                <a asp-action="Index" asp-controller="Products" class="btn btn-warning btn-lg px-5 fw-bold shadow-sm">
                    <i class="fas fa-box me-2"></i>تصفح المنتجات
                </a>
            </div>
        }
        else
        {
            <div class="card border-secondary shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-dark text-white">
                                <tr>
                                    <th style="width:90px;">المنتج</th>
                                    <th>التفاصيل</th>
                                    <th class="text-center">السعر</th>
                                    <th class="text-center">التوفر</th>
                                    <th class="text-center">تاريخ الإضافة</th>
                                    <th class="text-end">الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr class="@(item.IsAvailable ? "" : "table-secondary text-muted")">
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.ProductName" class="rounded shadow-sm"
                                                     style="width:60px;height:60px;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light d-flex align-items-center justify-content-center text-muted rounded border"
                                                     style="width:60px;height:60px;">
                                                    <i class="fas fa-box"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="Details" asp-controller="Products" asp-route-id="@item.ProductId"
                                               class="fw-bold text-dark d-block">@item.ProductName</a>
                                            <small class="text-muted">@item.CategoryName</small>
                                        </td>
                                        <td class="text-center fw-semibold">$@item.Price.ToString("F2")</td>
                                        <td class="text-center">
                                            @if (!item.IsAvailable)
                                            {
                                                <span class="badge bg-danger">غير متوفر</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">متوفر (@item.StockQuantity)</span>
                                            }
                                        </td>
                                        <td class="text-center text-muted small">@item.DateAdded.ToString("yyyy/MM/dd")</td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2">
                                                @if (item.IsAvailable)
                                                {
                                                    <form asp-action="AddToCart" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                                        <button type="submit" class="btn btn-sm btn-warning fw-bold" title="أضف إلى السلة">
                                                            <i class="fas fa-cart-plus"></i> أضف للسلة
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-secondary" disabled>
                                                        <i class="fas fa-cart-x"></i> غير متاح
                                                    </button>
                                                }

                                                <form asp-action="Remove" method="post" class="d-inline"
                                                      onsubmit="return confirm('هل تريد إزالة هذا المنتج من المفضلة؟');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="wishlistItemId" value="@item.WishlistItemId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="إزالة">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Index" asp-controller="Products" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>مواصلة التسوق
                </a>
            </div>
        }
    </div>
</section>
