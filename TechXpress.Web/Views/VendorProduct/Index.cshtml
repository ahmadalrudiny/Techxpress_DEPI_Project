@model VendorProductListViewModel
@using TechXpress.Services.Models
@{
    ViewData["Title"] = "منتجاتي - TechXpress";
}

<partial name="_VendorNav" />

<section class="pb-5">
    <div class="container">
        <div class="page-head mb-4">
            <div class="page-head-icon"><i class="fas fa-box-open"></i></div>
            <div class="page-head-text">
                <h1>منتجاتي</h1>
                <p>إدارة المنتجات المعروضة في متجرك — @Model.TotalCount منتج</p>
            </div>
            <div class="page-head-actions">
                <a asp-action="Create" class="btn btn-warning fw-bold px-4">
                    <i class="fas fa-plus me-1"></i>إضافة منتج جديد
                </a>
                <a asp-action="Index" asp-controller="VendorOrder" class="btn btn-outline-info fw-bold px-4">
                    <i class="fas fa-truck-fast me-1"></i>طلبات متجري
                </a>
            </div>
        </div>

        @if (!Model.Products.Any())
        {
            <div class="empty-state text-center py-5">
                <i class="fas fa-box fa-4x mb-3"></i>
                <h2 class="h4 fw-bold mb-1">لا توجد منتجات بعد</h2>
                <p class="mb-4">ابدأ البيع الآن بإضافة أول منتج إلى متجرك.</p>
                <a asp-action="Create" class="btn btn-warning fw-bold px-4">
                    <i class="fas fa-plus me-1"></i>إضافة منتج جديد
                </a>
            </div>
        }
        else
        {
            <div class="card border-secondary shadow-sm mb-4">
                <div class="card-header bg-dark border-secondary py-3">
                    <h2 class="h5 fw-bold text-white mb-0">
                        <i class="fas fa-list me-2"></i>قائمة منتجاتك (@Model.TotalCount منتج)
                    </h2>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-secondary text-white">
                                <tr>
                                    <th style="width:80px;">الصورة</th>
                                    <th>المنتج</th>
                                    <th>الفئة</th>
                                    <th class="text-center">السعر</th>
                                    <th class="text-center">المخزون</th>
                                    <th class="text-center">الحالة</th>
                                    <th class="text-end">الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Products)
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                                            {
                                                <img src="@p.ImageUrl" class="rounded shadow-sm" alt="@p.Name"
                                                     style="width:50px;height:50px;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light d-flex align-items-center justify-content-center text-muted rounded border"
                                                     style="width:50px;height:50px;">
                                                    <i class="fas fa-box"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <span class="fw-bold text-dark d-block">@p.Name</span>
                                            <small class="text-muted text-truncate d-inline-block" style="max-width:260px;">
                                                @p.Description
                                            </small>
                                        </td>
                                        <td><span class="badge bg-info text-dark">@p.CategoryName</span></td>
                                        <td class="text-center"><span class="price-tag">$@p.Price.ToString("F2")</span></td>
                                        <td class="text-center">
                                            <span class="fw-semibold @(p.StockQuantity > 0 ? "text-success" : "text-danger")">
                                                @p.StockQuantity
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(p.IsActive ? "bg-success" : "bg-danger")">
                                                @(p.IsActive ? "مفعّل" : "معطّل")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2">
                                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning">
                                                    <i class="fas fa-pen"></i> تعديل
                                                </a>
                                                <form asp-action="Deactivate" asp-route-id="@p.Id" method="post" class="d-inline"
                                                      onsubmit="return confirm('هل أنت متأكد من تغيير حالة هذا المنتج؟');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                        <i class="fas @(p.IsActive ? "fa-ban" : "fa-check")"></i>
                                                        @(p.IsActive ? "تعطيل" : "تفعيل")
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Pagination" class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
</section>
