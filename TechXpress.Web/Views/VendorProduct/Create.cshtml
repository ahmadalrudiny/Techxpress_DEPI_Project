@model ProductCreateViewModel
@using TechXpress.Services.Models
@{
    ViewData["Title"] = "إضافة منتج - TechXpress";
}

<partial name="_VendorNav" />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --beige: #FAF7F2;
        --beige-hover: #EDE6DB;
        --cream: #FAF7F2;
        --navy: #0C223F;
        --navy-dark: #071528;
        --navy-light: #153359;
        --border: #E3D9C9;
        --white: #FFFFFF;
        --text-dark: #0C223F;
        --text-muted: #64748b;
        --gold: #f59e0b;
    }

    * {
        font-family: 'Cairo', "Segoe UI", sans-serif;
    }

    body {
        background-color: var(--cream);
        color: var(--navy);
    }

    .vendor-create-product {
        background: var(--cream);
        min-height: 100vh;
        padding-top: 25px;
        padding-bottom: 50px;
    }

    /* Page Head - White Clean Card */
    .page-head {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        padding: 22px 24px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(12, 34, 63, 0.04);
        margin-bottom: 24px;
    }

    .page-head-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--beige);
        border: 1px solid var(--border);
        color: var(--navy);
        font-size: 23px;
        flex-shrink: 0;
    }

    .page-head-text {
        flex: 1;
        min-width: 200px;
    }

    .page-head-text h1 {
        color: var(--navy);
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .page-head-text p {
        color: var(--text-muted);
        font-size: 13px;
        margin-bottom: 0;
    }

    .page-head-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Cards - White Clean Style */
    .card {
        background: var(--white);
        border: 1px solid var(--border) !important;
        border-radius: 16px !important;
        box-shadow: 0 4px 16px rgba(12, 34, 63, 0.04) !important;
        overflow: hidden;
        transition: box-shadow .2s ease;
    }

    .card:hover {
        box-shadow: 0 8px 24px rgba(12, 34, 63, 0.07) !important;
    }

    /* Card Header - White with Beige Icon Badge */
    .card-header {
        background: var(--white) !important;
        border-bottom: 1px solid var(--border) !important;
        padding: 18px 24px !important;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .card-header h2 {
        color: var(--navy) !important;
        font-size: 17px;
        font-weight: 800;
        margin-bottom: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-icon-badge {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: var(--beige);
        border: 1px solid var(--border);
        color: var(--navy);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .card-body {
        padding: 26px !important;
        color: var(--navy);
    }

    /* Form Controls */
    .form-label {
        color: var(--navy);
        font-size: 13.5px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        background-color: var(--white);
        border: 1.5px solid var(--border);
        border-radius: 10px;
        color: var(--navy);
        font-size: 13.5px;
        padding: 11px 14px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-control::placeholder {
        color: #94a3b8;
    }

    .form-control:focus,
    .form-select:focus {
        background-color: var(--white);
        border-color: var(--navy);
        color: var(--navy);
        box-shadow: 0 0 0 3px rgba(12, 34, 63, 0.08);
    }

    .form-control[type="file"] {
        padding: 9px 12px;
    }

    .form-control[type="file"]::file-selector-button {
        background: var(--beige);
        color: var(--navy);
        border: 1px solid var(--border);
        border-radius: 7px;
        padding: 6px 14px;
        margin-inline-end: 12px;
        font-weight: 700;
        font-size: 12.5px;
        transition: background 0.2s ease;
    }

    .form-control[type="file"]::file-selector-button:hover {
        background: var(--beige-hover);
        color: var(--navy);
    }

    .form-text {
        color: var(--text-muted) !important;
        font-size: 12px;
        line-height: 1.7;
    }

    .text-danger {
        color: #dc2626 !important;
        font-size: 12.5px;
    }

    /* Buttons */
    .btn {
        border-radius: 9px;
        font-weight: 700;
        font-size: 13px;
        transition: all 0.2s ease;
    }

    .btn-warning {
        background: var(--beige) !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        padding: 9px 22px;
    }

    .btn-warning:hover {
        background: var(--navy) !important;
        color: var(--white) !important;
        border-color: var(--navy) !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(12, 34, 63, 0.12);
    }

    .btn-outline-warning,
    .btn-outline-secondary {
        background: var(--white) !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        padding: 8px 18px;
    }

    .btn-outline-warning:hover,
    .btn-outline-secondary:hover {
        background: var(--navy) !important;
        color: var(--white) !important;
        border-color: var(--navy) !important;
    }

    /* Tips List Styling */
    .tips-list {
        padding: 0;
        margin: 0;
    }

    .tips-list li {
        color: var(--text-muted);
        line-height: 1.8;
        font-size: 13px;
        padding: 11px 0;
        border-bottom: 1px solid rgba(227, 217, 201, 0.45);
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .tips-list li:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .tips-icon {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #ecfdf5;
        color: #15803d;
        border: 1px solid #bbf7d0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    @@media (max-width: 767px) {
        .page-head {
            padding: 16px;
        }

        .page-head-text h1 {
            font-size: 20px;
        }

        .page-head-actions {
            width: 100%;
        }

        .page-head-actions .btn {
            width: 100%;
            text-align: center;
        }

        .card-body {
            padding: 18px !important;
        }
    }
</style>

<section class="vendor-create-product">
    <div class="container">
        <!-- Page Header -->
        <div class="page-head">
            <div class="page-head-icon">
                <i class="fas fa-plus"></i>
            </div>

            <div class="page-head-text">
                <h1>إضافة منتج جديد</h1>
                <p>أضف منتجاً جديداً إلى متجرك وسيظهر للعملاء مباشرة فور الحفظ.</p>
            </div>

            <div class="page-head-actions">
                <a asp-action="Index" class="btn btn-outline-warning btn-sm">
                    <i class="fas fa-arrow-right ms-1"></i>العودة لمنتجاتي
                </a>
            </div>
        </div>

        <div class="row g-4">
            <!-- Form Column -->
            <div class="col-lg-8">
                <div class="card h-100">
                    <div class="card-header">
                        <h2>
                            <span class="card-icon-badge"><i class="fas fa-box-archive"></i></span>
                            بيانات المنتج
                        </h2>
                    </div>

                    <div class="card-body">
                        <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">اسم المنتج</label>
                                <input asp-for="Name" class="form-control" placeholder="مثال: لاب توب Dell XPS 15" />
                                <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">الوصف</label>
                                <textarea asp-for="Description" class="form-control" rows="4"
                                          placeholder="اكتب وصفاً مختصراً للمنتج ومواصفاته الفنية..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Price" class="form-label">السعر (بالدولار)</label>
                                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                                    <span asp-validation-for="Price" class="text-danger small d-block mt-1"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="StockQuantity" class="form-label">الكمية في المخزون</label>
                                    <input asp-for="StockQuantity" class="form-control" type="number" min="0" placeholder="0" />
                                    <span asp-validation-for="StockQuantity" class="text-danger small d-block mt-1"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CategoryId" class="form-label">الفئة</label>
                                <select asp-for="CategoryId" class="form-select"
                                        asp-items="@(new SelectList(Model.Categories, nameof(CategoryDto.Id), nameof(CategoryDto.Name)))">
                                    <option value="">— اختر الفئة —</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="mb-4">
                                <label class="form-label">صورة المنتج</label>
                                <input asp-for="Image" class="form-control" type="file" accept="image/*" />
                                <span class="form-text text-muted d-block mt-2">
                                    <i class="fas fa-circle-info ms-1"></i>الصيغ المدعومة: JPG, JPEG, PNG, GIF, WEBP (بحد أقصى 5 ميجابايت)
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-3 pt-2">
                                <button type="submit" class="btn btn-warning px-4">
                                    <i class="fas fa-save ms-1"></i>حفظ المنتج
                                </button>

                                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                    إلغاء
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Tips Column -->
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h2>
                            <span class="card-icon-badge"><i class="fas fa-lightbulb"></i></span>
                            نصائح سريعة
                        </h2>
                    </div>

                    <div class="card-body">
                        <ul class="tips-list">
                            <li>
                                <span class="tips-icon"><i class="fas fa-check"></i></span>
                                <span>اختر اسماً واضحاً ومحدداً يتضمن الماركة والموديل.</span>
                            </li>
                            <li>
                                <span class="tips-icon"><i class="fas fa-check"></i></span>
                                <span>اكتب وصفاً تفصيلياً بالمواصفات لزيادة ثقة العملاء والمبيعات.</span>
                            </li>
                            <li>
                                <span class="tips-icon"><i class="fas fa-check"></i></span>
                                <span>تأكد من تحديد السعر بدقة ومراجعة الكمية المتوفرة.</span>
                            </li>
                            <li>
                                <span class="tips-icon"><i class="fas fa-check"></i></span>
                                <span>استخدم صورة واضحة ذات جودة عالية وبخلفية نقية.</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}