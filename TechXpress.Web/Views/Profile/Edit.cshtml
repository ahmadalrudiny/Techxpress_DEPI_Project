@model EditProfileViewModel
@using TechXpress.Web.Models
@{
    ViewData["Title"] = "تعديل الملف الشخصي - TechXpress";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --cream: #FAF7F2;
        --beige: #FAF7F2;
        --beige-hover: #ede6db;
        --navy: #0C223F;
        --navy-light: #173860;
        --border: #E3D9C9;
        --white: #FFFFFF;
        --text-dark: #0C223F;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Cairo', "Segoe UI", sans-serif;
    }

    .edit-profile-section {
        background-color: var(--cream);
        min-height: 85vh;
        padding-top: 30px;
        padding-bottom: 60px;
    }

    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 18px 24px;
        box-shadow: 0 4px 16px rgba(12, 34, 63, 0.04);
        margin-bottom: 28px;
    }

    .page-head-start {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .page-head-icon {
        width: 48px;
        height: 48px;
        background: var(--navy);
        color: var(--beige);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .page-head-text h1 {
        color: var(--navy);
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 2px;
    }

    .page-head-text p {
        color: var(--text-muted);
        font-size: 13.5px;
        margin-bottom: 0;
    }

    .profile-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 6px 20px rgba(12, 34, 63, 0.04);
        overflow: hidden;
    }

    .profile-card-header {
        background: var(--navy);
        color: var(--white);
        padding: 16px 22px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .profile-card-header h2 {
        color: var(--white);
        font-size: 16px;
        font-weight: 800;
        margin: 0;
    }

    .profile-card-header i {
        color: var(--beige);
    }

    .profile-card-body {
        padding: 26px 24px;
    }

    .form-label-theme {
        color: var(--navy);
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 8px;
        display: block;
    }

    .form-control-theme {
        background: #FFFFFF !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 10px !important;
        padding: 11px 16px;
        font-size: 14.5px;
        color: var(--navy) !important;
        transition: all 0.2s ease;
    }

    .form-control-theme:focus {
        border-color: var(--navy) !important;
        box-shadow: 0 0 0 3.5px rgba(12, 34, 63, 0.1) !important;
        outline: none;
    }

    .form-control-theme[readonly] {
        background-color: #f8fafc !important;
        color: #64748b !important;
        cursor: not-allowed;
        border-color: #e2e8f0 !important;
    }

    .btn-theme-primary {
        background: var(--beige) !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 10px !important;
        padding: 13px 24px;
        font-weight: 800;
        font-size: 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.25s ease;
        box-shadow: 0 4px 14px rgba(12, 34, 63, 0.06);
        cursor: pointer;
    }

    .btn-theme-primary:hover {
        background: var(--navy) !important;
        color: var(--white) !important;
        border-color: var(--navy) !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(12, 34, 63, 0.12);
    }

    .btn-theme-outline {
        background: transparent !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 10px !important;
        padding: 10px 20px;
        font-weight: 700;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .btn-theme-outline:hover {
        background: var(--beige) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
    }

    .custom-validation-summary ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .custom-validation-summary:not(:empty) {
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 13.5px;
        font-weight: 600;
    }
</style>

<section class="edit-profile-section">
    <div class="container">
        <div class="page-head">
            <div class="page-head-start">
                <div class="page-head-icon"><i class="fas fa-user-pen"></i></div>
                <div class="page-head-text">
                    <h1>تعديل الملف الشخصي</h1>
                    <p>حدّث بياناتك وعنوان الشحن الخاص بك</p>
                </div>
            </div>
            <div class="page-head-actions">
                <a asp-action="Index" class="btn-theme-outline">
                    <i class="fas fa-arrow-right ms-1"></i>ملفي الشخصي
                </a>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="profile-card">
                    <div class="profile-card-header">
                        <i class="fas fa-user-gear"></i>
                        <h2>بيانات الحساب</h2>
                    </div>
                    <div class="profile-card-body">
                        <form asp-action="Edit" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="All" class="custom-validation-summary mb-3"></div>

                            <div class="mb-4">
                                <label class="form-label-theme" asp-for="FullName">الاسم بالكامل</label>
                                <input asp-for="FullName" class="form-control form-control-theme" required />
                                <span asp-validation-for="FullName" class="text-danger small mt-1 d-block fw-semibold"></span>
                            </div>

                            <div class="mb-4">
                                <label class="form-label-theme" asp-for="Email">البريد الإلكتروني</label>
                                <input asp-for="Email" class="form-control form-control-theme" type="email" required readonly />
                                <span asp-validation-for="Email" class="text-danger small mt-1 d-block fw-semibold"></span>
                            </div>

                            <div class="mb-4">
                                <label class="form-label-theme" asp-for="Address">العنوان</label>
                                <input asp-for="Address" class="form-control form-control-theme" />
                                <span asp-validation-for="Address" class="text-danger small mt-1 d-block fw-semibold"></span>
                            </div>

                            <div class="mb-4">
                                <label class="form-label-theme" asp-for="PhoneNumber">رقم الهاتف</label>
                                <input asp-for="PhoneNumber" class="form-control form-control-theme" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block fw-semibold"></span>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-7">
                                    <label class="form-label-theme" asp-for="City">المدينة</label>
                                    <input asp-for="City" class="form-control form-control-theme" />
                                    <span asp-validation-for="City" class="text-danger small mt-1 d-block fw-semibold"></span>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label-theme" asp-for="PostalCode">الرمز البريدي</label>
                                    <input asp-for="PostalCode" class="form-control form-control-theme" />
                                    <span asp-validation-for="PostalCode" class="text-danger small mt-1 d-block fw-semibold"></span>
                                </div>
                            </div>

                            <div class="d-grid gap-2 mt-4 pt-2">
                                <button type="submit" class="btn-theme-primary">
                                    <i class="fas fa-floppy-disk ms-1"></i>حفظ التغييرات
                                </button>
                                <a asp-action="Index" class="btn-theme-outline">
                                    إلغاء
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}