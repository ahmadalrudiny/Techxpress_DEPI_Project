@model OrderDto
@using TechXpress.Services.Models
@using TechXpress.Data.Entities
@{
    ViewData["Title"] = $"تفاصيل الطلب #{Model.Id} - TechXpress";
    var subtotal = Model.OrderDetails.Sum(d => d.UnitPrice * d.Quantity);
    var canCancel = Model.Status == OrderStatus.Pending || Model.Status == OrderStatus.Paid;
    var canReturn = Model.Status == OrderStatus.Delivered;

    string ShipText(ShippingStatus s) => s switch
    {
        ShippingStatus.Pending => "بانتظار الشحن",
        ShippingStatus.Preparing => "قيد التجهيز",
        ShippingStatus.Shipped => "تم الشحن",
        ShippingStatus.Delivered => "تم التوصيل",
        _ => s.ToString()
    };

    string ShipBadgeClass(ShippingStatus s) => s switch
    {
        ShippingStatus.Pending => "badge-ship-pending",
        ShippingStatus.Preparing => "badge-ship-preparing",
        ShippingStatus.Shipped => "badge-ship-shipped",
        ShippingStatus.Delivered => "badge-ship-delivered",
        _ => "badge-ship-default"
    };
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --cream: #FAF7F2;
        --beige: #FAF7F2;
        --beige-hover: #ede6db;
        --navy: #0C223F;
        --navy-light: #173860;
        --border: #E3D9C9;
        --white: #FFFFFF;
        --text-dark: #0C223F;
        --text-muted: #64748b;
        --gold: #f59e0b;
    }

    * {
        font-family: 'Cairo', "Segoe UI", sans-serif;
    }

    .order-details-section {
        background-color: var(--cream);
        min-height: 85vh;
        padding-top: 30px;
        padding-bottom: 60px;
    }

    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 18px 24px;
        box-shadow: 0 4px 16px rgba(12, 34, 63, 0.04);
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-head-start {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .page-head-icon {
        width: 48px;
        height: 48px;
        background: var(--navy);
        color: var(--beige);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .page-head-text h1 {
        color: var(--navy);
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 2px;
    }

    .page-head-text p {
        color: var(--text-muted);
        font-size: 13.5px;
        margin-bottom: 0;
    }

    .page-head-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .status-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 50rem;
    }

    .status-pending {
        background: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
    }

    .status-paid {
        background: #ecfdf5;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .status-shipped {
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
    }

    .status-delivered {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #86efac;
    }

    .status-cancelled {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .status-returned {
        background: #f5f3ff;
        color: #6d28d9;
        border: 1px solid #ddd6fe;
    }

    .pending-alert-box {
        background: #fffbeb;
        border: 1px solid #fef3c7;
        border-radius: 16px;
        padding: 20px 24px;
        box-shadow: 0 4px 14px rgba(245, 158, 11, 0.08);
    }

    .order-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 6px 20px rgba(12, 34, 63, 0.04);
        overflow: hidden;
    }

    .order-card-header {
        background: var(--navy);
        color: var(--white);
        padding: 16px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .order-card-header h2 {
        color: var(--white);
        font-size: 16px;
        font-weight: 800;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .order-card-header i {
        color: var(--beige);
    }

    .order-card-body {
        padding: 24px;
    }

    .order-meta-item {
        border-bottom: 1px solid rgba(227, 217, 201, 0.5);
        padding-bottom: 14px;
        margin-bottom: 14px;
    }

    .order-meta-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
        margin-bottom: 0;
    }

    .order-meta-label {
        color: var(--text-muted);
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .order-meta-val {
        color: var(--navy);
        font-size: 14.5px;
        font-weight: 700;
        margin: 0;
    }

    .items-table {
        margin-bottom: 0;
    }

    .items-table thead th {
        background: #f8fafc;
        color: var(--navy);
        font-weight: 800;
        font-size: 13.5px;
        border-bottom: 1.5px solid var(--border);
        padding: 14px 18px;
    }

    .items-table tbody td {
        padding: 16px 18px;
        border-bottom: 1px solid var(--border);
        color: var(--navy);
        font-size: 14px;
        vertical-align: middle;
    }

    .items-table tbody tr:last-child td {
        border-bottom: none;
    }

    .order-card-footer {
        background: var(--beige);
        border-top: 1.5px solid var(--border);
        padding: 20px 24px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .summary-label {
        color: var(--text-muted);
        font-weight: 600;
    }

    .summary-val {
        color: var(--navy);
        font-weight: 700;
    }

    .summary-total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid var(--border);
        padding-top: 12px;
        margin-top: 10px;
    }

    .total-label {
        color: var(--navy);
        font-size: 16px;
        font-weight: 800;
    }

    .total-val {
        color: var(--navy);
        font-size: 22px;
        font-weight: 800;
    }

    .badge-ship-pending {
        background: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
        font-size: 11.5px;
        font-weight: 700;
        border-radius: 6px;
        padding: 4px 9px;
    }

    .badge-ship-preparing {
        background: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
        font-size: 11.5px;
        font-weight: 700;
        border-radius: 6px;
        padding: 4px 9px;
    }

    .badge-ship-shipped {
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
        font-size: 11.5px;
        font-weight: 700;
        border-radius: 6px;
        padding: 4px 9px;
    }

    .badge-ship-delivered {
        background: #ecfdf5;
        color: #15803d;
        border: 1px solid #bbf7d0;
        font-size: 11.5px;
        font-weight: 700;
        border-radius: 6px;
        padding: 4px 9px;
    }

    .badge-ship-default {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
        font-size: 11.5px;
        font-weight: 700;
        border-radius: 6px;
        padding: 4px 9px;
    }

    .btn-theme-primary {
        background: var(--beige) !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 10px !important;
        padding: 10px 22px;
        font-weight: 800;
        font-size: 14.5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.25s ease;
        box-shadow: 0 4px 14px rgba(12, 34, 63, 0.06);
        cursor: pointer;
    }

    .btn-theme-primary:hover {
        background: var(--navy) !important;
        color: var(--white) !important;
        border-color: var(--navy) !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(12, 34, 63, 0.12);
    }

    .btn-theme-outline {
        background: transparent !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 10px !important;
        padding: 9px 20px;
        font-weight: 700;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .btn-theme-outline:hover {
        background: var(--beige) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
    }

    .btn-theme-danger {
        background: #fef2f2 !important;
        color: #b91c1c !important;
        border: 1.5px solid #fecaca !important;
        border-radius: 10px !important;
        padding: 9px 20px;
        font-weight: 700;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .btn-theme-danger:hover {
        background: #fee2e2 !important;
        border-color: #fca5a5 !important;
        color: #991b1b !important;
    }
</style>

<section class="order-details-section">
    <div class="container">
        <div class="page-head">
            <div class="page-head-start">
                <div class="page-head-icon"><i class="fas fa-receipt"></i></div>
                <div class="page-head-text">
                    <h1>تفاصيل الطلب #@Model.Id</h1>
                    <p>@Model.OrderDate.ToString("yyyy/MM/dd HH:mm")</p>
                </div>
            </div>
            <div class="page-head-actions">
                @switch (Model.Status)
                {
                    case OrderStatus.Pending:
                        <span class="status-chip status-pending"><i class="fas fa-hourglass-half"></i> بانتظار الدفع</span>
                        break;
                    case OrderStatus.Paid:
                        <span class="status-chip status-paid"><i class="fas fa-credit-card"></i> تم الدفع</span>
                        break;
                    case OrderStatus.Shipped:
                        <span class="status-chip status-shipped"><i class="fas fa-truck-fast"></i> تم الشحن</span>
                        break;
                    case OrderStatus.Delivered:
                        <span class="status-chip status-delivered"><i class="fas fa-circle-check"></i> تم التوصيل</span>
                        break;
                    case OrderStatus.Cancelled:
                        <span class="status-chip status-cancelled"><i class="fas fa-circle-xmark"></i> ملغي</span>
                        break;
                    case OrderStatus.Returned:
                        <span class="status-chip status-returned"><i class="fas fa-rotate-left"></i> مُرتجع</span>
                        break;
                }
                <a asp-action="Orders" class="btn-theme-outline">
                    <i class="fas fa-arrow-right ms-1"></i>طلباتي
                </a>
            </div>
        </div>

        @if (Model.Status == OrderStatus.Pending)
        {
            <div class="pending-alert-box d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
                <div class="d-flex align-items-start gap-3">
                    <i class="fas fa-circle-exclamation fa-2x" style="color: #d97706;"></i>
                    <div>
                        <strong class="d-block" style="color: #92400e; font-size: 15px;">لم يكتمل دفع هذا الطلب بعد.</strong>
                        <span style="color: #78350f; font-size: 13.5px;">
                            طلبك محفوظ ويمكنك إتمام الدفع الآن في أي وقت. إذا لم ترغب في إكماله، يمكنك إلغاؤه وسيتم استرجاع الكميات إلى المخزون.
                        </span>
                    </div>
                </div>
                <a asp-area="" asp-controller="Checkout" asp-action="Payment" asp-route-orderId="@Model.Id"
                   class="btn-theme-primary text-nowrap">
                    <i class="fas fa-credit-card ms-1"></i>ادفع الآن ($@Model.TotalAmount.ToString("F2"))
                </a>
            </div>
        }

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="order-card">
                    <div class="order-card-header">
                        <h2><i class="fas fa-circle-info"></i>معلومات الطلب</h2>
                    </div>
                    <div class="order-card-body">
                        <div class="order-meta-item">
                            <p class="order-meta-label">رقم الطلب</p>
                            <p class="order-meta-val">#@Model.Id</p>
                        </div>
                        <div class="order-meta-item">
                            <p class="order-meta-label">تاريخ الطلب</p>
                            <p class="order-meta-val">@Model.OrderDate.ToString("yyyy/MM/dd HH:mm")</p>
                        </div>
                        <div class="order-meta-item">
                            <p class="order-meta-label">حالة الطلب</p>
                            <div class="mt-1">
                                @switch (Model.Status)
                                {
                                    case OrderStatus.Pending:
                                        <span class="status-chip status-pending">بانتظار الدفع</span>
                                        break;
                                    case OrderStatus.Paid:
                                        <span class="status-chip status-paid">تم الدفع</span>
                                        break;
                                    case OrderStatus.Shipped:
                                        <span class="status-chip status-shipped">تم الشحن</span>
                                        break;
                                    case OrderStatus.Delivered:
                                        <span class="status-chip status-delivered">تم التوصيل</span>
                                        break;
                                    case OrderStatus.Cancelled:
                                        <span class="status-chip status-cancelled">ملغي</span>
                                        break;
                                    case OrderStatus.Returned:
                                        <span class="status-chip status-returned">مُرتجع</span>
                                        break;
                                }
                            </div>
                        </div>
                        <div class="order-meta-item">
                            <p class="order-meta-label">طريقة الدفع</p>
                            <p class="order-meta-val" style="color: var(--navy);">
                                @if (Model.PaymentIntentId == "STORE_CREDIT")
                                {
                                    <text><i class="fas fa-coins ms-1" style="color: #15803d;"></i> رصيد النقاط</text>
                                }
                                else if (!string.IsNullOrEmpty(Model.PaymentIntentId))
                                {
                                    <text><i class="fas fa-credit-card ms-1" style="color: #15803d;"></i> Stripe Checkout</text>
                                }
                                else
                                {
                                    <text><span class="text-muted">لم يتم الدفع بعد</span></text>
                                }
                            </p>
                        </div>
                        <div class="order-meta-item">
                            <p class="order-meta-label">عنوان الشحن</p>
                            <p class="order-meta-val">@Model.ShippingAddress</p>
                        </div>
                        <div class="order-meta-item">
                            <p class="order-meta-label">كود الخصم</p>
                            <p class="order-meta-val">@(string.IsNullOrEmpty(Model.PromoCode) ? "لم يتم استخدام كود خصم" : Model.PromoCode)</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="order-card">
                    <div class="order-card-header">
                        <h2><i class="fas fa-boxes-stacked"></i>عناصر الطلب</h2>
                        <span class="badge" style="background: rgba(250,247,242,0.15); color: var(--white); font-weight: 700;">
                            @Model.OrderDetails.Count() عنصر
                        </span>
                    </div>
                    <div class="p-0 table-responsive">
                        <table class="table items-table align-middle">
                            <thead>
                                <tr>
                                    <th>المنتج</th>
                                    <th class="text-center">الكمية</th>
                                    <th class="text-end">السعر للوحدة</th>
                                    <th class="text-end">المجموع</th>
                                    <th class="text-center">حالة الشحن</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in Model.OrderDetails)
                                {
                                    <tr>
                                        <td>
                                            <h3 class="h6 fw-bold mb-1" style="color: var(--navy);">@detail.ProductName</h3>
                                            <small class="text-muted">@detail.VendorStoreName</small>
                                        </td>
                                        <td class="text-center fw-bold">@detail.Quantity</td>
                                        <td class="text-end text-muted">$@detail.UnitPrice.ToString("F2")</td>
                                        <td class="text-end fw-bold" style="color: var(--navy);">$@((detail.UnitPrice * detail.Quantity).ToString("F2"))</td>
                                        <td class="text-center">
                                            <span class="@ShipBadgeClass(detail.ShippingStatus)">@ShipText(detail.ShippingStatus)</span>
                                            @if (!string.IsNullOrWhiteSpace(detail.Carrier))
                                            {
                                                <small class="d-block text-muted mt-1">@detail.Carrier</small>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(detail.TrackingNumber))
                                            {
                                                <small class="d-block text-muted" dir="ltr">@detail.TrackingNumber</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="order-card-footer">
                        <div class="summary-row">
                            <span class="summary-label">المجموع الفرعي</span>
                            <span class="summary-val">$@subtotal.ToString("F2")</span>
                        </div>
                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="summary-row">
                                <span class="summary-label">الخصم</span>
                                <span class="summary-val" style="color: #15803d;">- $@Model.DiscountAmount.ToString("F2")</span>
                            </div>
                        }
                        @if (Model.StoreCreditUsed > 0)
                        {
                            <div class="summary-row">
                                <span class="summary-label">رصيد النقاط المستخدم</span>
                                <span class="summary-val" style="color: #15803d;">- $@Model.StoreCreditUsed.ToString("F2")</span>
                            </div>
                        }
                        <div class="summary-total-row">
                            <span class="total-label">@(Model.StoreCreditUsed > 0 ? "المدفوع نقدًا" : "المجموع الكلي المدفوع")</span>
                            <span class="total-val">$@Model.TotalAmount.ToString("F2")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-4 pt-2">
            <a asp-action="Orders" class="btn-theme-outline">
                <i class="fas fa-arrow-right ms-1"></i>العودة إلى الطلبات
            </a>
            @if (canCancel)
            {
                <form asp-action="CancelOrder" asp-route-id="@Model.Id" method="post" class="d-inline"
                      onsubmit="return confirm('هل أنت متأكد من إلغاء هذا الطلب؟ سيتم استرجاع الكميات إلى المخزون، وإذا كان مدفوعًا ستُضاف قيمته إلى رصيد نقاطك.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-theme-danger ms-2">
                        <i class="fas fa-circle-xmark ms-1"></i>إلغاء الطلب
                    </button>
                </form>
            }
            @if (canReturn)
            {
                <form asp-action="ReturnOrder" asp-route-id="@Model.Id" method="post" class="d-inline"
                      onsubmit="return confirm('هل تريد إرجاع هذا الطلب؟ سيتم استرداد قيمته كاملة كنقاط في رصيدك لاستخدامها في مشترياتك القادمة.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-theme-primary ms-2">
                        <i class="fas fa-rotate-left ms-1"></i>إرجاع الطلب واسترداد النقاط
                    </button>
                </form>
            }
        </div>
    </div>
</section>