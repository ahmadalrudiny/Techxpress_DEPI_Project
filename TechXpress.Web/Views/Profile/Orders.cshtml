@model IEnumerable<OrderDto>
@using TechXpress.Services.Models
@{
    ViewData["Title"] = "طلباتي - TechXpress";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --cream: #FAF7F2;
        --beige: #FAF7F2;
        --beige-hover: #ede6db;
        --navy: #0C223F;
        --navy-light: #173860;
        --border: #E3D9C9;
        --white: #FFFFFF;
        --text-dark: #0C223F;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Cairo', "Segoe UI", sans-serif;
    }

    .orders-page-section {
        background-color: var(--cream);
        min-height: 85vh;
        padding-top: 30px;
        padding-bottom: 60px;
    }

    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 18px 24px;
        box-shadow: 0 4px 16px rgba(12, 34, 63, 0.04);
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-head-start {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .page-head-icon {
        width: 48px;
        height: 48px;
        background: var(--navy);
        color: var(--beige);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .page-head-text h1 {
        color: var(--navy);
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 2px;
    }

    .page-head-text p {
        color: var(--text-muted);
        font-size: 13.5px;
        margin-bottom: 0;
    }

    .page-head-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .empty-orders-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 55px 24px;
        text-align: center;
        box-shadow: 0 6px 20px rgba(12, 34, 63, 0.04);
        max-width: 600px;
        margin: 0 auto;
    }

    .empty-orders-icon {
        width: 80px;
        height: 80px;
        background: var(--beige);
        color: var(--navy);
        border: 1px solid var(--border);
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        margin-bottom: 20px;
    }

    .empty-orders-title {
        color: var(--navy);
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .empty-orders-desc {
        color: var(--text-muted);
        font-size: 14.5px;
        margin-bottom: 24px;
    }

    .orders-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 6px 20px rgba(12, 34, 63, 0.04);
        overflow: hidden;
    }

    .orders-table {
        margin-bottom: 0;
    }

    .orders-table thead th {
        background: #f8fafc;
        color: var(--navy);
        font-weight: 800;
        font-size: 13.5px;
        border-bottom: 1.5px solid var(--border);
        padding: 15px 18px;
    }

    .orders-table tbody td {
        padding: 16px 18px;
        border-bottom: 1px solid var(--border);
        color: var(--navy);
        font-size: 14px;
        vertical-align: middle;
    }

    .orders-table tbody tr:last-child td {
        border-bottom: none;
    }

    .badge-status-pending {
        background: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
        font-size: 11.5px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .badge-status-paid {
        background: #ecfdf5;
        color: #15803d;
        border: 1px solid #bbf7d0;
        font-size: 11.5px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .badge-status-shipped {
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
        font-size: 11.5px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .badge-status-delivered {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #86efac;
        font-size: 11.5px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .badge-status-cancelled {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        font-size: 11.5px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .badge-status-returned {
        background: #f5f3ff;
        color: #6d28d9;
        border: 1px solid #ddd6fe;
        font-size: 11.5px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .btn-table-action {
        background: transparent;
        color: var(--navy);
        border: 1.5px solid var(--border);
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 12.5px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.2s ease;
    }

    .btn-table-action:hover {
        background: var(--beige);
        border-color: var(--navy);
        color: var(--navy);
    }

    .btn-table-pay {
        background: var(--beige);
        color: var(--navy);
        border: 1.5px solid var(--border);
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 12.5px;
        font-weight: 800;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.2s ease;
    }

    .btn-table-pay:hover {
        background: var(--navy);
        color: var(--white);
        border-color: var(--navy);
    }

    .btn-table-cancel {
        background: #fef2f2;
        color: #b91c1c;
        border: 1.5px solid #fecaca;
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 12.5px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .btn-table-cancel:hover {
        background: #fee2e2;
        border-color: #fca5a5;
    }

    .btn-theme-primary {
        background: var(--beige) !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 10px !important;
        padding: 8px 18px;
        font-weight: 800;
        font-size: 13.5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.25s ease;
        box-shadow: 0 4px 12px rgba(12, 34, 63, 0.06);
    }

    .btn-theme-primary:hover {
        background: var(--navy) !important;
        color: var(--white) !important;
        border-color: var(--navy) !important;
        transform: translateY(-2px);
    }

    .btn-theme-outline {
        background: transparent !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 10px !important;
        padding: 8px 18px;
        font-weight: 700;
        font-size: 13.5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-theme-outline:hover {
        background: var(--beige) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
    }
</style>

<section class="orders-page-section">
    <div class="container">
        <div class="page-head">
            <div class="page-head-start">
                <div class="page-head-icon"><i class="fas fa-bag-shopping"></i></div>
                <div class="page-head-text">
                    <h1>سجل طلباتي</h1>
                    <p>تابع حالة طلباتك وتفاصيل كل عملية شراء</p>
                </div>
            </div>
            <div class="page-head-actions">
                <a asp-action="Index" class="btn-theme-outline">
                    <i class="fas fa-user ms-1"></i>ملفي الشخصي
                </a>
                <a asp-action="Index" asp-controller="Products" class="btn-theme-primary">
                    <i class="fas fa-box ms-1"></i>تصفح المنتجات
                </a>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-orders-card">
                <div class="empty-orders-icon">
                    <i class="fas fa-bag-shopping"></i>
                </div>
                <h2 class="empty-orders-title">لا توجد طلبات بعد</h2>
                <p class="empty-orders-desc">لم تقم بإجراء أي طلبات حتى الآن. ابدأ التسوق وتصفح تشكيلتنا المميزة من الأجهزة الإلكترونية.</p>
                <a asp-action="Index" asp-controller="Products" class="btn-theme-primary px-4 py-2">
                    <i class="fas fa-box ms-1"></i>ابدأ التسوق الآن
                </a>
            </div>
        }
        else
        {
            <div class="orders-card">
                <div class="table-responsive">
                    <table class="table orders-table align-middle">
                        <thead>
                            <tr>
                                <th>رقم الطلب</th>
                                <th>التاريخ</th>
                                <th>المبلغ</th>
                                <th>الحالة</th>
                                <th class="text-start">تفاصيل</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td><span class="fw-bold" style="color: var(--navy);">#@order.Id</span></td>
                                    <td><span class="text-muted small">@order.OrderDate.ToString("yyyy/MM/dd")</span></td>
                                    <td><span class="fw-bold" style="color: var(--navy); font-size: 15px;">$@((order.TotalAmount + order.StoreCreditUsed).ToString("F2"))</span></td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case TechXpress.Data.Entities.OrderStatus.Pending:
                                                <span class="badge-status-pending"><i class="fas fa-hourglass-half"></i>بانتظار الدفع</span>
                                                break;
                                            case TechXpress.Data.Entities.OrderStatus.Paid:
                                                <span class="badge-status-paid"><i class="fas fa-credit-card"></i>تم الدفع</span>
                                                break;
                                            case TechXpress.Data.Entities.OrderStatus.Shipped:
                                                <span class="badge-status-shipped"><i class="fas fa-truck-fast"></i>تم الشحن</span>
                                                break;
                                            case TechXpress.Data.Entities.OrderStatus.Delivered:
                                                <span class="badge-status-delivered"><i class="fas fa-circle-check"></i>تم التوصيل</span>
                                                break;
                                            case TechXpress.Data.Entities.OrderStatus.Cancelled:
                                                <span class="badge-status-cancelled"><i class="fas fa-circle-xmark"></i>ملغي</span>
                                                break;
                                            case TechXpress.Data.Entities.OrderStatus.Returned:
                                                <span class="badge-status-returned"><i class="fas fa-rotate-left"></i>مُرتجع</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-nowrap text-start">
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn-table-action">
                                                <i class="fas fa-eye ms-1"></i>عرض
                                            </a>
                                            @if (order.Status == TechXpress.Data.Entities.OrderStatus.Pending)
                                            {
                                                <a asp-area="" asp-controller="Checkout" asp-action="Payment" asp-route-orderId="@order.Id"
                                                   class="btn-table-pay"
                                                   title="إتمام دفع الطلب #@order.Id">
                                                    <i class="fas fa-credit-card ms-1"></i>ادفع الآن
                                                </a>
                                            }
                                            @if (order.Status == TechXpress.Data.Entities.OrderStatus.Pending ||
                                                 order.Status == TechXpress.Data.Entities.OrderStatus.Paid)
                                            {
                                                <form asp-action="CancelOrder" asp-route-id="@order.Id" method="post" class="d-inline"
                                                      onsubmit="return confirm('هل أنت متأكد من إلغاء هذا الطلب؟ سيتم استرجاع الكميات إلى المخزون، وإذا كان مدفوعًا ستُضاف قيمته إلى رصيد نقاطك.');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn-table-cancel">
                                                        <i class="fas fa-circle-xmark ms-1"></i>إلغاء
                                                    </button>
                                                </form>
                                            }
                                            @if (order.Status == TechXpress.Data.Entities.OrderStatus.Delivered)
                                            {
                                                <form asp-action="ReturnOrder" asp-route-id="@order.Id" method="post" class="d-inline"
                                                      onsubmit="return confirm('هل تريد إرجاع هذا الطلب؟ سيتم استرداد قيمته كاملة كنقاط في رصيدك لاستخدامها في مشترياتك القادمة.');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn-table-action">
                                                        <i class="fas fa-rotate-left ms-1"></i>إرجاع
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>