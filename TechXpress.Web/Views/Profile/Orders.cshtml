@model IEnumerable<OrderDto>
@using TechXpress.Services.Models
@{
    ViewData["Title"] = "طلباتي - TechXpress";
}

<section class="pb-5">
    <div class="container">
        <div class="page-head mb-4">
            <div class="page-head-icon"><i class="fas fa-shopping-bag"></i></div>
            <div class="page-head-text">
                <h1>سجل طلباتي</h1>
                <p>تابع حالة طلباتك وتفاصيل كل عملية شراء</p>
            </div>
            <div class="page-head-actions">
                <a asp-action="Index" class="btn btn-outline-warning btn-sm fw-bold">
                    <i class="fas fa-user me-1"></i>ملفي الشخصي
                </a>
                <a asp-action="Index" asp-controller="Products" class="btn btn-warning btn-sm fw-bold">
                    <i class="fas fa-box me-1"></i>تصفح المنتجات
                </a>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state text-center py-5">
                <i class="fas fa-shopping-bag fa-4x mb-4"></i>
                <h2 class="h3 fw-bold mb-2">لا توجد طلبات بعد</h2>
                <p class="mb-4">لم تقم بإجراء أي طلبات حتى الآن.</p>
                <a asp-action="Index" asp-controller="Products" class="btn btn-warning btn-lg px-5 fw-bold shadow-sm">
                    <i class="fas fa-box me-2"></i>ابدأ التسوق
                </a>
            </div>
        }
        else
        {
            <div class="card border-secondary shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-dark text-white">
                                <tr>
                                    <th>رقم الطلب</th>
                                    <th>التاريخ</th>
                                    <th>المبلغ</th>
                                    <th>الحالة</th>
                                    <th>تفاصيل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model)
                                {
                                    <tr>
                                        <td><span class="fw-bold">#@order.Id</span></td>
                                        <td><span class="text-muted small">@order.OrderDate.ToString("yyyy/MM/dd")</span></td>
                                        <td><span class="fw-bold">$@order.TotalAmount.ToString("F2")</span></td>                                        <td>
                                            @switch (order.Status)
                                            {
                                                case TechXpress.Data.Entities.OrderStatus.Pending:
                                                    <span class="badge bg-warning text-dark">بانتظار الدفع</span>
                                                    break;
                                                case TechXpress.Data.Entities.OrderStatus.Paid:
                                                    <span class="badge bg-primary">تم الدفع</span>
                                                    break;
                                                case TechXpress.Data.Entities.OrderStatus.Shipped:
                                                    <span class="badge bg-info text-dark">تم الشحن</span>
                                                    break;
                                                case TechXpress.Data.Entities.OrderStatus.Delivered:
                                                    <span class="badge bg-success">تم التوصيل</span>
                                                    break;
                                                case TechXpress.Data.Entities.OrderStatus.Cancelled:
                                                    <span class="badge bg-danger">ملغي</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-nowrap">
                                            <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-warning">
                                                <i class="fas fa-eye"></i> عرض
                                            </a>
                                            @if (order.Status == TechXpress.Data.Entities.OrderStatus.Pending)
                                            {
                                                <a asp-area="" asp-controller="Checkout" asp-action="Payment" asp-route-orderId="@order.Id"
                                                   class="btn btn-sm btn-warning fw-bold"
                                                   title="إتمام دفع الطلب #@order.Id">
                                                    <i class="fas fa-credit-card"></i> ادفع الآن
                                                </a>
                                            }
                                            @if (order.Status == TechXpress.Data.Entities.OrderStatus.Pending ||
                                                 order.Status == TechXpress.Data.Entities.OrderStatus.Paid)
                                            {
                                                <form asp-action="CancelOrder" asp-route-id="@order.Id" method="post" class="d-inline"
                                                      onsubmit="return confirm('هل أنت متأكد من إلغاء هذا الطلب؟ سيتم استرجاع الكميات إلى المخزون.');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="fas fa-times"></i> إلغاء
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
