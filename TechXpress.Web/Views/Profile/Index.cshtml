@model ProfileViewModel
@using TechXpress.Web.Models
@{
    ViewData["Title"] = "ملفي الشخصي - TechXpress";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --cream: #FAF7F2;
        --beige: #FAF7F2;
        --beige-hover: #ede6db;
        --navy: #0C223F;
        --navy-light: #173860;
        --border: #E3D9C9;
        --white: #FFFFFF;
        --text-dark: #0C223F;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Cairo', "Segoe UI", sans-serif;
    }

    .profile-page-section {
        background-color: var(--cream);
        min-height: 85vh;
        padding-top: 30px;
        padding-bottom: 60px;
    }

    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 18px 24px;
        box-shadow: 0 4px 16px rgba(12, 34, 63, 0.04);
        margin-bottom: 28px;
    }

    .page-head-start {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .page-head-icon {
        width: 48px;
        height: 48px;
        background: var(--navy);
        color: var(--beige);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .page-head-text h1 {
        color: var(--navy);
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 2px;
    }

    .page-head-text p {
        color: var(--text-muted);
        font-size: 13.5px;
        margin-bottom: 0;
    }

    .page-head-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .user-info-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 28px 20px;
        text-align: center;
        box-shadow: 0 6px 20px rgba(12, 34, 63, 0.04);
        margin-bottom: 20px;
    }

    .user-avatar-badge {
        width: 86px;
        height: 86px;
        background: var(--beige);
        color: var(--navy);
        border: 2px solid var(--border);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
        margin-bottom: 14px;
        box-shadow: 0 4px 14px rgba(12, 34, 63, 0.06);
    }

    .user-name {
        color: var(--navy);
        font-size: 18px;
        font-weight: 800;
        margin-bottom: 4px;
    }

    .user-email {
        color: var(--text-muted);
        font-size: 13px;
        margin-bottom: 12px;
    }

    .badge-role {
        background: var(--beige);
        color: var(--navy);
        border: 1px solid var(--border);
        font-size: 12px;
        font-weight: 700;
        padding: 5px 14px;
        border-radius: 50rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .badge-role-admin {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        font-size: 12px;
        font-weight: 700;
        padding: 5px 14px;
        border-radius: 50rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .user-city {
        color: var(--text-muted);
        font-size: 13px;
        margin-top: 10px;
        margin-bottom: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .credit-balance-card {
        background: linear-gradient(135deg, #0C223F 0%, #173860 100%);
        color: var(--white);
        border-radius: 18px;
        padding: 22px;
        margin-bottom: 20px;
        box-shadow: 0 8px 24px rgba(12, 34, 63, 0.18);
    }

    .credit-balance-label {
        font-size: 13px;
        opacity: .85;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .credit-balance-value {
        font-size: 30px;
        font-weight: 800;
        margin-bottom: 4px;
    }

    .credit-balance-note {
        font-size: 12px;
        opacity: .75;
        margin-bottom: 14px;
        line-height: 1.7;
    }

    .credit-balance-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.25);
        color: var(--white);
        text-decoration: none;
        border-radius: 9px;
        padding: 7px 14px;
        font-size: 12.5px;
        font-weight: 700;
        transition: all .2s ease;
    }

    .credit-balance-link:hover {
        background: var(--beige);
        color: var(--navy);
    }

    .user-nav-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 6px 20px rgba(12, 34, 63, 0.04);
        overflow: hidden;
    }

    .user-nav-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        color: var(--navy);
        text-decoration: none;
        font-size: 14.5px;
        font-weight: 700;
        border-bottom: 1px solid var(--border);
        transition: all 0.2s ease;
    }

    .user-nav-item:last-child {
        border-bottom: none;
    }

    .user-nav-item:hover {
        background: var(--beige);
        color: var(--navy);
        padding-right: 24px;
    }

    .user-nav-start {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-nav-icon {
        width: 36px;
        height: 36px;
        background: var(--beige);
        color: var(--navy);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
    }

    .user-nav-item:hover .user-nav-icon {
        background: var(--navy);
        color: var(--white);
    }

    .actions-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 6px 20px rgba(12, 34, 63, 0.04);
        overflow: hidden;
    }

    .actions-card-header {
        background: var(--navy);
        color: var(--white);
        padding: 16px 22px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .actions-card-header h2 {
        color: var(--white);
        font-size: 16px;
        font-weight: 800;
        margin: 0;
    }

    .actions-card-header i {
        color: var(--beige);
    }

    .actions-card-body {
        padding: 24px;
    }

    .action-tile-btn {
        background: var(--white);
        border: 1.5px solid var(--border);
        border-radius: 14px;
        padding: 22px 18px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: var(--navy);
        transition: all 0.25s ease;
        height: 100%;
        box-shadow: 0 4px 12px rgba(12, 34, 63, 0.03);
    }

    .action-tile-btn:hover {
        background: var(--beige);
        border-color: var(--navy);
        color: var(--navy);
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(12, 34, 63, 0.08);
    }

    .action-tile-icon {
        width: 52px;
        height: 52px;
        background: var(--beige);
        color: var(--navy);
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-bottom: 12px;
        transition: all 0.2s ease;
    }

    .action-tile-btn:hover .action-tile-icon {
        background: var(--navy);
        color: var(--white);
        transform: scale(1.06);
    }

    .action-tile-title {
        font-size: 14.5px;
        font-weight: 800;
        margin: 0;
    }

    .btn-theme-primary {
        background: var(--beige) !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 10px !important;
        padding: 8px 18px;
        font-weight: 800;
        font-size: 13.5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.25s ease;
        box-shadow: 0 4px 12px rgba(12, 34, 63, 0.06);
    }

    .btn-theme-primary:hover {
        background: var(--navy) !important;
        color: var(--white) !important;
        border-color: var(--navy) !important;
        transform: translateY(-2px);
    }

    .btn-theme-outline {
        background: transparent !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 10px !important;
        padding: 8px 18px;
        font-weight: 700;
        font-size: 13.5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-theme-outline:hover {
        background: var(--beige) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
    }
</style>

<section class="profile-page-section">
    <div class="container">
        <div class="page-head">
            <div class="page-head-start">
                <div class="page-head-icon"><i class="fas fa-user"></i></div>
                <div class="page-head-text">
                    <h1>ملفي الشخصي</h1>
                    <p>بياناتك، طلباتك وإعدادات الأمان في مكان واحد</p>
                </div>
            </div>
            <div class="page-head-actions">
                <a asp-action="Orders" class="btn-theme-primary">
                    <i class="fas fa-bag-shopping ms-1"></i>طلباتي
                </a>
                <a asp-action="ChangePassword" class="btn-theme-outline">
                    <i class="fas fa-key ms-1"></i>كلمة المرور
                </a>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="user-info-card">
                    <div class="user-avatar-badge">
                        <i class="fas fa-circle-user"></i>
                    </div>
                    <h2 class="user-name">@Model.FullName</h2>
                    <p class="user-email">@Model.Email</p>

                    @if (User.IsInRole("Admin"))
                    {
                        <span class="badge-role-admin">
                            <i class="fas fa-shield-halved"></i>مدير النظام
                        </span>
                    }
                    else if (User.IsInRole("Vendor"))
                    {
                        <span class="badge-role">
                            <i class="fas fa-store"></i>بائع معتمد
                        </span>
                    }
                    else
                    {
                        <span class="badge-role">
                            <i class="fas fa-user-check"></i>عميل
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.City))
                    {
                        <p class="user-city">
                            <i class="fas fa-location-dot"></i>@Model.City
                        </p>
                    }
                </div>

                <div class="credit-balance-card">
                    <div class="credit-balance-label"><i class="fas fa-coins"></i> رصيد النقاط المتاح</div>
                    <div class="credit-balance-value">$@Model.StoreCreditBalance.ToString("F2")</div>
                    <div class="credit-balance-note">
                        تُضاف النقاط تلقائيًا عند إلغاء أو إرجاع طلب مدفوع، ويمكنك استخدامها في أي عملية شراء داخل الموقع.
                    </div>
                    <a asp-action="Credit" class="credit-balance-link">
                        <i class="fas fa-clock-rotate-left"></i> سجل حركات الرصيد
                    </a>
                </div>

                <div class="user-nav-card">
                    <a asp-action="Edit" class="user-nav-item">
                        <div class="user-nav-start">
                            <div class="user-nav-icon"><i class="fas fa-user-pen"></i></div>
                            <span>تعديل الملف الشخصي</span>
                        </div>
                        <i class="fas fa-chevron-left text-muted" style="font-size: 13px;"></i>
                    </a>
                    <a asp-action="ChangePassword" class="user-nav-item">
                        <div class="user-nav-start">
                            <div class="user-nav-icon"><i class="fas fa-key"></i></div>
                            <span>تغيير كلمة المرور</span>
                        </div>
                        <i class="fas fa-chevron-left text-muted" style="font-size: 13px;"></i>
                    </a>
                    <a asp-action="Orders" class="user-nav-item">
                        <div class="user-nav-start">
                            <div class="user-nav-icon"><i class="fas fa-bag-shopping"></i></div>
                            <span>طلباتي</span>
                        </div>
                        <i class="fas fa-chevron-left text-muted" style="font-size: 13px;"></i>
                    </a>
                    <a asp-action="Credit" class="user-nav-item">
                        <div class="user-nav-start">
                            <div class="user-nav-icon"><i class="fas fa-coins"></i></div>
                            <span>رصيد النقاط</span>
                        </div>
                        <i class="fas fa-chevron-left text-muted" style="font-size: 13px;"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="actions-card">
                    <div class="actions-card-header">
                        <i class="fas fa-rocket"></i>
                        <h2>إجراءات سريعة</h2>
                    </div>
                    <div class="actions-card-body">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <a asp-action="Edit" class="action-tile-btn">
                                    <div class="action-tile-icon">
                                        <i class="fas fa-user-pen"></i>
                                    </div>
                                    <span class="action-tile-title">تعديل الملف</span>
                                </a>
                            </div>
                            <div class="col-sm-6">
                                <a asp-action="ChangePassword" class="action-tile-btn">
                                    <div class="action-tile-icon">
                                        <i class="fas fa-key"></i>
                                    </div>
                                    <span class="action-tile-title">تغيير كلمة المرور</span>
                                </a>
                            </div>
                            <div class="col-sm-6">
                                <a asp-action="Orders" class="action-tile-btn">
                                    <div class="action-tile-icon">
                                        <i class="fas fa-clock-rotate-left"></i>
                                    </div>
                                    <span class="action-tile-title">سجل طلباتي</span>
                                </a>
                            </div>
                            <div class="col-sm-6">
                                <a asp-action="Credit" class="action-tile-btn">
                                    <div class="action-tile-icon">
                                        <i class="fas fa-coins"></i>
                                    </div>
                                    <span class="action-tile-title">رصيد النقاط</span>
                                </a>
                            </div>
                            <div class="col-sm-6">
                                <a asp-action="Index" asp-controller="Home" class="action-tile-btn">
                                    <div class="action-tile-icon">
                                        <i class="fas fa-house"></i>
                                    </div>
                                    <span class="action-tile-title">الرئيسية</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>