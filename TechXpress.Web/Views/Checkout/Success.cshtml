@{
    ViewData["Title"] = "نجاح الدفع - TechXpress";
    int? orderId = ViewData["OrderId"] as int?;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --beige: #FAF7F2;
        --beige-hover: #ede6db;
        --cream: #FAF7F2;
        --navy: #0C223F;
        --border: #E3D9C9;
        --white: #FFFFFF;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Cairo', "Segoe UI", sans-serif;
    }

    .success-section {
        background-color: var(--cream);
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 15px;
    }

    .success-card {
        background: var(--white) !important;
        border: 1px solid var(--border) !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 30px -5px rgba(12, 34, 63, 0.06) !important;
        padding: 45px 35px !important;
        max-width: 520px;
        width: 100%;
        margin: 0 auto;
    }

    .success-icon-badge {
        width: 70px;
        height: 70px;
        background: #f0fdf4;
        color: #16a34a;
        border: 1.5px solid #dcfce7;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin-bottom: 24px;
    }

    .success-title {
        color: var(--navy);
        font-weight: 800;
        font-size: 26px;
        margin-bottom: 12px;
    }

    .success-desc {
        color: var(--text-muted);
        font-size: 14.5px;
        line-height: 1.8;
        margin-bottom: 32px;
    }

    .btn-theme-primary {
        background: var(--beige) !important;
        border: 1.5px solid var(--border) !important;
        color: var(--navy) !important;
        border-radius: 10px !important;
        padding: 13px 20px;
        font-weight: 800;
        font-size: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(12, 34, 63, 0.08);
    }

    .btn-theme-primary:hover {
        background: var(--beige-hover) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(12, 34, 63, 0.14);
    }

    .btn-theme-outline {
        background: transparent !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 10px !important;
        padding: 12px 20px;
        font-weight: 700;
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-theme-outline:hover {
        background: var(--beige) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
    }
</style>

<section class="success-section text-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="success-card">
                    <div class="success-icon-badge">
                        <i class="fas fa-check"></i>
                    </div>

                    <h1 class="success-title">تم الدفع بنجاح!</h1>

                    <p class="success-desc">
                        شكراً لك على شرائك من <strong>TechXpress</strong>. تم تأكيد طلبك بنجاح وسيتم تجهيزه وشحنه لك في أقرب وقت.
                    </p>

                    <div class="d-grid gap-2">
                        @if (orderId.HasValue)
                        {
                            <a asp-controller="Profile" asp-action="OrderDetails" asp-route-id="@orderId.Value" class="btn-theme-primary">
                                <i class="fas fa-receipt ms-1"></i> تفاصيل الطلب #@orderId.Value
                            </a>
                        }

                        <a asp-controller="Profile" asp-action="Orders" asp-area="" class="@(orderId.HasValue ? "btn-theme-outline" : "btn-theme-primary")">
                            <i class="fas fa-bag-shopping ms-1"></i> عرض طلباتي
                        </a>

                        <a asp-controller="Products" asp-action="Index" asp-area="" class="btn-theme-outline">
                            <i class="fas fa-box-open ms-1"></i> مواصلة التسوق
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>