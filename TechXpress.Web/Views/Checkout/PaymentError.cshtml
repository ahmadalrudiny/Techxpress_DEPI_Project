@{
    ViewData["Title"] = "تعذّر إتمام الدفع - TechXpress";
    var errorMessage = TempData["PaymentError"] as string;
    int? orderId = ViewData["OrderId"] as int?;
    decimal? orderTotal = ViewData["OrderTotal"] as decimal?;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --beige: #FAF7F2;
        --beige-hover: #ede6db;
        --cream: #FAF7F2;
        --navy: #0C223F;
        --border: #E3D9C9;
        --white: #FFFFFF;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Cairo', "Segoe UI", sans-serif;
    }

    .error-section {
        background-color: var(--cream);
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 15px;
    }

    .error-card {
        background: var(--white) !important;
        border: 1px solid var(--border) !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 30px -5px rgba(12, 34, 63, 0.06) !important;
        padding: 45px 35px !important;
        max-width: 520px;
        width: 100%;
        margin: 0 auto;
    }

    .error-icon-badge {
        width: 70px;
        height: 70px;
        background: #fffbeb;
        color: #d97706;
        border: 1.5px solid #fef3c7;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin-bottom: 24px;
    }

    .error-title {
        color: var(--navy);
        font-weight: 800;
        font-size: 26px;
        margin-bottom: 12px;
    }

    .error-desc {
        color: var(--text-muted);
        font-size: 14.5px;
        line-height: 1.8;
        margin-bottom: 24px;
    }

    .info-note-box {
        background: #faf7f2;
        border: 1.5px dashed var(--border);
        border-radius: 12px;
        padding: 14px 16px;
        font-size: 13.5px;
        color: var(--navy);
        line-height: 1.6;
        margin-bottom: 26px;
        text-align: right;
    }

    .btn-theme-primary {
        background: var(--beige) !important;
        border: 1.5px solid var(--border) !important;
        color: var(--navy) !important;
        border-radius: 10px !important;
        padding: 13px 20px;
        font-weight: 800;
        font-size: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(12, 34, 63, 0.08);
    }

    .btn-theme-primary:hover {
        background: var(--beige-hover) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(12, 34, 63, 0.14);
    }

    .btn-theme-outline {
        background: transparent !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 10px !important;
        padding: 12px 20px;
        font-weight: 700;
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-theme-outline:hover {
        background: var(--beige) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
    }

    .contact-link {
        color: var(--navy);
        font-weight: 700;
        text-decoration: underline;
    }
</style>

<section class="error-section text-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="error-card">
                    <div class="error-icon-badge">
                        <i class="fas fa-triangle-exclamation"></i>
                    </div>

                    <h1 class="error-title">تعذّر إتمام عملية الدفع</h1>

                    <p class="error-desc">
                        @(string.IsNullOrWhiteSpace(errorMessage)
                            ? "حدثت مشكلة غير متوقعة أثناء تجهيز عملية الدفع. يُرجى المحاولة مرة أخرى."
                            : errorMessage)
                    </p>

                    <div class="info-note-box">
                        <div class="d-flex align-items-start gap-2">
                            <i class="fas fa-cart-shopping mt-1" style="color: var(--navy);"></i>
                            <div>
                                <strong>سلة الشراء محفوظة كما هي.</strong>
                                يمكنك إعادة المحاولة بأمان؛ لن يتم إنشاء طلب مكرر، وستُستأنف نفس جلسة الدفع إن كانت ما زالت مفتوحة.
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        @if (orderId.HasValue)
                        {
                            <a asp-action="Payment" asp-route-orderId="@orderId.Value" class="btn-theme-primary">
                                <i class="fas fa-rotate-right ms-1"></i> إعادة المحاولة@(orderTotal.HasValue ? $" (${orderTotal.Value:F2})" : string.Empty)
                            </a>
                            <a asp-controller="Profile" asp-action="OrderDetails" asp-route-id="@orderId.Value" class="btn-theme-outline">
                                <i class="fas fa-receipt ms-1"></i> تفاصيل الطلب
                            </a>
                        }
                        
                        <a asp-controller="Cart" asp-action="Index" class="@(orderId.HasValue ? "btn-theme-outline" : "btn-theme-primary")">
                            <i class="fas fa-cart-shopping ms-1"></i> العودة إلى السلة
                        </a>

                        <a asp-controller="Profile" asp-action="Orders" class="btn-theme-outline">
                            <i class="fas fa-bag-shopping ms-1"></i> سجل الطلبات
                        </a>
                    </div>

                    <p class="text-muted small mt-4 mb-0">
                        إذا استمرت المشكلة، تواصل مع فريق الدعم عبر
                        <a asp-controller="Home" asp-action="Contact" class="contact-link">صفحة تواصل معنا</a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>