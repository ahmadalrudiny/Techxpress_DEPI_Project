@{
    ViewData["Title"] = "تعذّر إتمام الدفع - TechXpress";
    var errorMessage = TempData["PaymentError"] as string;
    int? orderId = ViewData["OrderId"] as int?;
    decimal? orderTotal = ViewData["OrderTotal"] as decimal?;
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card border-secondary shadow-sm">
                    <div class="card-body p-5 text-center">
                        <div class="result-icon result-error mb-4">
                            <i class="fas fa-triangle-exclamation"></i>
                        </div>
                        <h1 class="h2 fw-bold mb-3">تعذّر إتمام عملية الدفع</h1>
                        <p class="text-muted mb-4">
                            @(string.IsNullOrWhiteSpace(errorMessage)
                                ? "حدثت مشكلة غير متوقعة أثناء تجهيز عملية الدفع. يُرجى المحاولة مرة أخرى."
                                : errorMessage)
                        </p>

                        <div class="alert alert-warning text-start small mb-4" role="alert">
                            <i class="fas fa-cart-shopping me-1"></i>
                            <strong>سلة الشراء محفوظة كما هي.</strong>
                            يمكنك إعادة المحاولة بأمان؛ لن يتم إنشاء طلب جديد،
                            وستُستأنف نفس جلسة الدفع إن كانت ما زالت مفتوحة.
                        </div>

                        <div class="d-grid gap-2">
                            @if (orderId.HasValue)
                            {
                                <a asp-action="Payment" asp-route-orderId="@orderId.Value"
                                   class="btn btn-warning btn-lg fw-bold py-3 shadow-sm">
                                    <i class="fas fa-rotate-right me-2"></i>
                                    إعادة المحاولة@(orderTotal.HasValue ? $" (${orderTotal.Value:F2})" : string.Empty)
                                </a>
                                <a asp-controller="Profile" asp-action="OrderDetails" asp-route-id="@orderId.Value"
                                   class="btn btn-outline-secondary btn-lg fw-bold py-3">
                                    <i class="fas fa-receipt me-2"></i>تفاصيل الطلب
                                </a>
                            }
                            <a asp-controller="Cart" asp-action="Index"
                               class="btn @(orderId.HasValue ? "btn-outline-warning" : "btn-warning") btn-lg fw-bold py-3">
                                <i class="fas fa-cart-shopping me-2"></i>العودة إلى السلة
                            </a>
                            <a asp-controller="Profile" asp-action="Orders"
                               class="btn btn-outline-secondary btn-lg fw-bold py-3">
                                <i class="fas fa-shopping-bag me-2"></i>سجل الطلبات
                            </a>
                        </div>

                        <p class="text-muted small mt-4 mb-0">
                            إذا استمرت المشكلة، تواصل مع الدعم عبر
                            <a asp-controller="Home" asp-action="Contact" class="text-warning fw-semibold">صفحة تواصل معنا</a>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
