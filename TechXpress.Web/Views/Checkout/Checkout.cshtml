@model CheckoutViewModel
@using TechXpress.Web.Models
@{
    ViewData["Title"] = "إتمام الطلب - TechXpress";
}

<section class="pb-5">
    <div class="container">
        <div class="page-head mb-4">
            <div class="page-head-icon"><i class="fas fa-credit-card"></i></div>
            <div class="page-head-text">
                <h1>إتمام الطلب</h1>
                <p>أدخل عنوان الشحن ثم أكمل الدفع بأمان عبر Stripe</p>
            </div>
            <div class="page-head-actions">
                <a asp-action="Index" asp-controller="Cart" class="btn btn-outline-warning btn-sm fw-bold">
                    <i class="fas fa-cart-shopping me-1"></i>سلة التسوق
                </a>
            </div>
        </div>

        <div class="row g-4">
            <!-- Shipping Address Form -->
            <div class="col-lg-6">
                <div class="card border-secondary shadow-sm">
                    <div class="card-header bg-dark border-secondary py-3">
                        <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-map-marker-alt me-2 text-warning"></i>عنوان الشحن</h2>
                    </div>
                    <div class="card-body">
                        <form asp-action="PlaceOrder" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-dark">عنوان الشحن الكامل</label>
                                <textarea name="ShippingAddress" class="form-control" rows="4" required placeholder="مثال: القاهرة، مصر، شارع النيل، الشقة ٥">@Model.ShippingAddress</textarea>
                                <span class="text-danger small" asp-validation-for="ShippingAddress"></span>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-dark">كود الخصم (اختياري)</label>
                                <input type="text" name="PromoCode" class="form-control" placeholder="مثال: SAVE10" value="@Model.PromoCode" />
                                <div class="form-text text-muted small">أدخل كود الخصم إذا كان لديك، مثل SAVE10 أو SAVE20</div>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-warning btn-lg fw-bold py-3 shadow-sm">
                                    <i class="fas fa-credit-card me-2"></i>إتمام الطلب والدفع
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-6">
                <div class="card border-secondary shadow-sm sticky-top" style="top: 100px;">
                    <div class="card-header bg-dark border-secondary py-3">
                        <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-receipt me-2 text-warning"></i>ملخص الطلب</h2>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                            <span class="text-muted">المجموع الفرعي</span>
                            <span class="fw-bold">$@Model.Subtotal.ToString("F2")</span>
                        </div>
                        @if (Model.Discount > 0)
                        {
                            <div class="d-flex justify-content-between mb-3 pb-3 border-bottom text-success">
                                <span class="text-muted">الخصم (@Model.PromoCode)</span>
                                <span class="fw-bold">- $@Model.Discount.ToString("F2")</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between mb-4 fw-bold fs-5">
                            <span class="text-dark">المبلغ المستحق للدفع</span>
                            <span class="price-tag">$@Model.Total.ToString("F2")</span>
                        </div>

                        <div class="alert alert-info mb-4">
                            <i class="fas fa-circle-info me-2"></i>
                            ستتم إعادة توجيهك إلى <strong>Stripe</strong> لإتمام عملية الدفع بشكل آمن. لا يتم تخزين بيانات بطاقتك على خوادمنا.
                        </div>

                        <div class="text-center text-muted small">
                            <i class="fas fa-shield-halved me-1 text-success"></i>دفع آمن ومشفّر
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
