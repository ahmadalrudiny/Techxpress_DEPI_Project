@{
    ViewData["Title"] = "إلغاء الدفع - TechXpress";
    int? retryOrderId = ViewData["RetryOrderId"] as int?;
    decimal? retryTotal = ViewData["RetryTotal"] as decimal?;
    var retryAmountText = retryTotal.HasValue ? $" (${retryTotal.Value:F2})" : string.Empty;
    var cartItemCount = ViewData["CartItemCount"] as int? ?? 0;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --beige: #FAF7F2;
        --beige-hover: #ede6db;
        --cream: #FAF7F2;
        --navy: #0C223F;
        --border: #E3D9C9;
        --white: #FFFFFF;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Cairo', "Segoe UI", sans-serif;
    }

    .cancel-section {
        background-color: var(--cream);
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 15px;
    }

    .cancel-card {
        background: var(--white) !important;
        border: 1px solid var(--border) !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 30px -5px rgba(12, 34, 63, 0.06) !important;
        padding: 45px 35px !important;
        max-width: 520px;
        width: 100%;
        margin: 0 auto;
    }

    .cancel-icon-badge {
        width: 70px;
        height: 70px;
        background: #fef2f2;
        color: #dc2626;
        border: 1.5px solid #fee2e2;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin-bottom: 24px;
    }

    .cancel-title {
        color: var(--navy);
        font-weight: 800;
        font-size: 26px;
        margin-bottom: 12px;
    }

    .cancel-desc {
        color: var(--text-muted);
        font-size: 14.5px;
        line-height: 1.8;
        margin-bottom: 32px;
    }

    .btn-theme-primary {
        background: var(--beige) !important;
        border: 1.5px solid var(--border) !important;
        color: var(--navy) !important;
        border-radius: 10px !important;
        padding: 13px 20px;
        font-weight: 800;
        font-size: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(12, 34, 63, 0.08);
    }

    .btn-theme-primary:hover {
        background: var(--beige-hover) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(12, 34, 63, 0.14);
    }

    .btn-theme-outline {
        background: transparent !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 10px !important;
        padding: 12px 20px;
        font-weight: 700;
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-theme-outline:hover {
        background: var(--beige) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
    }
</style>

<section class="cancel-section text-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="cancel-card">
                    <div class="cancel-icon-badge">
                        <i class="fas fa-xmark"></i>
                    </div>

                    <h1 class="cancel-title">لم يكتمل الدفع</h1>

                    <p class="cancel-desc">
                        لم يتم خصم أي مبلغ من بطاقتك. طلبك محفوظ بحالة
                        <strong style="color: var(--navy);">قيد الانتظار</strong>،
                        وسلة الشراء محفوظة كما هي، ويمكنك إتمام الدفع الآن أو في أي وقت من سجل طلباتك.
                    </p>

                    <div class="d-grid gap-2">
                        @if (retryOrderId.HasValue)
                        {
                            <a asp-action="Payment" asp-route-orderId="@retryOrderId.Value" class="btn-theme-primary">
                                <i class="fas fa-credit-card ms-1"></i> إعادة محاولة الدفع@(retryAmountText)
                            </a>
                        }

                        @if (cartItemCount > 0)
                        {
                            <a asp-controller="Cart" asp-action="Index" class="btn-theme-outline">
                                <i class="fas fa-cart-shopping ms-1"></i> العودة إلى السلة (@cartItemCount)
                            </a>
                        }

                        @if (retryOrderId.HasValue)
                        {
                            <a asp-controller="Profile" asp-action="OrderDetails" asp-route-id="@retryOrderId.Value" class="btn-theme-outline">
                                <i class="fas fa-receipt ms-1"></i> تفاصيل الطلب
                            </a>
                        }

                        <a asp-controller="Profile" asp-action="Orders" class="btn-theme-outline">
                            <i class="fas fa-bag-shopping ms-1"></i> سجل طلباتي
                        </a>

                        <a asp-controller="Products" asp-action="Index" class="btn-theme-outline">
                            <i class="fas fa-box-open ms-1"></i> تصفح المنتجات
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>