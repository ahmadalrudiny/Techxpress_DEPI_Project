@{
    ViewData["Title"] = "الصفحة غير موجودة - TechXpress";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --beige: #FAF7F2;
        --beige-hover: #ede6db;
        --cream: #FAF7F2;
        --navy: #0C223F;
        --border: #E3D9C9;
        --white: #FFFFFF;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Cairo', "Segoe UI", sans-serif;
    }

    .notfound-section {
        background-color: var(--cream);
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 15px;
    }

    .notfound-card {
        background: var(--white) !important;
        border: 1px solid var(--border) !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 30px -5px rgba(12, 34, 63, 0.06) !important;
        padding: 50px 35px !important;
        max-width: 520px;
        width: 100%;
        margin: 0 auto;
    }

    .notfound-icon-badge {
        width: 80px;
        height: 80px;
        background: var(--beige);
        color: var(--navy);
        border: 1.5px solid var(--border);
        border-radius: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin-bottom: 20px;
    }

    .notfound-code {
        color: var(--navy);
        font-weight: 800;
        font-size: 64px;
        line-height: 1;
        margin-bottom: 10px;
        letter-spacing: -1px;
    }

    .notfound-title {
        color: var(--navy);
        font-weight: 800;
        font-size: 22px;
        margin-bottom: 12px;
    }

    .notfound-desc {
        color: var(--text-muted);
        font-size: 14.5px;
        line-height: 1.8;
        margin-bottom: 35px;
    }

    .btn-theme-primary {
        background: var(--beige) !important;
        border: 1.5px solid var(--border) !important;
        color: var(--navy) !important;
        border-radius: 10px !important;
        padding: 13px 20px;
        font-weight: 800;
        font-size: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(12, 34, 63, 0.08);
    }

    .btn-theme-primary:hover {
        background: var(--beige-hover) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(12, 34, 63, 0.14);
    }

    .btn-theme-outline {
        background: transparent !important;
        color: var(--navy) !important;
        border: 1.5px solid var(--border) !important;
        border-radius: 10px !important;
        padding: 12px 20px;
        font-weight: 700;
        font-size: 14.5px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-theme-outline:hover {
        background: var(--beige) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
    }
</style>

<section class="notfound-section text-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="notfound-card">
                    <div class="notfound-icon-badge">
                        <i class="fas fa-compass"></i>
                    </div>

                    <div class="notfound-code">404</div>
                    <h1 class="notfound-title">الصفحة غير موجودة</h1>

                    <p class="notfound-desc">
                        عذراً، الصفحة التي تحاول الوصول إليها غير متاحة أو تم نقلها إلى عنوان آخر.
                    </p>

                    <div class="d-grid gap-3">
                        <a asp-controller="Home" asp-action="Index" class="btn-theme-primary">
                            <i class="fas fa-house ms-1"></i> العودة إلى الصفحة الرئيسية
                        </a>
                        <a asp-controller="Products" asp-action="Index" class="btn-theme-outline">
                            <i class="fas fa-box-open ms-1"></i> تصفح المنتجات
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
</section>