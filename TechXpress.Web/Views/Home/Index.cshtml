@model TechXpress.Web.Models.HomeIndexViewModel
@using TechXpress.Services.Models
@using System.Linq
@{
    ViewData["Title"] = "TechXpress - متجر الإلكترونيات الأول";

    // أيقونات متناوبة لبطاقات الفئات (الفئة نفسها لا تحمل أيقونة مخزّنة)
    var categoryIcons = new[] { "fa-laptop", "fa-mobile-screen", "fa-camera", "fa-headphones",
                                "fa-gamepad", "fa-tv", "fa-print", "fa-keyboard" };
    var categoryColors = new[] { "primary", "success", "info", "warning", "danger", "secondary" };
    var categories = Model.Categories.Take(8).ToList();
    var featured = Model.FeaturedProducts?.ToList() ?? new List<ProductDto>();
    var heroImages = featured.Where(p => !string.IsNullOrWhiteSpace(p.ImageUrl)).Take(2).ToList();
}

<!-- Hero Section -->
<section class="hero-wrap">
    <div class="container">
        <div class="hero-section">
            <div class="row align-items-center g-4 g-lg-5">
                <div class="col-lg-6 text-center text-lg-start">
                    <span class="hero-eyebrow">
                        <i class="fas fa-bolt"></i> أحدث العروض على الأجهزة الإلكترونية
                    </span>
                    <h1 class="mb-3">
                        تسوّق أحدث التقنية<br />
                        <span class="text-gradient">بأسعار تنافسية</span>
                    </h1>
                    <p class="lead mb-4">
                        أفضل الأجهزة الإلكترونية من لابتوبات وهواتف ذكية وكاميرات وملحقات،
                        من بائعين معتمدين مع ضمان الجودة والتوصيل السريع.
                    </p>
                    <div class="d-flex flex-column flex-sm-row justify-content-center justify-content-lg-start gap-3">
                        <a asp-area="" asp-controller="Products" asp-action="Index"
                           class="btn btn-warning btn-lg px-4">
                            <i class="fas fa-cart-shopping me-2"></i> ابدأ التسوق الآن
                        </a>
                        <a href="#categories" class="btn btn-outline-light btn-lg px-4">
                            <i class="fas fa-layer-group me-2"></i> تصفّح الفئات
                        </a>
                    </div>
                    <ul class="hero-trust justify-content-center justify-content-lg-start">
                        <li><i class="fas fa-shield-halved"></i> دفع آمن</li>
                        <li><i class="fas fa-truck-fast"></i> توصيل سريع</li>
                        <li><i class="fas fa-rotate-left"></i> إرجاع سهل</li>
                    </ul>
                </div>
                <div class="col-lg-6">
                    <div class="hero-visual">
                        @if (heroImages.Count >= 2)
                        {
                            <img src="@heroImages[0].ImageUrl" alt="@heroImages[0].Name" loading="eager" />
                            <img src="@heroImages[1].ImageUrl" alt="@heroImages[1].Name" loading="lazy" />
                        }
                        else if (heroImages.Count == 1)
                        {
                            <img src="@heroImages[0].ImageUrl" alt="@heroImages[0].Name" loading="eager" />
                            <div class="hero-art"><i class="fas fa-microchip"></i></div>
                        }
                        else
                        {
                            <div class="hero-art"><i class="fas fa-laptop"></i></div>
                            <div class="hero-art"><i class="fas fa-mobile-screen"></i></div>
                        }
                        <div class="hero-float">
                            <i class="fas fa-truck-fast"></i>
                            <div>
                                <strong>توصيل سريع</strong>
                                <span>لجميع المحافظات</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats strip -->
        <div class="hero-stats row g-0">
            <div class="hero-stat col-6 col-md-3">
                <strong>@Model.TotalProducts.ToString("N0")+</strong>
                <span>منتج متاح</span>
            </div>
            <div class="hero-stat col-6 col-md-3">
                <strong>100%</strong>
                <span>دفع آمن عبر Stripe</span>
            </div>
            <div class="hero-stat col-6 col-md-3">
                <strong>24/7</strong>
                <span>دعم فني متاح</span>
            </div>
            <div class="hero-stat col-6 col-md-3">
                <strong>27</strong>
                <span>محافظة للتوصيل</span>
            </div>
        </div>
    </div>
</section>

@if (categories.Any())
{
    <!-- Categories Section -->
    <section class="categories-section py-5" id="categories">
        <div class="container">
            <div class="row align-items-end mb-4">
                <div class="col-lg-8">
                    <span class="chip chip-gold mb-2"><i class="fas fa-layer-group"></i> الفئات</span>
                    <h2 class="fw-bold mb-1">تسوّق حسب الفئة</h2>
                    <p class="text-muted mb-0">تصفّح منتجاتنا منظّمة حسب الفئة لسهولة العثور على ما تبحث عنه</p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <a asp-area="" asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary px-4">
                        كل المنتجات <i class="fas fa-arrow-left ms-2"></i>
                    </a>
                </div>
            </div>
            <div class="row g-4">
                @for (int i = 0; i < categories.Count; i++)
                {
                    var cat = categories[i];
                    var icon = categoryIcons[i % categoryIcons.Length];
                    var color = categoryColors[i % categoryColors.Length];
                    <div class="col-md-6 col-lg-3">
                        <a asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoryId="@cat.Id"
                           class="category-card d-block h-100 text-decoration-none">
                            <div class="category-icon bg-@color bg-opacity-10 text-@color p-3 rounded-4 mb-3 d-inline-flex">
                                <i class="fas @icon fa-2x"></i>
                            </div>
                            <h3 class="h6 fw-bold mb-1">@cat.Name</h3>
                            <p class="text-muted small mb-3">
                                @(string.IsNullOrWhiteSpace(cat.Description) ? "تصفّح منتجات هذه الفئة" : cat.Description)
                            </p>
                            <span class="small fw-bold text-gold-dark">
                                تصفّح <i class="fas fa-arrow-left ms-1"></i>
                            </span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Featured Products Section -->
<section class="featured-products py-5" id="featuredProducts">
    <div class="container">
        <div class="row align-items-end mb-4">
            <div class="col-lg-8">
                <span class="chip chip-gold mb-2"><i class="fas fa-star"></i> مختارة بعناية</span>
                <h2 class="fw-bold mb-1">أحدث المنتجات</h2>
                <p class="text-muted mb-0">اختر من بين أحدث الأجهزة الإلكترونية المتاحة في متجرنا</p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a asp-area="" asp-controller="Products" asp-action="Index" class="btn btn-outline-warning px-4">
                    عرض الكل <i class="fas fa-arrow-left ms-2"></i>
                </a>
            </div>
        </div>

        @if (!featured.Any())
        {
            <div class="empty-state text-center py-5">
                <i class="fas fa-box-open fa-3x mb-3"></i>
                <h3 class="h5 fw-bold mb-2">لا توجد منتجات متاحة حالياً</h3>
                <p class="text-muted mb-0">سيتم إضافة منتجات جديدة قريباً.</p>
            </div>
        }
        else
        {
            @await Html.PartialAsync("_ProductCardsPartial", featured)
        }
    </div>
</section>

<!-- Why us -->
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center mb-4">
            <div class="col-lg-8 text-center">
                <span class="chip chip-gold mb-2"><i class="fas fa-shield-halved"></i> لماذا نحن</span>
                <h2 class="fw-bold mb-2">لماذا تختار TechXpress؟</h2>
                <p class="text-muted mb-0">تجربة تسوّق مصمّمة لتمنحك الثقة والراحة من أول نقرة حتى استلام طلبك</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-tile">
                    <span class="feature-icon"><i class="fas fa-shield-halved"></i></span>
                    <h3 class="h5 fw-bold mb-2">دفع آمن</h3>
                    <p class="text-muted small mb-0">دفع إلكتروني آمن عبر Stripe مع حماية كاملة لبياناتك البنكية.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-tile">
                    <span class="feature-icon"><i class="fas fa-truck-fast"></i></span>
                    <h3 class="h5 fw-bold mb-2">توصيل سريع</h3>
                    <p class="text-muted small mb-0">توصيل إلى جميع المحافظات في أسرع وقت مع إمكانية تتبع الطلب.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-tile">
                    <span class="feature-icon"><i class="fas fa-headset"></i></span>
                    <h3 class="h5 fw-bold mb-2">دعم على مدار الساعة</h3>
                    <p class="text-muted small mb-0">فريق دعم فني متاح للإجابة على جميع استفساراتك في أي وقت.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Vendor CTA -->
@if (!(User.IsInRole("Vendor") || User.IsInRole("Admin")))
{
    <section class="pb-5">
        <div class="container">
            <div class="cta-section text-center">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <span class="hero-eyebrow mb-3"><i class="fas fa-store"></i> انضم إلينا</span>
                        <h2 class="fw-bold mb-3">هل أنت بائع إلكترونيات؟</h2>
                        <p class="opacity-80 mb-4">
                            اعرض منتجاتك أمام آلاف العملاء، وأدر متجرك ومحفظتك وطلباتك من لوحة تحكم واحدة.
                        </p>
                        <a asp-area="" asp-controller="VendorApply" asp-action="Apply" class="btn btn-warning btn-lg px-4">
                            <i class="fas fa-store me-2"></i> قدّم طلب انضمام
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
