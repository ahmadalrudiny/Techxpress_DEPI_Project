@model TechXpress.Web.Models.ContactFormViewModel
@{
    ViewData["Title"] = "تواصل معنا - TechXpress";
}

<section class="pb-5">
    <div class="container">
        <div class="page-head mb-4">
            <div class="page-head-icon"><i class="fas fa-envelope-open-text"></i></div>
            <div class="page-head-text">
                <h1>تواصل معنا</h1>
                <p>فريق الدعم جاهز لمساعدتك — نرد عادةً خلال 24 ساعة</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- بيانات التواصل -->
            <div class="col-lg-4">
                <div class="card border-secondary shadow-sm h-100">
                    <div class="card-header bg-dark border-secondary py-3">
                        <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-address-card text-warning me-2"></i>بيانات التواصل</h2>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex align-items-start mb-4">
                            <span class="result-icon result-success me-3" style="width:44px;height:44px;font-size:1rem;">
                                <i class="fas fa-envelope"></i>
                            </span>
                            <div>
                                <h3 class="h6 fw-bold mb-1">البريد الإلكتروني</h3>
                                <p class="text-muted small mb-0">support@techxpress.com</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-4">
                            <span class="result-icon result-success me-3" style="width:44px;height:44px;font-size:1rem;">
                                <i class="fas fa-phone"></i>
                            </span>
                            <div>
                                <h3 class="h6 fw-bold mb-1">الهاتف</h3>
                                <p class="text-muted small mb-0" dir="ltr">+20 100 000 0000</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-4">
                            <span class="result-icon result-success me-3" style="width:44px;height:44px;font-size:1rem;">
                                <i class="fas fa-location-dot"></i>
                            </span>
                            <div>
                                <h3 class="h6 fw-bold mb-1">العنوان</h3>
                                <p class="text-muted small mb-0">القاهرة، مصر</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-start">
                            <span class="result-icon result-success me-3" style="width:44px;height:44px;font-size:1rem;">
                                <i class="fas fa-clock"></i>
                            </span>
                            <div>
                                <h3 class="h6 fw-bold mb-1">مواعيد العمل</h3>
                                <p class="text-muted small mb-0">السبت – الخميس: 9 صباحاً – 6 مساءً</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- نموذج التواصل -->
            <div class="col-lg-8">
                <div class="card border-secondary shadow-sm h-100">
                    <div class="card-header bg-dark border-secondary py-3">
                        <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-paper-plane text-warning me-2"></i>أرسل لنا رسالة</h2>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="Contact" method="post" novalidate>
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label fw-semibold text-dark"></label>
                                    <input asp-for="FullName" class="form-control" placeholder="اكتب اسمك بالكامل" />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-semibold text-dark"></label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" dir="ltr" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label fw-semibold text-dark"></label>
                                    <input asp-for="Phone" class="form-control" placeholder="01xxxxxxxxx" dir="ltr" />
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Subject" class="form-label fw-semibold text-dark"></label>
                                    <input asp-for="Subject" class="form-control" placeholder="مثال: استفسار عن طلب" />
                                    <span asp-validation-for="Subject" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Message" class="form-label fw-semibold text-dark"></label>
                                    <textarea asp-for="Message" class="form-control" rows="6" placeholder="اكتب تفاصيل رسالتك هنا..."></textarea>
                                    <span asp-validation-for="Message" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-4">
                                <p class="text-muted small mb-0">
                                    <i class="fas fa-circle-info me-1"></i>تُحفظ رسالتك ويطّلع عليها فريق الدعم من لوحة التحكم.
                                </p>
                                <button type="submit" class="btn btn-warning fw-bold px-4">
                                    <i class="fas fa-paper-plane me-1"></i>إرسال الرسالة
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
