@model TechXpress.Web.Models.ContactFormViewModel
@{
    ViewData["Title"] = "تواصل معنا - TechXpress";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --beige: #FAF7F2;
        --beige-hover: #ede6db;
        --cream: #FAF7F2;
        --navy: #0C223F;
        --navy-dark: #071528;
        --navy-light: #153359;
        --border: #E3D9C9;
        --white: #FFFFFF;
        --text-dark: #0C223F;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Cairo', "Segoe UI", sans-serif;
    }

    .contact-section {
        background-color: var(--cream);
        min-height: 85vh;
        padding-top: 35px;
        padding-bottom: 50px;
    }

    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 20px 24px;
        box-shadow: 0 4px 16px rgba(12, 34, 63, 0.04);
    }

    .page-head-main {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .page-head-icon {
        width: 48px;
        height: 48px;
        background: var(--navy);
        color: var(--beige);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .page-head-text h1 {
        color: var(--navy);
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 2px;
    }

    .page-head-text p {
        color: var(--text-muted);
        font-size: 13.5px;
        margin-bottom: 0;
    }

    .custom-card {
        background: var(--white);
        border: 1px solid var(--border) !important;
        border-radius: 16px !important;
        box-shadow: 0 4px 16px rgba(12, 34, 63, 0.04) !important;
        overflow: hidden;
    }

    .custom-card-header {
        background: var(--navy) !important;
        color: var(--white) !important;
        padding: 16px 22px !important;
        border-bottom: 1px solid var(--border) !important;
    }

    .custom-card-header h2 {
        font-size: 16px;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .custom-card-header i {
        color: var(--beige);
    }

    .contact-icon-badge {
        width: 44px;
        height: 44px;
        background: var(--beige);
        color: var(--navy);
        border: 1px solid var(--border);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

    .contact-item-title {
        color: var(--navy);
        font-size: 14.5px;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .contact-item-val {
        color: var(--text-muted);
        font-size: 13.5px;
        margin-bottom: 0;
    }

    .form-label {
        color: var(--navy) !important;
        font-weight: 700;
        font-size: 13.5px;
        margin-bottom: 6px;
    }

    .form-control {
        background-color: var(--white) !important;
        border: 1.5px solid var(--border) !important;
        color: var(--navy) !important;
        border-radius: 10px !important;
        padding: 10px 14px;
        font-size: 14px;
        transition: all 0.2s ease;
    }

    .form-control:focus {
        border-color: var(--navy) !important;
        box-shadow: 0 0 0 3px rgba(12, 34, 63, 0.1) !important;
        outline: none;
    }

    .btn-theme-primary {
        background: var(--beige) !important;
        border: 1.5px solid var(--border) !important;
        color: var(--navy) !important;
        border-radius: 10px !important;
        padding: 10px 24px;
        font-weight: 800;
        font-size: 14.5px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(12, 34, 63, 0.08);
        cursor: pointer;
    }

    .btn-theme-primary:hover {
        background: var(--beige-hover) !important;
        border-color: var(--navy) !important;
        color: var(--navy) !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(12, 34, 63, 0.14);
    }
</style>

<section class="contact-section">
    <div class="container">
        <div class="page-head mb-4">
            <div class="page-head-main">
                <div class="page-head-icon">
                    <i class="fas fa-envelope-open-text"></i>
                </div>
                <div class="page-head-text">
                    <h1>تواصل معنا</h1>
                    <p>فريق الدعم جاهز لمساعدتك — نرد عادةً خلال 24 ساعة</p>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="custom-card h-100">
                    <div class="custom-card-header">
                        <h2>
                            <i class="fas fa-address-card"></i> بيانات التواصل
                        </h2>
                    </div>
                    <div class="p-4 d-flex flex-column gap-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="contact-icon-badge">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div>
                                <h3 class="contact-item-title">البريد الإلكتروني</h3>
                                <p class="contact-item-val" dir="ltr">support@techxpress.com</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            <div class="contact-icon-badge">
                                <i class="fas fa-phone"></i>
                            </div>
                            <div>
                                <h3 class="contact-item-title">الهاتف</h3>
                                <p class="contact-item-val" dir="ltr">+20 100 000 0000</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            <div class="contact-icon-badge">
                                <i class="fas fa-location-dot"></i>
                            </div>
                            <div>
                                <h3 class="contact-item-title">العنوان</h3>
                                <p class="contact-item-val">القاهرة، مصر</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            <div class="contact-icon-badge">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div>
                                <h3 class="contact-item-title">مواعيد العمل</h3>
                                <p class="contact-item-val">السبت – الخميس: 9 صباحاً – 6 مساءً</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="custom-card h-100">
                    <div class="custom-card-header">
                        <h2>
                            <i class="fas fa-paper-plane"></i> أرسل لنا رسالة
                        </h2>
                    </div>
                    <div class="p-4">
                        <form asp-action="Contact" method="post" novalidate>
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label">الاسم بالكامل</label>
                                    <input asp-for="FullName" class="form-control" placeholder="اكتب اسمك بالكامل" />
                                    <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" dir="ltr" />
                                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label">رقم الهاتف</label>
                                    <input asp-for="Phone" class="form-control" placeholder="01xxxxxxxxx" dir="ltr" />
                                    <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Subject" class="form-label">الموضوع</label>
                                    <input asp-for="Subject" class="form-control" placeholder="مثال: استفسار عن طلب" />
                                    <span asp-validation-for="Subject" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Message" class="form-label">الرسالة</label>
                                    <textarea asp-for="Message" class="form-control" rows="5" placeholder="اكتب تفاصيل رسالتك هنا..."></textarea>
                                    <span asp-validation-for="Message" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mt-4 pt-2">
                                <p class="text-muted small mb-0">
                                    <i class="fas fa-circle-info ms-1" style="color: var(--navy);"></i> تُحفظ رسالتك ويطّلع عليها فريق الدعم من لوحة التحكم.
                                </p>
                                <button type="submit" class="btn-theme-primary">
                                    <i class="fas fa-paper-plane ms-1"></i> إرسال الرسالة
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}