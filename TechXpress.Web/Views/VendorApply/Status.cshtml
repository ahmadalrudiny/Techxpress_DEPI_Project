
@model VendorApplicationStatusViewModel
@{
    ViewData["Title"] = "حالة طلب الانضمام - TechXpress";
    var statusText = Model.Status == "Approved" ? "معتمد"
        : Model.Status == "Rejected" ? "مرفوض"
        : "قيد المراجعة";
    var statusClass = Model.Status == "Approved" ? "bg-success"
        : Model.Status == "Rejected" ? "bg-danger"
        : "bg-warning text-dark";
}

<style>
    .page-head-icon {
        background: #FAF7F2;
        color: #0C223F;
        border: 1px solid #E3D9C9;
    }

    .page-head-text h1 {
        color: #0C223F;
    }

    .page-head-text p {
        color: #64748b;
    }

    .page-head-actions .badge {
        background: #FAF7F2 !important;
        color: #0C223F !important;
        border: 1px solid #E3D9C9;
        border-radius: 8px;
    }

    .page-head-actions .btn-warning {
        background: #FAF7F2 !important;
        color: #0C223F !important;
        border: 1px solid #E3D9C9 !important;
        border-radius: 8px;
    }

    .page-head-actions .btn-warning:hover {
        background: #0C223F !important;
        color: #FFFFFF !important;
        border-color: #0C223F !important;
    }

    .card {
        background: #FFFFFF;
        border: 1px solid #E3D9C9 !important;
        border-radius: 14px;
    }

    .card-header {
        background: #0C223F !important;
        border-color: #153359 !important;
    }

    .card-header h2 {
        color: #FFFFFF !important;
    }

    .card-header h2 i {
        color: #FAF7F2 !important;
    }

    .card-body {
        color: #0C223F;
    }

    .card-body dt {
        color: #64748b !important;
    }

    .card-body dd {
        color: #0C223F !important;
    }

    .card-body dd.fw-bold,
    .card-body dd.text-dark {
        color: #0C223F !important;
    }

    .card-body dd.text-danger {
        color: #0C223F !important;
    }

    .card-body .badge {
        background: #FAF7F2 !important;
        color: #0C223F !important;
        border: 1px solid #E3D9C9;
    }

    .bg-success,
    .bg-danger,
    .bg-warning {
        background: #FAF7F2 !important;
        color: #0C223F !important;
    }

    .alert {
        border-radius: 10px;
        color: #0C223F !important;
    }

    .alert-info {
        background: #FAF7F2 !important;
        border: 1px solid #E3D9C9 !important;
    }

    .alert-danger {
        background: #FAF7F2 !important;
        border: 1px solid #E3D9C9 !important;
    }

    .alert-success {
        background: #FAF7F2 !important;
        border: 1px solid #E3D9C9 !important;
    }

    .alert i {
        color: #0C223F !important;
    }

    .btn-warning {
        background: #FAF7F2 !important;
        color: #0C223F !important;
        border: 1.5px solid #E3D9C9 !important;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .btn-warning:hover {
        background: #0C223F !important;
        color: #FFFFFF !important;
        border-color: #0C223F !important;
    }
</style>

<section class="pb-5">
    <div class="container">
        <div class="page-head mb-4">
            <div class="page-head-icon"><i class="fas fa-clipboard-check"></i></div>
            <div class="page-head-text">
                <h1>حالة طلب الانضمام</h1>
                <p>تابع حالة طلبك للانضمام كمورد على TechXpress</p>
            </div>
            <div class="page-head-actions">
                <span class="badge @statusClass fs-6 px-3 py-2">@statusText</span>
                @if (Model.Status == "Approved")
                {
                    <a asp-action="Index" asp-controller="VendorDashboard" class="btn btn-warning btn-sm fw-bold">
                        <i class="fas fa-gauge-high me-1"></i>لوحة تحكم متجري
                    </a>
                }
            </div>
        </div>

        <div class="row">
            <div class="col-lg-7">
                <div class="card border-secondary shadow-sm">
                    <div class="card-header bg-dark border-secondary py-3">
                        <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-file-lines me-2 text-warning"></i>تفاصيل الطلب</h2>
                    </div>
                    <div class="card-body p-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">اسم المتجر</dt>
                            <dd class="col-sm-8 fw-bold text-dark">@Model.StoreName</dd>

                            <dt class="col-sm-4 text-muted">الحالة</dt>
                            <dd class="col-sm-8"><span class="badge @statusClass">@statusText</span></dd>

                            <dt class="col-sm-4 text-muted">تاريخ التقديم</dt>
                            <dd class="col-sm-8 text-dark">@Model.SubmittedAt.ToString("yyyy/MM/dd")</dd>

                            @if (!string.IsNullOrEmpty(Model.RejectionReason))
                            {
                                <dt class="col-sm-4 text-muted">سبب الرفض</dt>
                                <dd class="col-sm-8 text-danger">@Model.RejectionReason</dd>
                            }
                        </dl>
                    </div>
                </div>

                <div class="mt-4">
                    @if (Model.Status == "Pending")
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-clock me-2"></i>طلبك قيد المراجعة حالياً. سيتم إشعارك فور معالجته.
                        </div>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-circle-xmark me-2"></i>تم رفض طلبك. يمكنك إعادة التقديم بعد معالجة سبب الرفض.
                            <div class="mt-2">
                                <a asp-action="Apply" class="btn btn-warning btn-sm fw-bold">
                                    <i class="fas fa-redo me-1"></i>إعادة التقديم
                                </a>
                            </div>
                        </div>
                    }
                    else if (Model.Status == "Approved")
                    {
                        <div class="alert alert-success">
                            <i class="fas fa-circle-check me-2"></i>تهانينا! تم اعتماد طلبك كمورد.
                            <div class="mt-2">
                                <a asp-action="Index" asp-controller="VendorProduct" class="btn btn-warning btn-sm fw-bold">
                                    <i class="fas fa-box-open me-1"></i>الذهاب إلى منتجاتي
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
