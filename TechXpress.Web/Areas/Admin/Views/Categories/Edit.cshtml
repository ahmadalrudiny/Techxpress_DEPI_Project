@model CategoryEditViewModel
@using TechXpress.Web.Areas.Admin.Models
@{
    ViewData["Title"] = "تعديل فئة - TechXpress Admin";
}

<div class="page-head mb-4">
    <div class="page-head-icon"><i class="fas fa-pen-to-square"></i></div>
    <div class="page-head-text">
        <h1>تعديل الفئة</h1>
        <p>تحديث بيانات الفئة «@Model.Name»</p>
    </div>
    <div class="page-head-actions">
        <a asp-action="Index" class="btn btn-outline-warning btn-sm fw-bold">
            <i class="fas fa-arrow-right me-1"></i>الرجوع للفئات
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-secondary shadow-sm">
            <div class="card-header bg-dark border-secondary py-3">
                <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-tag me-2"></i>@Model.Name</h2>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">اسم الفئة</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">الوصف</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning fw-bold px-4">
                            <i class="fas fa-save me-1"></i>حفظ التعديلات
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">إلغاء</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
