@{
    ViewData["Title"] = "إضافة فئة - TechXpress Admin";
}

<div class="page-head mb-4">
    <div class="page-head-icon"><i class="fas fa-plus"></i></div>
    <div class="page-head-text">
        <h1>إضافة فئة جديدة</h1>
        <p>أضف فئة جديدة لتصنيف منتجات المتجر</p>
    </div>
    <div class="page-head-actions">
        <a asp-action="Index" class="btn btn-outline-warning btn-sm fw-bold">
            <i class="fas fa-arrow-right me-1"></i>الرجوع للفئات
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-secondary shadow-sm">
            <div class="card-header bg-dark border-secondary py-3">
                <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-tag me-2"></i>بيانات الفئة</h2>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label" for="name">اسم الفئة</label>
                        <input class="form-control" id="name" name="name" required maxlength="100" placeholder="مثال: أجهزة لاب توب" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label" for="description">الوصف</label>
                        <textarea class="form-control" id="description" name="description" rows="3" maxlength="500"
                                  placeholder="وصف مختصر للفئة (اختياري)"></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning fw-bold px-4">
                            <i class="fas fa-save me-1"></i>حفظ الفئة
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">إلغاء</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
