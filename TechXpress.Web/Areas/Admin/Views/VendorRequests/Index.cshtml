@model IEnumerable<VendorRequestItem>
@using TechXpress.Services.Models
@using TechXpress.Data.Entities
@{
    ViewData["Title"] = "طلبات انضمام البائعين - TechXpress Admin";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" />
}

<!-- Page Header -->
<div class="page-head mb-4">
    <div class="page-head-icon"><i class="fas fa-user-check"></i></div>
    <div class="page-head-text">
        <h1>طلبات انضمام البائعين</h1>
        <p>مراجعة واعتماد طلبات البائعين الجدد</p>
    </div>
    <div class="page-head-actions">
        <div class="btn-group">
        <a asp-action="Index" asp-route-status="Pending" class="btn @((string?)ViewData["Status"] == "Pending" ? "btn-warning" : "btn-outline-warning btn-sm")">
            <i class="fas fa-clock me-1"></i>قيد الانتظار
        </a>
        <a asp-action="Index" asp-route-status="Approved" class="btn @((string?)ViewData["Status"] == "Approved" ? "btn-success" : "btn-outline-success btn-sm")">
            <i class="fas fa-check me-1"></i>معتمد
        </a>
        <a asp-action="Index" asp-route-status="Rejected" class="btn @((string?)ViewData["Status"] == "Rejected" ? "btn-danger" : "btn-outline-danger btn-sm")">
            <i class="fas fa-times me-1"></i>مرفوض
        </a>
        <a asp-action="Index" class="btn @((string?)ViewData["Status"] == null ? "btn-secondary" : "btn-outline-secondary btn-sm")">
            <i class="fas fa-list me-1"></i>الكل
        </a>
        </div>
    </div>
</div>

<!-- Vendor Requests Table -->
<div class="card border-secondary shadow-sm">
    <div class="card-header bg-dark border-secondary py-3">
        <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-user-plus me-2"></i>طلبات البائعين (@Model.Count() طلب)</h2>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">لا توجد طلبات انضمام للبائعين حاليًا.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="vendorRequestsTable" class="table table-hover align-middle mb-0">
                    <thead class="bg-secondary text-white">
                        <tr>
                            <th>اسم المتجر</th>
                            <th>صاحب المتجر</th>
                            <th>البريد الإلكتروني</th>
                            <th class="text-center">تاريخ الطلب</th>
                            <th class="text-center">الحالة</th>
                            <th class="text-end">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-dark">@r.StoreName</span>
                                </td>
                                <td>
                                    <span class="text-dark fw-semibold">@r.OwnerName</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@r.OwnerEmail</span>
                                </td>
                                <td class="text-center">
                                    <span class="text-muted small">@r.SubmittedAt.ToString("yyyy/MM/dd")</span>
                                </td>
                                <td class="text-center">
                                    @switch (r.Status)
                                    {
                                        case VendorStatus.Pending:
                                            <span class="badge bg-warning text-dark fs-6 fw-bold">قيد الانتظار</span>
                                            break;
                                        case VendorStatus.Approved:
                                            <span class="badge bg-success fs-6 fw-bold">معتمد</span>
                                            break;
                                        case VendorStatus.Rejected:
                                            <span class="badge bg-danger fs-6 fw-bold">مرفوض</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    @if (r.Status == VendorStatus.Pending)
                                    {
                                        <form asp-action="Approve" asp-route-id="@r.Id" method="post" class="d-inline me-1"
                                              onsubmit="return confirm('هل أنت متأكد من اعتماد طلب انضمام هذا البائع؟');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="fas fa-check"></i>اعتماد
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-outline-danger reject-btn" data-id="@r.Id" data-name="@r.StoreName">
                                            <i class="fas fa-times"></i>رفض
                                        </button>
                                    }
                                    <a asp-action="Document" asp-route-vendorId="@r.Id" asp-route-type="NationalId" class="btn btn-sm btn-outline-info me-1">
                                        <i class="fas fa-id-card"></i>البطاقة
                                    </a>
                                    <a asp-action="Document" asp-route-vendorId="@r.Id" asp-route-type="CommercialRegister" class="btn btn-sm btn-outline-info me-1">
                                        <i class="fas fa-file-contract"></i>السجل التجاري
                                    </a>
                                    <a asp-action="Document" asp-route-vendorId="@r.Id" asp-route-type="TaxCard" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-file-invoice"></i>البطاقة الضريبية
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary">
                <h2 class="h5 modal-title text-white">رفض طلب انضمام</h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="rejectVendorId" name="id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white">سبب الرفض</label>
                        <textarea name="reason" class="form-control bg-secondary text-white" rows="4" required></textarea>
                    </div>
                    <div class="alert alert-warning small">
                        <i class="fas fa-info-circle me-2"></i>سيتم إرسال سبب الرفض إلى البائع عبر إشعار.
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger">تأكيد الرفض</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#vendorRequestsTable').DataTable({
                responsive: true,
                language: {
                    url: '/lib/datatables/i18n/ar.json'
                },
                columnDefs: [
                    { orderable: false, targets: [5] }
                ]
            });

            // Reject button opens modal
            $('.reject-btn').on('click', function () {
                var vendorId = $(this).data('id');
                var vendorName = $(this).data('name');
                $('#rejectVendorId').val(vendorId);
                $('#rejectModal').modal('show');
            });
        });
    </script>
}
