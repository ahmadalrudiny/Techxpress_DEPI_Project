@model DashboardViewModel
@using TechXpress.Web.Areas.Admin.Models
@using TechXpress.Services.Models
@{
    ViewData["Title"] = "لوحة التحكم - TechXpress Admin";
    Layout = "_AdminLayout";
}

@* Dashboard summary *@

<!-- Dashboard Header -->
<div class="page-head mb-4">
    <div class="page-head-icon"><i class="fas fa-gauge-high"></i></div>
    <div class="page-head-text">
        <h1>لوحة التحكم</h1>
        <p>مرحباً @(User.Identity?.Name ?? "مدير") — إدارة متجر TechXpress من مكان واحد</p>
    </div>
    <div class="page-head-actions">
        <a asp-action="Index" asp-controller="Dashboard" class="btn btn-outline-warning btn-sm fw-bold">
            <i class="fas fa-sync-alt me-1"></i>تحديث البيانات
        </a>
    </div>
</div>

<!-- Revenue: paid orders only -->
<div class="revenue-card mb-4">
    <div>
        <span class="revenue-label">إجمالي المبيعات المؤكدة</span>
        <h2 class="revenue-value">$@Model.TotalSales.ToString("N2")</h2>
        <span class="revenue-note">
            @Model.PaidOrders طلب مدفوع — الطلبات غير المدفوعة (قيد الانتظار) والملغاة لا تُحتسب
        </span>
    </div>
    <div class="revenue-icon" aria-hidden="true"><i class="fas fa-sack-dollar"></i></div>
</div>

<!-- Platform commission -->
<div class="card border-secondary shadow-sm mb-5" style="background:#0C223F;">
    <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3 p-4">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-3 d-flex align-items-center justify-content-center"
                 style="width:56px;height:56px;background:rgba(250,247,242,.12);border:1px solid rgba(250,247,242,.2);color:#FAF7F2;font-size:22px;">
                <i class="fas fa-percent"></i>
            </div>
            <div>
                <div class="text-uppercase small fw-bold" style="color:#cbd5e1;letter-spacing:.5px;">عمولة الموقع</div>
                <div class="fw-bold text-white" style="font-size:26px;">$@Model.PlatformRevenue.ToString("N2")</div>
                <div class="small" style="color:#94a3b8;">
                    تُحتسب على الطلبات المؤكدة فقط، وتُلغى تلقائيًا عند إلغاء أو إرجاع الطلب.
                </div>
            </div>
        </div>
        <span class="badge" style="background:rgba(250,247,242,.16);color:#FAF7F2;font-size:12.5px;padding:8px 14px;">
            نسبة العمولة الحالية: @((Model.TotalSales > 0 ? (Model.PlatformRevenue / Model.TotalSales * 100m) : 0m).ToString("N1"))%
        </span>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-3 col-lg-3">
        <div class="stat-card bg-dark border-secondary p-4 rounded-3 shadow-sm hover-lift">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h2 class="fw-bold text-white mb-1">@Model.TotalProducts</h2>
                    <p class="text-muted small">إجمالي المنتجات</p>
                </div>
                <div class="text-warning opacity-75">
                    <i class="fas fa-box fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-lg-3">
        <div class="stat-card bg-dark border-secondary p-4 rounded-3 shadow-sm hover-lift">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h2 class="fw-bold text-white mb-1">@Model.TotalOrders</h2>
                    <p class="text-muted small">إجمالي الطلبات</p>
                </div>
                <div class="text-info opacity-75">
                    <i class="fas fa-shopping-cart fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-lg-3">
        <div class="stat-card bg-dark border-secondary p-4 rounded-3 shadow-sm hover-lift">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h2 class="fw-bold text-white mb-1">@Model.TotalVendors</h2>
                    <p class="text-muted small">إجمالي البائعين</p>
                </div>
                <div class="text-success opacity-75">
                    <i class="fas fa-user-tie fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-lg-3">
        <div class="stat-card bg-dark border-secondary p-4 rounded-3 shadow-sm hover-lift">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h2 class="fw-bold text-white mb-1">@Model.TotalCustomers</h2>
                    <p class="text-muted small">إجمالي العملاء</p>
                </div>
                <div class="text-primary opacity-75">
                    <i class="fas fa-users fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-4 mb-5">
    <div class="col-lg-3 col-md-6">
        <a asp-action="Index" asp-controller="Products" class="card bg-dark border-secondary p-4 rounded-3 shadow-sm hover-lift text-decoration-none">
            <div class="d-flex align-items-center">
                <div class="bg-warning text-dark rounded-circle p-3 me-3">
                    <i class="fas fa-box fa-2x"></i>
                </div>
                <div>
                    <h3 class="h6 fw-bold text-white mb-1">إدارة المنتجات</h3>
                    <p class="text-muted small mb-0">إضافة وتعديل المنتجات</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-lg-3 col-md-6">
        <a asp-action="Index" asp-controller="Categories" class="card bg-dark border-secondary p-4 rounded-3 shadow-sm hover-lift text-decoration-none">
            <div class="d-flex align-items-center">
                <div class="bg-info text-dark rounded-circle p-3 me-3">
                    <i class="fas fa-tags fa-2x"></i>
                </div>
                <div>
                    <h3 class="h6 fw-bold text-white mb-1">إدارة الفئات</h3>
                    <p class="text-muted small mb-0">إضافة وتعديل الفئات</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-lg-3 col-md-6">
        <a asp-action="Index" asp-controller="Orders" class="card bg-dark border-secondary p-4 rounded-3 shadow-sm hover-lift text-decoration-none">
            <div class="d-flex align-items-center">
                <div class="bg-primary text-white rounded-circle p-3 me-3">
                    <i class="fas fa-shopping-cart fa-2x"></i>
                </div>
                <div>
                    <h3 class="h6 fw-bold text-white mb-1">إدارة الطلبات</h3>
                    <p class="text-muted small mb-0">تعديل الحالة وإلغاء الطلبات</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-lg-3 col-md-6">
        <a asp-action="Index" asp-controller="VendorRequests" class="card bg-dark border-secondary p-4 rounded-3 shadow-sm hover-lift text-decoration-none">
            <div class="d-flex align-items-center">
                <div class="bg-secondary text-white rounded-circle p-3 me-3">
                    <i class="fas fa-user-plus fa-2x"></i>
                </div>
                <div>
                    <h3 class="h6 fw-bold text-white mb-1">طلبات الانضمام</h3>
                    <p class="text-muted small mb-0">مراجعة واعتماد البائعين</p>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Recent Orders Table -->
<div class="card border-secondary shadow-sm">
    <div class="card-header bg-dark border-secondary py-3">
        <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-clock me-2"></i>آخر الطلبات</h2>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentOrders != null && Model.RecentOrders.Any())
        {
            <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-secondary text-white">
                    <tr>
                        <th>رقم الطلب</th>
                        <th>العميل</th>
                        <th>المبلغ</th>
                        <th>الحالة</th>
                        <th>التاريخ</th>
                        <th class="text-end">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.RecentOrders.Take(5))
                    {
                        <tr>
                            <td>
                                <span class="fw-bold text-dark">#@order.Id</span>
                            </td>
                            <td>
                                <span class="text-dark fw-semibold">@(string.IsNullOrWhiteSpace(order.CustomerName) ? "غير محدد" : order.CustomerName)</span>
                                <br />
                                <span class="text-muted small">@(order.CustomerEmail ?? "")</span>
                            </td>
                            <td>
                                <span class="fw-bold">$@((order.TotalAmount + order.StoreCreditUsed).ToString("F2"))</span>
                            </td>
                            <td>
                                @switch (order.Status)
                                {
                                    case TechXpress.Data.Entities.OrderStatus.Pending:
                                        <span class="badge bg-warning text-dark">قيد الانتظار</span>
                                        break;
                                    case TechXpress.Data.Entities.OrderStatus.Paid:
                                        <span class="badge bg-primary">تم الدفع</span>
                                        break;
                                    case TechXpress.Data.Entities.OrderStatus.Shipped:
                                        <span class="badge bg-info">تم الشحن</span>
                                        break;
                                    case TechXpress.Data.Entities.OrderStatus.Delivered:
                                        <span class="badge bg-success">تم التوصيل</span>
                                        break;
                                    case TechXpress.Data.Entities.OrderStatus.Cancelled:
                                        <span class="badge bg-danger">ملغي</span>
                                        break;
                                    case TechXpress.Data.Entities.OrderStatus.Returned:
                                        <span class="badge bg-secondary">مُرتجع</span>
                                        break;
                                }
                            </td>
                            <td>
                                <span class="text-muted small">@order.OrderDate.ToString("yyyy/MM/dd")</span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-warning" title="عرض تفاصيل الطلب" aria-label="عرض تفاصيل الطلب">
                                    <i class="fas fa-eye" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">لا توجد طلبات حديثة</p>
            </div>
        }
    </div>
</div>

