@model OrderDto
@using TechXpress.Services.Models
@using TechXpress.Data.Entities
@{
    ViewData["Title"] = "تفاصيل الطلب #" + Model.Id + " - TechXpress Admin";

    string StatusText(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "قيد الانتظار",
        OrderStatus.Paid => "تم الدفع",
        OrderStatus.Shipped => "تم الشحن",
        OrderStatus.Delivered => "تم التوصيل",
        OrderStatus.Cancelled => "ملغي",
        _ => s.ToString()
    };

    string StatusBadge(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "bg-warning text-dark",
        OrderStatus.Paid => "bg-primary",
        OrderStatus.Shipped => "bg-info text-dark",
        OrderStatus.Delivered => "bg-success",
        OrderStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };

    string ShipText(ShippingStatus s) => s switch
    {
        ShippingStatus.Pending => "بانتظار التجهيز",
        ShippingStatus.Preparing => "قيد التجهيز",
        ShippingStatus.Shipped => "تم الشحن",
        ShippingStatus.Delivered => "تم التوصيل",
        _ => s.ToString()
    };

    string ShipBadge(ShippingStatus s) => s switch
    {
        ShippingStatus.Pending => "bg-warning text-dark",
        ShippingStatus.Preparing => "bg-secondary",
        ShippingStatus.Shipped => "bg-info text-dark",
        ShippingStatus.Delivered => "bg-success",
        _ => "bg-secondary"
    };
}

<div class="page-head mb-4">
    <div class="page-head-icon"><i class="fas fa-receipt"></i></div>
    <div class="page-head-text">
        <h1>تفاصيل الطلب #@Model.Id</h1>
        <p>مراجعة بيانات الطلب وتحديث حالته</p>
    </div>
    <div class="page-head-actions">
        <span class="badge @StatusBadge(Model.Status) fs-6 px-3 py-2">@StatusText(Model.Status)</span>
        <a asp-action="Index" class="btn btn-outline-warning btn-sm fw-bold">
            <i class="fas fa-arrow-right me-1"></i>الرجوع للطلبات
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-secondary shadow-sm h-100">
            <div class="card-header bg-dark border-secondary py-3">
                <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-circle-info me-2 text-warning"></i>معلومات الطلب</h2>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted">رقم الطلب</dt>
                    <dd class="col-sm-7 fw-bold text-dark">#@Model.Id</dd>

                    <dt class="col-sm-5 text-muted">العميل</dt>
                    <dd class="col-sm-7 text-dark">
                        @(string.IsNullOrWhiteSpace(Model.CustomerName) ? "غير محدد" : Model.CustomerName)
                        @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                        {
                            <small class="text-muted d-block">@Model.CustomerEmail</small>
                        }
                    </dd>

                    <dt class="col-sm-5 text-muted">تاريخ الطلب</dt>
                    <dd class="col-sm-7 text-dark">@Model.OrderDate.ToString("yyyy/MM/dd HH:mm")</dd>

                    <dt class="col-sm-5 text-muted">الحالة الحالية</dt>
                    <dd class="col-sm-7"><span class="badge @StatusBadge(Model.Status)">@StatusText(Model.Status)</span></dd>

                    <dt class="col-sm-5 text-muted">عنوان الشحن</dt>
                    <dd class="col-sm-7 text-dark">@(string.IsNullOrWhiteSpace(Model.ShippingAddress) ? "غير متاح" : Model.ShippingAddress)</dd>

                    <dt class="col-sm-5 text-muted">كود الخصم</dt>
                    <dd class="col-sm-7 text-dark">@(string.IsNullOrEmpty(Model.PromoCode) ? "لا يوجد" : Model.PromoCode)</dd>

                    <dt class="col-sm-5 text-muted">معرّف الدفع</dt>
                    <dd class="col-sm-7 text-dark text-break">@(string.IsNullOrEmpty(Model.PaymentIntentId) ? "لم يتم الدفع" : Model.PaymentIntentId)</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-secondary shadow-sm h-100">
            <div class="card-header bg-dark border-secondary py-3">
                <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-calculator me-2 text-warning"></i>الإجماليات وتحديث الحالة</h2>
            </div>
            <div class="card-body p-4">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">المجموع الفرعي</span>
                    <span class="fw-bold text-dark">$@(Model.OrderDetails.Sum(d => d.UnitPrice * d.Quantity).ToString("F2"))</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">الخصم</span>
                    <span class="fw-bold text-success">- $@Model.DiscountAmount.ToString("F2")</span>
                </div>
                <div class="d-flex justify-content-between mb-4 pb-3 border-bottom fw-bold fs-5">
                    <span class="text-dark">المبلغ الإجمالي</span>
                    <span class="text-warning">$@Model.TotalAmount.ToString("F2")</span>
                </div>

                <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="mb-3">
                    @Html.AntiForgeryToken()
                    <label class="form-label" for="newStatus">تحديث حالة الطلب</label>
                    <div class="input-group">
                        <select name="newStatus" id="newStatus" class="form-select">
                            @foreach (var status in Enum.GetValues<OrderStatus>())
                            {
                                var isSelected = Model.Status == status;
                                <option value="@status" selected="@isSelected">@StatusText(status)</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-warning fw-bold">
                            <i class="fas fa-sync-alt me-1"></i>تحديث
                        </button>
                    </div>
                </form>

                @if (Model.Status != OrderStatus.Cancelled && Model.Status != OrderStatus.Delivered)
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('هل أنت متأكد من إلغاء هذا الطلب؟ سيتم استعادة المخزون.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger fw-bold">
                            <i class="fas fa-times me-1"></i>إلغاء الطلب
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="card border-secondary shadow-sm">
    <div class="card-header bg-dark border-secondary py-3 d-flex justify-content-between align-items-center">
        <h2 class="h5 fw-bold text-white mb-0"><i class="fas fa-box me-2 text-warning"></i>عناصر الطلب</h2>
        <span class="badge bg-secondary">@Model.OrderDetails.Count() عنصر</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-secondary text-white">
                    <tr>
                        <th>المنتج</th>
                        <th class="text-center">الكمية</th>
                        <th class="text-center">سعر الوحدة</th>
                        <th class="text-center">الإجمالي</th>
                        <th>البائع</th>
                        <th class="text-center">حالة الشحن</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.OrderDetails)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@d.ProductName</td>
                            <td class="text-center">@d.Quantity</td>
                            <td class="text-center">$@d.UnitPrice.ToString("F2")</td>
                            <td class="text-center fw-bold">$@((d.UnitPrice * d.Quantity).ToString("F2"))</td>
                            <td class="text-muted small">@(string.IsNullOrWhiteSpace(d.VendorStoreName) ? "-" : d.VendorStoreName)</td>
                            <td class="text-center">
                                <span class="badge @ShipBadge(d.ShippingStatus)">@ShipText(d.ShippingStatus)</span>
                                @if (!string.IsNullOrWhiteSpace(d.Carrier))
                                {
                                    <small class="d-block text-muted mt-1">@d.Carrier</small>
                                }
                                @if (!string.IsNullOrWhiteSpace(d.TrackingNumber))
                                {
                                    <small class="d-block text-muted" dir="ltr">@d.TrackingNumber</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
